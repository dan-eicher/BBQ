// =============================================================
// ddcgc — DDCG compiler-compiler — DSL grammar
//
// PEG grammar for parsing .ddcg files into a DdcgAst::File AST.
// Generated by pegc:
//   pegc ddcgc/grammar/ddcg.peg
//        -frames ddcgc/grammar/frames/
//        -o ddcgc/frontend/
//        -prefix ""
// CMake auto-regens; see ddcgc/CMakeLists.txt.
//
// DSL shape (full reference: ~/.claude/plans/maybe-update-the-plan
// -breezy-cascade.md §"ddcgc DSL grammar shape"):
//   COMPILER name
//   (. headers .)
//   IMPORTS / DESTINATIONS / AUXILIARIES / [PREDICATES] / RULES
// =============================================================

COMPILER Ddcg

(. #include <string>
   #include <vector>
   #include <optional>
   #include "PegRuntime.h"
   #include "ddcg_ast.h"
.)

CHARACTERS
  letter         = 'a'..'z' + 'A'..'Z' + '_' .
  digit          = '0'..'9' .
  ident_continue = letter + digit .

TOKENS
  ident      = letter { ident_continue } .
  integer    = digit { digit } .
  string_lit = '"' { '\\' ANY | !'"' ANY } '"' .

COMMENTS FROM "//" TO "\n"
COMMENTS FROM "/*" TO "*/"

IGNORE '\r' + '\n' + '\t' + ' '

PRODUCTIONS

// ═══════════════════════════════════════════════════════════════
// Top-level: a .ddcg file
// ═══════════════════════════════════════════════════════════════

Ddcg
    (. peg::Span name_span; std::string name;
       std::vector<DdcgAst::Header*> headers;
       std::vector<DdcgAst::Import*> imports;
       std::vector<DdcgAst::DestDecl*> destinations;
       DdcgAst::TypeRef* ir_root = nullptr;
       std::vector<DdcgAst::Aux*> auxiliaries;
       std::vector<DdcgAst::Pred*> predicates;
       std::vector<DdcgAst::Fun*> funs;
       std::vector<DdcgAst::LibraryImport*> libraries;
       std::string members;
       std::string priv;
       std::vector<std::string> desugared;
       std::vector<DdcgAst::Rule*> rules;
       bool internal_dispatchers = false; .)
    = "COMPILER"
      ident<name_span>            (. name = name_span.to_string(); .)
      [ "INTERNAL_DISPATCHERS"     (. internal_dispatchers = true; .) ]
      { HeaderBlock<headers> }
      "IMPORTS"
      { ImportDecl<imports> }
      "DESTINATIONS"
      { DestEntry<destinations, ir_root> }
      "AUXILIARIES"
      { AuxiliaryDecl<auxiliaries> }
      [ "PREDICATES"
        { PredicateDecl<predicates> }
      ]
      [ "MEMBERS"
        "(."                        (. if (!scan_to("." ")", members)) return false; .)
      ]
      [ "PRIVATE"
        "(."                        (. if (!scan_to("." ")", priv)) return false; .)
      ]
      [ "DESUGARED"
        ident<name_span>            (. desugared.push_back(name_span.to_string()); .)
        { "," ident<name_span>      (. desugared.push_back(name_span.to_string()); .) }
      ]
      { FunDecl<funs> | LibraryImport<libraries> }
      "RULES"
      { RuleDecl<rules> }
    (. ast = new DdcgAst::File(std::move(name),
           std::move(headers), std::move(imports),
           std::move(destinations), ir_root,
           std::move(auxiliaries), std::move(predicates),
           std::move(funs), std::move(libraries),
           std::move(members), std::move(priv),
           std::move(desugared), std::move(rules),
           internal_dispatchers);
       ast->loc = DdcgAst::SourceLoc{nullptr, 1, 1}; .)
.

// ═══════════════════════════════════════════════════════════════
// Headers — verbatim code blocks
// ═══════════════════════════════════════════════════════════════

HeaderBlock <. std::vector<DdcgAst::Header*> &headers .>
    (. std::string code; .)
    = "(."
      (. if (!scan_to("." ")", code)) return false; .)
      (. auto* h = new DdcgAst::Header(std::move(code));
         h->loc = Loc();
         headers.push_back(h); .)
.

// ═══════════════════════════════════════════════════════════════
// IMPORTS — name = "path"
// ═══════════════════════════════════════════════════════════════

ImportDecl <. std::vector<DdcgAst::Import*> &imports .>
    (. peg::Span name_span; peg::Span path_span;
       std::string name; std::string path; .)
    = ident<name_span>            (. name = name_span.to_string(); .)
      "="
      string_lit<path_span>       (. path = peg::unescape_string_lit(path_span); .)
      (. auto* i = new DdcgAst::Import(std::move(name), std::move(path));
         i->loc = Loc();
         imports.push_back(i); .)
.

// ═══════════════════════════════════════════════════════════════
// DESTINATIONS — data_dest, ctrl_dest, ir_root
// ═══════════════════════════════════════════════════════════════

DestEntry <. std::vector<DdcgAst::DestDecl*> &dests, DdcgAst::TypeRef* &ir_root .>
    (. peg::Span name_span; std::string name;
       std::vector<DdcgAst::DestVariant*> variants;
       std::vector<DdcgAst::DestField*> fields;
       DdcgAst::TypeRef* ty = nullptr; .)
    = "data_dest" !ident_continue
      ident<name_span>            (. name = name_span.to_string(); .)
      "{"
      VariantList<variants>
      "}"
      (. auto* d = new DdcgAst::DataDest(std::move(name), std::move(variants));
         d->loc = Loc();
         dests.push_back(d); .)
    | "ctrl_dest" !ident_continue
      ident<name_span>            (. name = name_span.to_string(); .)
      "{"
      VariantList<variants>
      "}"
      (. auto* d = new DdcgAst::CtrlDest(std::move(name), std::move(variants));
         d->loc = Loc();
         dests.push_back(d); .)
    | "env_dest" !ident_continue
      ident<name_span>            (. name = name_span.to_string(); .)
      "{"
      VariantList<variants>
      "}"
      (. auto* d = new DdcgAst::EnvDest(std::move(name), std::move(variants));
         d->loc = Loc();
         dests.push_back(d); .)
    | "sum" !ident_continue
      ident<name_span>            (. name = name_span.to_string(); .)
      "{"
      VariantList<variants>
      "}"
      (. auto* d = new DdcgAst::Sum(std::move(name), std::move(variants));
         d->loc = Loc();
         dests.push_back(d); .)
    | "ir_root" !ident_continue
      TypeRef_<&ty>
      (. ir_root = ty; .)
.

VariantList <. std::vector<DdcgAst::DestVariant*> &variants .>
    (. DdcgAst::DestVariant* v; .)
    = DestVariant_<&v>            (. variants.push_back(v); .)
      { "|" DestVariant_<&v>      (. variants.push_back(v); .) }
.

DestVariant_ <. DdcgAst::DestVariant* *result .>
    (. peg::Span name_span; std::string name;
       std::vector<DdcgAst::DestField*> fields; .)
    = ident<name_span>            (. name = name_span.to_string(); .)
      [ "("
        DestFieldDecl<fields>
        { "," DestFieldDecl<fields> }
        ")"
      ]
      (. auto* v = new DdcgAst::DestVariant(std::move(name), std::move(fields));
         v->loc = Loc();
         *result = v; .)
.

DestFieldDecl <. std::vector<DdcgAst::DestField*> &fields .>
    (. peg::Span name_span; std::string name;
       DdcgAst::TypeRef* ty = nullptr; .)
    = ident<name_span>            (. name = name_span.to_string(); .)
      ":"
      TypeRef_<&ty>
      (. auto* f = new DdcgAst::DestField(std::move(name), ty);
         f->loc = Loc();
         fields.push_back(f); .)
.

// ═══════════════════════════════════════════════════════════════
// AUXILIARIES / PREDICATES — typed function signatures
// ═══════════════════════════════════════════════════════════════

AuxiliaryDecl <. std::vector<DdcgAst::Aux*> &auxiliaries .>
    (. peg::Span name_span; std::string name;
       std::vector<DdcgAst::TypeRef*> params;
       DdcgAst::TypeRef* ret = nullptr; .)
    = ident<name_span>            (. name = name_span.to_string(); .)
      ":"
      "("
      [ TypeRefList<params> ]
      ")"
      "->"
      TypeRef_<&ret>
      (. auto* a = new DdcgAst::Aux(std::move(name), std::move(params), ret);
         a->loc = Loc();
         auxiliaries.push_back(a); .)
.

PredicateDecl <. std::vector<DdcgAst::Pred*> &predicates .>
    (. peg::Span name_span; std::string name;
       std::vector<DdcgAst::TypeRef*> params; .)
    = ident<name_span>            (. name = name_span.to_string(); .)
      ":"
      "("
      [ TypeRefList<params> ]
      ")"
      "->"
      "bool" !ident_continue
      (. auto* p = new DdcgAst::Pred(std::move(name), std::move(params));
         p->loc = Loc();
         predicates.push_back(p); .)
.

// ═══════════════════════════════════════════════════════════════
// fun declarations — action-language function definitions
// ═══════════════════════════════════════════════════════════════
//
// Phase A milestone A.1. Unlike Aux (signature-only, body in MEMBERS),
// a Fun's body is an action-language stmt block, type-checked and
// compiled to target code. The trailing ExprStmt produces the return
// value (same convention as rule bodies).
//
//   fun name(arg : Type, …) -> RetType { stmts… ; tail-expr; }

FunDecl <. std::vector<DdcgAst::Fun*> &funs .>
    (. peg::Span name_span; std::string name;
       std::vector<DdcgAst::FunParam*> params;
       DdcgAst::TypeRef* ret = nullptr;
       std::vector<DdcgAst::Stmt*> body; .)
    = "fun" !ident_continue
      ident<name_span>            (. name = name_span.to_string(); .)
      "("
      [ FunParamDecl<params>
        { "," FunParamDecl<params> }
      ]
      ")"
      "->"
      TypeRef_<&ret>
      Block_<body>
      (. auto* f = new DdcgAst::Fun(std::move(name), std::move(params), ret, std::move(body));
         f->loc = Loc();
         funs.push_back(f); .)
.

FunParamDecl <. std::vector<DdcgAst::FunParam*> &params .>
    (. peg::Span name_span; std::string name;
       DdcgAst::TypeRef* ty = nullptr; .)
    = ident<name_span>            (. name = name_span.to_string(); .)
      ":"
      TypeRef_<&ty>
      (. auto* p = new DdcgAst::FunParam(std::move(name), ty);
         p->loc = Loc();
         params.push_back(p); .)
.

// `import "path.ddcg"` — pulls another .ddcg file's fun declarations
// into this one. Resolution + load happens in the CLI driver after
// parse; the AST just records the path as written.
LibraryImport <. std::vector<DdcgAst::LibraryImport*> &libraries .>
    (. peg::Span path_span; std::string path; .)
    = "import" !ident_continue
      string_lit<path_span>       (. path = peg::unescape_string_lit(path_span); .)
      (. auto* l = new DdcgAst::LibraryImport(std::move(path));
         l->loc = Loc();
         libraries.push_back(l); .)
.

TypeRefList <. std::vector<DdcgAst::TypeRef*> &refs .>
    (. DdcgAst::TypeRef* t = nullptr; .)
    = TypeRef_<&t>                (. refs.push_back(t); .)
      { "," TypeRef_<&t>          (. refs.push_back(t); .) }
.

// ═══════════════════════════════════════════════════════════════
// Type references — ident, ident*, list<T>, tuple<T1,T2,...>
// ═══════════════════════════════════════════════════════════════

TypeRef_ <. DdcgAst::TypeRef* *result .>
    (. peg::Span name_span; peg::Span sub_span;
       std::string mod; std::string name;
       std::vector<DdcgAst::TypeRef*> elems;
       DdcgAst::TypeRef* inner = nullptr;
       bool is_ptr = false; .)
    = "list" !ident_continue
      "<"
      TypeRef_<&inner>
      ">"
      (. auto* t = new DdcgAst::TypeList(inner);
         t->loc = Loc();
         *result = t; .)
    | "tuple" !ident_continue
      "<"
      TypeRef_<&inner>            (. elems.push_back(inner); .)
      { "," TypeRef_<&inner>      (. elems.push_back(inner); .) }
      ">"
      (. auto* t = new DdcgAst::TypeTuple(std::move(elems));
         t->loc = Loc();
         *result = t; .)
    | ident<name_span>            (. name = name_span.to_string(); .)
      [ "."                       // module.Constructor — schema ref
        ident<sub_span>           (. mod = std::move(name);
                                     name = sub_span.to_string(); .)
      ]
      [ "*"                       (. is_ptr = true; .) ]
      (. auto* t = new DdcgAst::TypeName(std::move(mod), std::move(name), is_ptr);
         t->loc = Loc();
         *result = t; .)
.

// ═══════════════════════════════════════════════════════════════
// RULES — pattern + optional guard + body
// ═══════════════════════════════════════════════════════════════

RuleDecl <. std::vector<DdcgAst::Rule*> &rules .>
    (. peg::Span name_span; std::string name;
       std::vector<DdcgAst::Pattern*> heads;
       DdcgAst::Pattern* p = nullptr;
       DdcgAst::Expr* guard = nullptr;
       std::vector<DdcgAst::Stmt*> body; .)
    = "rule" !ident_continue
      ident<name_span>            (. name = name_span.to_string(); .)
      ":"
      Pattern_<&p>                (. heads.push_back(p); .)
      { "," Pattern_<&p>          (. heads.push_back(p); .) }
      [ "where" !ident_continue Expr_<&guard> ]
      Block_<body>
      (. auto* r = new DdcgAst::Rule(std::move(heads),
             guard ? std::optional<DdcgAst::Expr*>(guard) : std::nullopt,
             std::move(body));
         r->loc = Loc();
         rules.push_back(r); .)
.

// Statement block: braces around zero-or-more statements. Used both
// as a rule body and as a `for`-loop body.
Block_ <. std::vector<DdcgAst::Stmt*> &body .>
    = "{"
      { Stmt_<body> }
      "}"
.

// ═══════════════════════════════════════════════════════════════
// Patterns
// ═══════════════════════════════════════════════════════════════

// Like Bind_, parse `ident` first and dispatch on name to disambiguate
// `_` (wildcard) from `_foo` (an ident with a leading underscore). The
// keyword-shaped patterns `nil`/`true`/`false`-style are also handled
// via name dispatch (only `nil` here).
Pattern_ <. DdcgAst::Pattern* *result .>
    (. peg::Span first_span; peg::Span ctor_span; peg::Span lit_span;
       std::string first; std::string ctor;
       std::vector<DdcgAst::FieldPat*> fields; .)
    = integer<lit_span>
      (. int64_t n = std::stoll(lit_span.to_string());
         auto* p = new DdcgAst::IntPat(static_cast<int>(n));
         p->loc = Loc();
         *result = p; .)
    | string_lit<lit_span>
      (. std::string s = peg::unescape_string_lit(lit_span);
         auto* p = new DdcgAst::StringPat(std::move(s));
         p->loc = Loc();
         *result = p; .)
    | ident<first_span>           (. first = first_span.to_string(); .)
      ( "."                                       // module.Constructor(...)
        ident<ctor_span>          (. ctor = ctor_span.to_string(); .)
        "("
        [ FieldPat_<fields>
          { "," FieldPat_<fields> }
        ]
        ")"
        (. auto* p = new DdcgAst::ConstructorPat(std::move(first),
               std::move(ctor), std::move(fields));
           p->loc = Loc();
           *result = p; .)
      | "("                                       // bare-name constructor: dest variant
        [ FieldPat_<fields>
          { "," FieldPat_<fields> }
        ]
        ")"
        (. auto* p = new DdcgAst::ConstructorPat(std::string(),
               std::move(first), std::move(fields));
           p->loc = Loc();
           *result = p; .)
      |                                           // bare ident; dispatch by name
        (. DdcgAst::Pattern* p;
           if (first == "_")        p = new DdcgAst::WildcardPat();
           else if (first == "nil") p = new DdcgAst::NilPat();
           else                     p = new DdcgAst::BindPat(std::move(first));
           p->loc = Loc();
           *result = p; .)
      )
.

// One arm of a `match`: pattern + body block.
// `pat => { stmts… }` for multi-stmt arms; `pat => expr;` for the
// common single-tail-expression arm (parser inserts the implicit
// block). The body is a stmt list either way.
MatchArm_ <. std::vector<DdcgAst::MatchArm*> &arms .>
    (. DdcgAst::Pattern* p = nullptr;
       std::vector<DdcgAst::Stmt*> body;
       DdcgAst::Expr* tail = nullptr; .)
    = Pattern_<&p>
      "=>"
      ( Block_<body>
      | Expr_<&tail>
        (. auto* es = new DdcgAst::ExprStmt(tail);
           es->loc = tail->loc;
           body.push_back(es); .)
      )
      (. auto* a = new DdcgAst::MatchArm(p, std::move(body));
         a->loc = p->loc;
         arms.push_back(a); .)
.

FieldPat_ <. std::vector<DdcgAst::FieldPat*> &fields .>
    (. peg::Span name_span; std::string name;
       DdcgAst::Pattern* p = nullptr; .)
    = "..."
      ident<name_span>            (. name = name_span.to_string(); .)
      (. auto* f = new DdcgAst::RestFieldPat(std::move(name));
         f->loc = Loc();
         fields.push_back(f); .)
    | ident<name_span>            (. name = name_span.to_string(); .)
      ( ":"
        Pattern_<&p>
        (. auto* f = new DdcgAst::NamedFieldPat(std::move(name), p);
           f->loc = Loc();
           fields.push_back(f); .)
      |                            // shorthand: `slot` ≡ `slot: slot`
        (. auto* bind = new DdcgAst::BindPat(name);
           bind->loc = Loc();
           auto* f = new DdcgAst::NamedFieldPat(std::move(name), bind);
           f->loc = Loc();
           fields.push_back(f); .)
      )
.

// ═══════════════════════════════════════════════════════════════
// Statements
// ═══════════════════════════════════════════════════════════════

// Each statement ends in `;` except the for-loop, where the closing
// brace of its body block is the terminator (C-style).
Stmt_ <. std::vector<DdcgAst::Stmt*> &stmts .>
    (. peg::Span name_span; std::string name;
       std::vector<DdcgAst::Bind*> binds;
       DdcgAst::Bind* b = nullptr;
       DdcgAst::Bind* idx_bind = nullptr;
       DdcgAst::Expr* e = nullptr;
       std::vector<DdcgAst::Stmt*> body;
       std::vector<DdcgAst::Stmt*> else_body; .)
    = "let" !ident_continue
      ( "("
        Bind_<&b>                 (. binds.push_back(b); .)
        { "," Bind_<&b>           (. binds.push_back(b); .) }
        ")"
      | Bind_<&b>                 (. binds.push_back(b); .)
      )
      "="
      Expr_<&e>
      ";"
      (. auto* s = new DdcgAst::LetStmt(std::move(binds), e);
         s->loc = Loc();
         stmts.push_back(s); .)
    | "for" !ident_continue
      ( "("                                       // for (i, x) in xs — indexed
        Bind_<&idx_bind>
        ","
        Bind_<&b>
        ")"
      | Bind_<&b>                                 // for x in xs — element only
      )
      "in" !ident_continue
      Expr_<&e>
      Block_<body>
      (. auto* s = new DdcgAst::ForStmt(b,
             idx_bind ? std::optional<DdcgAst::Bind*>(idx_bind) : std::nullopt,
             e, std::move(body));
         s->loc = Loc();
         stmts.push_back(s); .)
    | "if" !ident_continue
      Expr_<&e>
      Block_<body>
      [ "else" !ident_continue
        Block_<else_body>
      ]
      (. auto* s = new DdcgAst::IfStmt(e, std::move(body), std::move(else_body));
         s->loc = Loc();
         stmts.push_back(s); .)
    | "label" !ident_continue
      ident<name_span>            (. name = name_span.to_string(); .)
      ";"
      (. auto* s = new DdcgAst::LabelStmt(std::move(name));
         s->loc = Loc();
         stmts.push_back(s); .)
    | ident<name_span>            (. name = name_span.to_string(); .)
      ":="
      Expr_<&e>
      ";"
      (. auto* s = new DdcgAst::MutAssign(std::move(name), e);
         s->loc = Loc();
         stmts.push_back(s); .)
    | Expr_<&e>                                   // tail or call expression
      ";"
      (. auto* s = new DdcgAst::ExprStmt(e);
         s->loc = Loc();
         stmts.push_back(s); .)
.

// Note: parse `ident` first and dispatch on the resulting name, so that
// `_foo` is correctly an ident (with a leading underscore) and only a
// bare `_` becomes WildcardBind. A leading `"_"` alternative would
// match `_foo` as wildcard then leave `foo` dangling.
Bind_ <. DdcgAst::Bind* *result .>
    (. peg::Span name_span; std::string name;
       DdcgAst::TypeRef* ty = nullptr; .)
    = ident<name_span>            (. name = name_span.to_string(); .)
      [ ":" TypeRef_<&ty> ]
      (. DdcgAst::Bind* b;
         if (name == "_") {
             b = new DdcgAst::WildcardBind();
         } else {
             b = new DdcgAst::SimpleBind(std::move(name),
                 ty ? std::optional<DdcgAst::TypeRef*>(ty) : std::nullopt);
         }
         b->loc = Loc();
         *result = b; .)
.

// ═══════════════════════════════════════════════════════════════
// Expressions — full BBQ-tier cascade
// ═══════════════════════════════════════════════════════════════

Expr_ <. DdcgAst::Expr* *result .>
    = TernaryExpr<result>
.

TernaryExpr <. DdcgAst::Expr* *result .>
    (. DdcgAst::Expr* then_ = nullptr;
       DdcgAst::Expr* else_ = nullptr; .)
    = LogicalOr<result>
      [ "?"
        Expr_<&then_>
        ":"
        TernaryExpr<&else_>
        (. auto* t = new DdcgAst::TernaryExpr(*result, then_, else_);
           t->loc = (*result)->loc;
           *result = t; .)
      ]
.

LogicalOr <. DdcgAst::Expr* *result .>
    (. DdcgAst::Expr* rhs = nullptr; .)
    = LogicalAnd<result>
      { "or" !ident_continue
        LogicalAnd<&rhs>
        (. auto* b = new DdcgAst::BinOp("or", *result, rhs);
           b->loc = rhs->loc;
           *result = b; .)
      }
.

LogicalAnd <. DdcgAst::Expr* *result .>
    (. DdcgAst::Expr* rhs = nullptr; .)
    = Equality<result>
      { "and" !ident_continue
        Equality<&rhs>
        (. auto* b = new DdcgAst::BinOp("and", *result, rhs);
           b->loc = rhs->loc;
           *result = b; .)
      }
.

Equality <. DdcgAst::Expr* *result .>
    (. DdcgAst::Expr* rhs = nullptr; .)
    = Relational<result>
      { "=="
        Relational<&rhs>
        (. auto* b = new DdcgAst::BinOp("==", *result, rhs);
           b->loc = rhs->loc;
           *result = b; .)
      | "!="
        Relational<&rhs>
        (. auto* b = new DdcgAst::BinOp("!=", *result, rhs);
           b->loc = rhs->loc;
           *result = b; .)
      }
.

Relational <. DdcgAst::Expr* *result .>
    (. DdcgAst::Expr* rhs = nullptr; .)
    = Additive<result>
      { "<="
        Additive<&rhs>
        (. auto* b = new DdcgAst::BinOp("<=", *result, rhs);
           b->loc = rhs->loc;
           *result = b; .)
      | ">="
        Additive<&rhs>
        (. auto* b = new DdcgAst::BinOp(">=", *result, rhs);
           b->loc = rhs->loc;
           *result = b; .)
      | "<"
        Additive<&rhs>
        (. auto* b = new DdcgAst::BinOp("<", *result, rhs);
           b->loc = rhs->loc;
           *result = b; .)
      | ">"
        Additive<&rhs>
        (. auto* b = new DdcgAst::BinOp(">", *result, rhs);
           b->loc = rhs->loc;
           *result = b; .)
      }
.

Additive <. DdcgAst::Expr* *result .>
    (. DdcgAst::Expr* rhs = nullptr; .)
    = Multiplicative<result>
      { "+"
        Multiplicative<&rhs>
        (. auto* b = new DdcgAst::BinOp("+", *result, rhs);
           b->loc = rhs->loc;
           *result = b; .)
      | "-"
        Multiplicative<&rhs>
        (. auto* b = new DdcgAst::BinOp("-", *result, rhs);
           b->loc = rhs->loc;
           *result = b; .)
      }
.

Multiplicative <. DdcgAst::Expr* *result .>
    (. DdcgAst::Expr* rhs = nullptr; .)
    = Unary<result>
      { "*"
        Unary<&rhs>
        (. auto* b = new DdcgAst::BinOp("*", *result, rhs);
           b->loc = rhs->loc;
           *result = b; .)
      | "/"
        Unary<&rhs>
        (. auto* b = new DdcgAst::BinOp("/", *result, rhs);
           b->loc = rhs->loc;
           *result = b; .)
      | "%"
        Unary<&rhs>
        (. auto* b = new DdcgAst::BinOp("%", *result, rhs);
           b->loc = rhs->loc;
           *result = b; .)
      }
.

Unary <. DdcgAst::Expr* *result .>
    (. DdcgAst::Expr* operand = nullptr; .)
    = "not" !ident_continue
      Unary<&operand>
      (. auto* u = new DdcgAst::UnaryOp("not", operand);
         u->loc = operand->loc;
         *result = u; .)
    | "-"
      Unary<&operand>
      (. auto* u = new DdcgAst::UnaryOp("-", operand);
         u->loc = operand->loc;
         *result = u; .)
    | Postfix<result>
.

Postfix <. DdcgAst::Expr* *result .>
    (. DdcgAst::Expr* idx = nullptr;
       std::vector<DdcgAst::Expr*> args;
       DdcgAst::Expr* arg = nullptr;
       DdcgAst::Expr* with_val = nullptr;
       peg::Span field_span; std::string field; .)
    = Primary<result>
      { "("
        [ Expr_<&arg>             (. args.push_back(arg); .)
          { "," Expr_<&arg>       (. args.push_back(arg); .) }
        ]
        ")"
        (. auto* c = new DdcgAst::CallExpr(*result, std::move(args));
           c->loc = (*result)->loc;
           *result = c;
           args.clear(); .)
      | "."
        ident<field_span>         (. field = field_span.to_string(); .)
        (. auto* f = new DdcgAst::FieldAccExpr(*result, std::move(field));
           f->loc = (*result)->loc;
           *result = f; .)
      | "["
        Expr_<&idx>
        "]"
        (. auto* x = new DdcgAst::IndexAccExpr(*result, idx);
           x->loc = (*result)->loc;
           *result = x; .)
      | "with" !ident_continue
        ident<field_span>         (. field = field_span.to_string(); .)
        ":="
        Expr_<&with_val>
        (. auto* w = new DdcgAst::WithExpr(*result, std::move(field), with_val);
           w->loc = (*result)->loc;
           *result = w; .)
      }
.

Primary <. DdcgAst::Expr* *result .>
    (. peg::Span name_span; peg::Span lit_span;
       std::string name;
       DdcgAst::Expr* inner = nullptr;
       std::vector<DdcgAst::Expr*> elems;
       DdcgAst::Expr* elem = nullptr;
       DdcgAst::Expr* subj = nullptr;
       DdcgAst::Expr* arg = nullptr;
       std::vector<DdcgAst::Expr*> gen_args;
       std::vector<DdcgAst::Stmt*> block_body;
       std::vector<DdcgAst::MatchArm*> arms;
       peg::Span schema_span; peg::Span ctor_span;
       std::string schema_name; std::string ctor_name; .)
    = "true" !ident_continue
      (. auto* b = new DdcgAst::BoolLit(true);
         b->loc = Loc();
         *result = b; .)
    | "false" !ident_continue
      (. auto* b = new DdcgAst::BoolLit(false);
         b->loc = Loc();
         *result = b; .)
    | "nil" !ident_continue
      (. auto* n = new DdcgAst::NilLit();
         n->loc = Loc();
         *result = n; .)
    // gen(subject, δ, γ, [lnext]) — recursive code generation per
    // Dybvig et al. 1990 §3.2: CG : E → ρ → δ → γ → Code. ρ is the
    // implicit ctx; δ and γ are explicit. Both must be provided so
    // recursive calls can vary δ (e.g. paper's binop spilling sub-
    // expressions into the accumulator with δ = ac while γ inherits).
    | "gen" !ident_continue
      "("
      Expr_<&subj>
      { "," Expr_<&arg>            (. gen_args.push_back(arg); .) }
      ")"
      (. auto* g = new DdcgAst::GenCall(subj, std::move(gen_args));
         g->loc = subj->loc;
         *result = g; .)
    // match (subject) { pat => body | pat => body | ... }
    // Body is a stmt block (same shape as fun/rule bodies); the
    // trailing ExprStmt produces the arm's value.
    | "match" !ident_continue
      "("
      Expr_<&subj>
      ")"
      "{"
      MatchArm_<arms>
      { "|" MatchArm_<arms> }
      "}"
      (. auto* m = new DdcgAst::MatchExpr(subj, std::move(arms));
         m->loc = subj->loc;
         *result = m; .)
    // build Schema.Constructor(args) — construct a schema value.
    // Lowers to `new Namespace::Ctor(args)` in the C++ backend.
    | "build" !ident_continue
      ident<schema_span>          (. schema_name = schema_span.to_string(); .)
      "."
      ident<ctor_span>            (. ctor_name = ctor_span.to_string(); .)
      "("
      [ Expr_<&elem>              (. elems.push_back(elem); .)
        { "," Expr_<&elem>        (. elems.push_back(elem); .) }
      ]
      ")"
      (. auto* b = new DdcgAst::BuildExpr(std::move(schema_name),
             std::move(ctor_name), std::move(elems));
         b->loc = Loc();
         *result = b; .)
    | integer<lit_span>
      (. int64_t n = std::stoll(lit_span.to_string());
         auto* i = new DdcgAst::IntLit(static_cast<int>(n));
         i->loc = Loc();
         *result = i; .)
    | string_lit<lit_span>
      (. std::string s = peg::unescape_string_lit(lit_span);
         auto* sl = new DdcgAst::StringLit(std::move(s));
         sl->loc = Loc();
         *result = sl; .)
    | "["
      [ Expr_<&elem>              (. elems.push_back(elem); .)
        { "," Expr_<&elem>        (. elems.push_back(elem); .) }
      ]
      "]"
      (. auto* l = new DdcgAst::ListLit(std::move(elems));
         l->loc = Loc();
         *result = l; .)
    | Block_<block_body>
      (. auto* be = new DdcgAst::BlockExpr(std::move(block_body));
         be->loc = Loc();
         *result = be; .)
    | "("
      Expr_<&inner>
      ( ")"
        (. *result = inner; .)
      | "," Expr_<&elem>          (. elems.push_back(inner); elems.push_back(elem); .)
        { "," Expr_<&elem>        (. elems.push_back(elem); .) }
        ")"
        (. auto* t = new DdcgAst::TupleLit(std::move(elems));
           t->loc = inner->loc;
           *result = t; .)
      )
    | ident<name_span>            (. name = name_span.to_string(); .)
      (. auto* id = new DdcgAst::IdentExpr(std::move(name));
         id->loc = Loc();
         *result = id; .)
.

END Ddcg.
