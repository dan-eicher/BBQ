// calc.burg — lower the calc CEK-tree IR to opgen stack-machine
// bytecode, the cg_jump way (Dybvig DDCG p.13). This is the same role
// yoctojc's patterns/codegen.burg plays for the JCVM: burg tiles the
// value sub-trees (BURG_NODE_CHILD) and walks the spine
// (BURG_NODE_SUCC); each consumer rule emits its opcode then calls
// cg_jump to thread its continuation.
//
// Producers emit postorder (the matcher reduces children before the
// parent's action), so `reg: Add(reg, reg)` lands its two operands on
// the eval stack first, then OP_ADD — a plain stack machine. No
// register/F8 cases: the opgen VM is a stack VM, so the lowering is
// the simple postorder, not the copy-and-patch register selection the
// old stencil burg did.
//
// The emit backend is calc_emit.h's Emit (held in MEMBERS): absolute
// byte-PC branch targets + a single backpatch pass, so the bytecode is
// correct regardless of the order the matcher tiles a branch's arms.

TERM LoadConst  = calc_ir::LoadConst::kind_value
TERM LoadLocal  = calc_ir::LoadLocal::kind_value
TERM Add        = calc_ir::Add::kind_value
TERM Sub        = calc_ir::Sub::kind_value
TERM Mul        = calc_ir::Mul::kind_value
TERM Div        = calc_ir::Div::kind_value
TERM Neg        = calc_ir::Neg::kind_value
TERM CmpEq      = calc_ir::CmpEq::kind_value
TERM CmpNeq     = calc_ir::CmpNeq::kind_value
TERM CmpLt      = calc_ir::CmpLt::kind_value
TERM CmpLe      = calc_ir::CmpLe::kind_value
TERM CmpGt      = calc_ir::CmpGt::kind_value
TERM CmpGe      = calc_ir::CmpGe::kind_value
TERM StoreLocal = calc_ir::StoreLocal::kind_value
TERM ExprEffect = calc_ir::ExprEffect::kind_value
TERM Branch     = calc_ir::Branch::kind_value
TERM Goto       = calc_ir::Goto::kind_value
TERM Nop        = calc_ir::Nop::kind_value
TERM Halt       = calc_ir::Halt::kind_value
TERM Leave      = calc_ir::Leave::kind_value
TERM Call       = calc_ir::Call::kind_value

// Auxiliaries the rewrite rules call. Each takes the class its binder
// matched and returns the class of its result — that is the only currency
// the rewriter has. The VALUE behind a class arrives on the class payload,
// recorded by the stage that built the e-graph from the IR and had the
// LoadConst in hand; nothing here reconstructs it.
AUXILIARIES
  calc_fold_add : (class, class) -> class
  calc_fold_mul : (class, class) -> class

// Directed equality axioms. `=>` only; nothing here reads memory or has an
// effect, so every rule is a pure expression identity that holds in both
// directions of the compiler's reasoning.
//
// calc has no shift node (CalcIR.h: LoadConst/LoadLocal/Add/Sub/Mul/Div/
// Neg/Cmp*/Call and the control nodes), so the strength reduction is
// `x*2 => x+x`, which uses only nodes that exist here.
REWRITE {
  // The domain this rule set reasons in besides equalities. "This class
  // is the constant k" is a fact about a VALUE, not an equality between
  // two terms, so it is declared rather than written as a rule — and
  // because it is a fact it flows along equalities, which a rule that
  // scans a class for a LoadConst cannot do.
  ANALYSIS calc_fact {
    make:   calc_an_make
    join:   calc_an_join
    modify: calc_an_modify
  }

  // Constant folding: both operands are known, so the sum/product is too.
  fold_add: Add($a, $b) => calc_fold_add($a, $b)
      where (. calc_both_const(g, $a, $b) .);
  fold_mul: Mul($a, $b) => calc_fold_mul($a, $b)
      where (. calc_both_const(g, $a, $b) .);

  // Identities.
  add_zero: Add($x, $z) => $x where (. calc_is_const(g, $z, 0) .);
  mul_one:  Mul($x, $o) => $x where (. calc_is_const(g, $o, 1) .);

  // Strength reduction, guard-bearing: only when the multiplier is 2.
  mul_two:  Mul($x, $t) => Add($x, $x) where (. calc_is_const(g, $t, 2) .);

  // Nested pattern: the match descends into the second operand's class and
  // binds inside it. `x + (-y)` is `x - y` — an identity that needs the
  // shape, not a guard, which is what makes it the case that holds
  // multi-level matching down.
  add_neg:  Add($x, Neg($y)) => Sub($x, $y);
  sub_neg:  Sub($x, Neg($y)) => Add($x, $y);

  // Reassociation, and the case where an auxiliary is a CHILD of the node
  // being built rather than the whole template: (x*a)*b is x*(a*b), and the
  // a*b is folded on the spot. Holds down aux-nested-in-template, which no
  // other rule here reaches.
  mul_assoc: Mul(Mul($x, $a), $b) => Mul($x, calc_fold_mul($a, $b))
      where (. calc_both_const(g, $a, $b) .);
}

MEMBERS (. bbq::Emit emit; .)

(. #include "calc_codegen.h"
   using namespace calc;
   #define E emit

   #define BURG_NODE_TYPE          calc_ir::Node*
   #define BURG_NODE_OP(n)         (ir_tag(n))
   #define BURG_NODE_ARITY(n)      (operand_count(n))
   #define BURG_NODE_CHILD(n,i)    (operand_producer(n, i))
   #define BURG_NODE_ID(n)         ((void*)(n))
   #define BURG_NODE_SUCC_COUNT(n) (successor_count(n))
   #define BURG_NODE_SUCC(n,i)     (successor(n, i))
.)

START stmt

RULES

// ── Value producers (postorder → eval stack) ────────────────
reg: LoadConst = 1 (. E.op(OP_CONST); E.sleb(static_cast<calc_ir::LoadConst*>(node)->value); .);
reg: LoadLocal = 1 (. E.op(OP_LOAD);  E.u8((uint8_t)static_cast<calc_ir::LoadLocal*>(node)->src); .);

reg: Add(reg, reg) = 1 (. E.op(OP_ADD); .);
reg: Sub(reg, reg) = 1 (. E.op(OP_SUB); .);
reg: Mul(reg, reg) = 1 (. E.op(OP_MUL); .);
reg: Div(reg, reg) = 1 (. E.op(OP_DIV); .);
reg: Neg(reg)      = 1 (. E.op(OP_NEG); .);

reg: CmpEq(reg, reg)  = 1 (. E.op(OP_EQ); .);
reg: CmpNeq(reg, reg) = 1 (. E.op(OP_NE); .);
reg: CmpLt(reg, reg)  = 1 (. E.op(OP_LT); .);
reg: CmpLe(reg, reg)  = 1 (. E.op(OP_LE); .);
reg: CmpGt(reg, reg)  = 1 (. E.op(OP_GT); .);
reg: CmpGe(reg, reg)  = 1 (. E.op(OP_GE); .);

// Call (value producer): args reduced postorder → eval stack, then
// OP_CALL to the callee entry. Per-arity rules (the where-clause pins
// each to its child count, else burgc's labeler lets arity-0 win on
// cost for any Call). The result lands on the stack after calc_ret.
reg: Call where (. operand_count(node) == 0 .)                                = 1 (. emit_call(E, node); .);
reg: Call(reg) where (. operand_count(node) == 1 .)                           = 1 (. emit_call(E, node); .);
reg: Call(reg, reg) where (. operand_count(node) == 2 .)                      = 1 (. emit_call(E, node); .);
reg: Call(reg, reg, reg) where (. operand_count(node) == 3 .)                 = 1 (. emit_call(E, node); .);
reg: Call(reg, reg, reg, reg) where (. operand_count(node) == 4 .)            = 1 (. emit_call(E, node); .);

// ── Spine consumers (emit op, then cg_jump to continuation) ──
// Branch targets are Nop landing pads (ddcg_label wraps them), so only
// the Nop rule records a PC; the value-bearing consumers are never
// branch targets and need no label. cg_jump emits a goto only when the
// continuation is a Nop.
stmt: StoreLocal(reg) = 1 (. E.op(OP_STORE);
        E.u8((uint8_t)static_cast<calc_ir::StoreLocal*>(node)->dest); cg_jump(E, node); .);
stmt: ExprEffect(reg) = 1 (. E.op(OP_POP); cg_jump(E, node); .);

// Branch: test value is the reg child (already on the stack). BR_IF
// jumps to the then_ landing pad when true; a goto threads the else_
// (false) landing pad. Both are Nops, labeled at their entry.
stmt: Branch(reg) = 1 (. { auto* b = static_cast<calc_ir::Branch*>(node);
          E.branch(OP_BR_IF, b->then_); E.branch(OP_GOTO, b->else_); } .);

stmt: Goto = 1 (. E.branch(OP_GOTO, static_cast<calc_ir::Goto*>(node)->target); .);

// Halt / Leave deliver the value (on the stack) and return.
stmt: Halt(reg)  = 1 (. E.op(OP_RET); .);
stmt: Leave(reg) = 1 (. E.op(OP_RET); .);

// Nop is the label anchor (a kont landing pad) — records its PC at the
// arm's entry, emits no opcode, threads its continuation.
stmt: Nop = 0 (. E.label(node); cg_jump(E, node); .);
