# Seeded liars for the VC gate: rows that CONTRADICT their bodies. The
# pipeline must come back REFUTED on both — a verify gate that cannot go red
# proves nothing. Kept as a permanent fixture, not a scratch probe.

type i32 s4 u4 1 i

# The edge claims 1+1 == 3; the solver must hand back a model.
liar_add 0x01 (i32 a, i32 b -- i32 r)
    edge: "a == 1 && b == 1" -> "r == 3"
    (. r = a + b; .)

# The guard can never fire: dead spec text, refuted on guard-sat.
dead_guard 0x02 (i32 a -- i32 r)
    error: (. a != a .) -> Never
    (. r = a; .)
