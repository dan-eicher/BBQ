COMPILER Burg

(. #include <string>
   #include <vector>
   #include <cstdint>
   #include "PegRuntime.h"
.)

CHARACTERS
  letter         = 'a'..'z' + 'A'..'Z' + '_' .
  digit          = '0'..'9' .
  ident_continue = letter + digit .

TOKENS
  ident           = letter { ident_continue } .
  integer         = digit { digit } .
  qualified_ident = letter { ident_continue } { ':' ':' letter { ident_continue } } .

COMMENTS FROM "//" TO "\n"
COMMENTS FROM "/*" TO "*/"

IGNORE '\r' + '\n' + '\t' + ' '

PRODUCTIONS

Burg
    (. std::vector<burg_ast::TermDecl*> terms;
       std::string start_sym;
       std::vector<std::string> entry_syms;
       std::string ns;
       std::string members_block;
       std::string private_block;
       std::vector<std::string> headers;
       std::vector<burg_ast::Rule*> rules;
       std::vector<burg_ast::RewriteRule*> rewrites;
       std::vector<burg_ast::AnalysisDecl*> analyses;
       std::vector<burg_ast::AuxDecl*> auxes;
       burg_ast::Rule* r; .)
    = { Decl<terms, start_sym, entry_syms, ns, members_block, private_block, headers, auxes, rewrites, analyses> }
      "RULES"
      { RuleDecl<&r>  (. rules.push_back(r); .) }
      (. skip(); if (!at_end()) return false; .)
    (. ast = new burg_ast::Spec();
       ast->terminals = std::move(terms);
       ast->start = std::move(start_sym);
       ast->entries = std::move(entry_syms);
       ast->ns = std::move(ns);
       ast->members = std::move(members_block);
       ast->private_helpers = std::move(private_block);
       ast->headers = std::move(headers);
       ast->rules = std::move(rules);
       ast->auxiliaries = std::move(auxes);
       ast->rewrites = std::move(rewrites);
       ast->analyses = std::move(analyses);
       ast->loc = {1, 1}; .)
.

Decl <. std::vector<burg_ast::TermDecl*> &terms, std::string &start, std::vector<std::string> &entries, std::string &ns, std::string &members, std::string &priv, std::vector<std::string> &headers, std::vector<burg_ast::AuxDecl*> &auxes, std::vector<burg_ast::RewriteRule*> &rewrites, std::vector<burg_ast::AnalysisDecl*> &analyses .>
    = TermDecl_<terms>
    | AuxSection<auxes>
    | RewriteSection<rewrites, analyses>
    | StartDecl<start>
    | EntryDecl<entries>
    | NamespaceDecl<ns>
    | MembersDecl<members>
    | PrivateDecl<priv>
    | HeaderAction_<headers>
.

NamespaceDecl <. std::string &ns .>
    (. peg::Span ns_span; .)
    = "COMPILER"
      ident<ns_span>  (. ns = ns_span.to_string(); .)
.

MembersDecl <. std::string &members .>
    (. std::string code; .)
    = "MEMBERS"
      "(." (. if (!scan_to("." ")", code)) return false; .)
    (. members = code; .)
.

PrivateDecl <. std::string &priv .>
    (. std::string code; .)
    = "PRIVATE"
      "(." (. if (!scan_to("." ")", code)) return false; .)
    (. priv = code; .)
.

HeaderAction_ <. std::vector<std::string> &headers .>
    (. std::string code; .)
    = "(." (. if (!scan_to("." ")", code)) return false; .)
    (. headers.push_back(code); .)
.

TermDecl_ <. std::vector<burg_ast::TermDecl*> &terms .>
    (. peg::Span name_span; peg::Span num_span; peg::Span sym_span;
       std::string name; int64_t num = 0;
       std::string sym; bool is_sym = false; .)
    = "TERM"
      { ident<name_span>  (. name = name_span.to_string(); .)
        "="
        ( integer<num_span>          (. num = std::stoll(num_span.to_string());
                                       is_sym = false; .)
        | qualified_ident<sym_span>  (. sym = sym_span.to_string();
                                       is_sym = true;  .)
        )
        (. auto* t = new burg_ast::TermDecl();
           t->name = std::move(name);
           if (is_sym) t->symbol = std::move(sym);
           else        t->number = num;
           t->loc = {line(), col()};
           terms.push_back(t);
           name.clear(); sym.clear(); num = 0; is_sym = false; .)
      }
.

StartDecl <. std::string &start .>
    (. peg::Span start_span; .)
    = "START"
      ident<start_span>  (. start = start_span.to_string(); .)
.

// ENTRY nonterm — a goal a consumer reduces to by NAME, besides the root's
// START goal. Repeatable; order is preserved for diagnostics only.
EntryDecl <. std::vector<std::string> &entries .>
    (. peg::Span entry_span; .)
    = "ENTRY"
      ident<entry_span>  (. entries.push_back(entry_span.to_string()); .)
.

RuleDecl <. burg_ast::Rule* *result .>
    (. peg::Span nt_span; peg::Span cost_span;
       std::string nt;
       burg_ast::TreePattern* pat;
       int64_t cost = 0;
       std::string guard;
       std::string action; .)
    = ident<nt_span>  (. nt = nt_span.to_string();
                        burg_ast::SourceLoc loc = {line(), col()}; .)
      ":"
      TreePat<&pat>
      [ "where"
        "(." (. if (!scan_to("." ")", guard)) return false; .) ]
      "=" integer<cost_span>  (. cost = std::stoll(cost_span.to_string()); .)
      [ "(." (. if (!scan_to("." ")", action)) return false; .) ]
      ";"
    (. *result = new burg_ast::Rule();
       (*result)->nonterm = std::move(nt);
       (*result)->pattern = pat;
       (*result)->cost = cost;
       (*result)->guard = std::move(guard);
       (*result)->action = std::move(action);
       (*result)->loc = loc; .)
.

TreePat <. burg_ast::TreePattern* *result .>
    (. peg::Span name_span;
       std::string name;
       std::vector<burg_ast::TreePattern*> children;
       burg_ast::TreePattern* child; .)
    = ident<name_span>  (. name = name_span.to_string();
                          burg_ast::SourceLoc loc = {line(), col()}; .)
      [ "("
        TreePat<&child>     (. children.push_back(child); .)
        { ","
          TreePat<&child>   (. children.push_back(child); .)
        }
        ")"
      ]
    (. *result = new burg_ast::TreePattern();
       (*result)->name = std::move(name);
       (*result)->children = std::move(children);
       (*result)->loc = loc; .)
.

// ── AUXILIARIES ────────────────────────────────────────────────────
// Foreign helpers a rewrite template may call, declared with signatures
// exactly as ddcgc's AUXILIARIES and opgen's `native` declare theirs:
//
//   AUXILIARIES
//     ctz : (int) -> int
//
// One declaration form across the toolchain's DSLs, and a name a template
// uses without declaring stays an error instead of silently becoming a call.

AuxSection <. std::vector<burg_ast::AuxDecl*> &out .>
    (. burg_ast::AuxDecl* ad; .)
    = "AUXILIARIES"
      { AuxDecl_<&ad>  (. out.push_back(ad); .) }
.

AuxDecl_ <. burg_ast::AuxDecl* *result .>
    (. peg::Span name_span; peg::Span ty_span;
       std::string name; std::string ret;
       std::vector<std::string> params; .)
    = ident<name_span>  (. name = name_span.to_string();
                          burg_ast::SourceLoc loc = {line(), col()}; .)
      ":" "("
      [ ident<ty_span>       (. params.push_back(ty_span.to_string()); .)
        { "," ident<ty_span> (. params.push_back(ty_span.to_string()); .) }
      ]
      ")" "->" ident<ty_span>  (. ret = ty_span.to_string(); .)
    (. *result = new burg_ast::AuxDecl();
       (*result)->name = std::move(name);
       (*result)->params = std::move(params);
       (*result)->ret = std::move(ret);
       (*result)->loc = loc; .)
.

// ── REWRITE section ────────────────────────────────────────────────
//
//   REWRITE {
//     name: Pattern => Template [where (. guard .)] ;
//   }
//
// Patterns are the tiling grammar's tree patterns with `$name` binders at
// leaves. Templates build a tree from terminals, those binders, and
// `@helper(...)` escapes for computed immediates. `=>` only: a
// bidirectional axiom is two rules.

RewriteSection <. std::vector<burg_ast::RewriteRule*> &out, std::vector<burg_ast::AnalysisDecl*> &analyses .>
    (. burg_ast::RewriteRule* rr; burg_ast::AnalysisDecl* ad; .)
    = "REWRITE" "{"
      { ( AnalysisDecl_<&ad>  (. analyses.push_back(ad); .)
        | RewriteRule_<&rr>   (. out.push_back(rr); .)
        )
      }
      "}"
.

// ── The e-class analysis (egg §4.1) ────────────────────────────────
//
//   ANALYSIS interval_t {
//     make:   iv_make
//     join:   iv_join
//     modify: iv_modify
//   }
//
// A rule states that two terms are EQUAL. That a value lies in a range
// is not an equality but abstract interpretation, so the domain and its
// hooks are DECLARED here rather than written as rules — which is what
// puts the choice beside the rule set instead of in whichever consumer
// remembers to assemble an eg_analysis by hand.
//
// The name after ANALYSIS is the C type of the per-class fact, emitted
// verbatim into a `sizeof`, the same way TERM's symbolic form lets the
// consumer's own header supply a value the DSL never restates.
//
// An unrecognised key is COLLECTED, not rejected here: what a hook name
// means is settled against egraph.h during analysis, the same division
// the template's terminal-vs-binder-vs-helper resolution already makes.
AnalysisDecl_ <. burg_ast::AnalysisDecl* *result .>
    (. peg::Span ty_span; peg::Span key_span; peg::Span fn_span;
       std::string fact; std::string key;
       std::string make_fn; std::string join_fn; std::string modify_fn;
       std::vector<std::string> unknown; .)
    = "ANALYSIS"
      ident<ty_span>  (. fact = ty_span.to_string();
                        burg_ast::SourceLoc loc = {line(), col()}; .)
      "{"
      { ident<key_span>  (. key = key_span.to_string(); .)
        ":"
        ident<fn_span>   (. if      (key == "make")   make_fn   = fn_span.to_string();
                            else if (key == "join")   join_fn   = fn_span.to_string();
                            else if (key == "modify") modify_fn = fn_span.to_string();
                            else                      unknown.push_back(key); .)
      }
      "}"
    (. *result = new burg_ast::AnalysisDecl();
       (*result)->fact = std::move(fact);
       (*result)->make = std::move(make_fn);
       (*result)->join = std::move(join_fn);
       (*result)->modify = std::move(modify_fn);
       (*result)->unknown_hooks = std::move(unknown);
       (*result)->loc = loc; .)
.

RewriteRule_ <. burg_ast::RewriteRule* *result .>
    (. peg::Span name_span;
       std::string name;
       burg_ast::RewritePat* pat;
       burg_ast::RewriteTmpl* tmpl;
       std::string guard; .)
    = ident<name_span>  (. name = name_span.to_string();
                          burg_ast::SourceLoc loc = {line(), col()}; .)
      ":"
      RewritePat_<&pat>
      "=>"
      RewriteTmpl_<&tmpl>
      [ "where"
        "(." (. if (!scan_to("." ")", guard)) return false; .) ]
      ";"
    (. *result = new burg_ast::RewriteRule();
       (*result)->name = std::move(name);
       (*result)->pattern = pat;
       (*result)->tmpl = tmpl;
       (*result)->guard = std::move(guard);
       (*result)->loc = loc; .)
.

RewritePat_ <. burg_ast::RewritePat* *result .>
    (. peg::Span name_span;
       std::string name;
       bool is_binder = false;
       std::vector<burg_ast::RewritePat*> children;
       burg_ast::RewritePat* child; .)
    = ( "$" ident<name_span>  (. name = name_span.to_string(); is_binder = true; .)
      | ident<name_span>      (. name = name_span.to_string(); .)
        [ "("
          RewritePat_<&child>     (. children.push_back(child); .)
          { "," RewritePat_<&child> (. children.push_back(child); .) }
          ")"
        ]
      )
    (. burg_ast::SourceLoc loc = {line(), col()};
       *result = new burg_ast::RewritePat();
       (*result)->name = std::move(name);
       (*result)->is_binder = is_binder;
       (*result)->children = std::move(children);
       (*result)->loc = loc; .)
.

RewriteTmpl_ <. burg_ast::RewriteTmpl* *result .>
    (. peg::Span name_span;
       std::string name;
       burg_ast::RewriteTmpl::Kind kind = burg_ast::RewriteTmpl::Term;
       std::vector<burg_ast::RewriteTmpl*> children;
       burg_ast::RewriteTmpl* child; .)
    // `$$` is the class the rule MATCHED. Ordered before `$ident` so the
    // second sigil is not read as the start of a name. An auxiliary is
    // how a rule produces a discriminant other than the one it matched;
    // this is how it produces one AT the matched discriminant, which a
    // structural template cannot express when the node carries a value.
    = ( "$" "$"
          (. name = "$"; kind = burg_ast::RewriteTmpl::Binder; .)
      | "$" ident<name_span>
          (. name = name_span.to_string(); kind = burg_ast::RewriteTmpl::Binder; .)
      | ident<name_span>  (. name = name_span.to_string(); .)
        [ "("
          RewriteTmpl_<&child>     (. children.push_back(child); .)
          { "," RewriteTmpl_<&child> (. children.push_back(child); .) }
          ")"
        ]
      )
    (. burg_ast::SourceLoc loc = {line(), col()};
       *result = new burg_ast::RewriteTmpl();
       (*result)->kind = kind;
       (*result)->name = std::move(name);
       (*result)->children = std::move(children);
       (*result)->loc = loc; .)
.

END Burg.
