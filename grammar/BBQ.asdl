// =============================================================
// BBQ (Binary Block Query) — Abstract Syntax Definition
//
// Defines the AST produced by parsing .bbq format specs.
// Used by the static C++ code generator.
//
// Compatible with the ASDL generator at ../../asdl
// Run: ../../asdl/build/asdl -i BBQ.asdl -t templates/bbq_ast.inja -o ../frontend/BBQ_AST.h
// =============================================================

module BBQ {

    // Top level
    grammar       = Grammar(directive* directives, rule* rules,
                            code_block* codes)

    directive     = EndianDirective(endianness endian)

    // Verbatim user code, emitted into the generated output. HeaderBlock
    // lands in the types header (after the generated type definitions, so
    // it can reference them); SourceBlock lands in the reader implementation
    // file (so it can call the generated readers — e.g. an extern body).
    code_block    = CodeBlock(code_section section, string code)

    code_section  = HeaderBlock | SourceBlock | WriterBlock

    rule          = Rule(identifier name, type_expr body)

    // Type expressions
    //
    // Alternatives: rule-level | (unnamed biased choice)
    //Struct:       sequential named fields
    //Union:        named alternatives (PEG biased choice)
    //Array:        repeated elements (fixed count or sep/term)
    //Optional:     conditional presence (try parse / succeed empty)
    // Switch:       discriminated dispatch on expression value
    //Compute:      derived value, no input consumed
    //Primitive:    binary read (uint8, uint32be, float64, bytes, etc.)
    //RuleRef:      reference to another rule

    type_expr     = Alternatives(type_expr* alts)
                  | Struct(field* fields, expr? constraint)
                  | Union(variant* variants)
                  | Array(type_expr element, array_spec spec,
                          expr? constraint, interval? interval,
                          interval? element_interval,
                          bool resync)
                  | Optional(type_expr element,
                             expr? constraint, interval? interval)
                  | Switch(expr discriminator, switch_case* cases,
                           switch_default? default)
                  | Compute(expr expression, primitive_kind result_type)
                  | Primitive(primitive_kind kind,
                              expr? constraint, interval? interval)
                  | RuleRef(identifier name,
                            expr? constraint, interval? interval)
                  | Extern(string func_name, string write_func, string cpp_type,
                           expr? constraint, interval? interval)
                  | Bitfield(primitive_kind container, bitfield_entry* entries)
                  | EndianSwitch(expr endian_expr)

    bitfield_entry = BitfieldEntry(identifier name, int64 width,
                                   expr? constraint)

    field         = Field(identifier name, type_expr body,
                          expr? constraint, interval? interval,
                          bool scopes_rest)

    variant       = Variant(identifier name, type_expr body,
                            expr? constraint, interval? interval)

    // Array specifications
    array_spec    = FixedCount(expr count)
                  | SepTerm(separator sep, terminator term)

    separator     = TypeSep(type_expr sep_type)
                  | NoneSep

    terminator    = EofTerm
                  | CountTerm(expr count)
                  | UntilTerm(expr condition)
                  | TypeTerm(type_expr term_type)

    // Switch
    switch_case    = SwitchCase(case_value value, type_expr target,
                                interval? interval)
    // SwitchDefault: target is the type to parse on default. Setting
    // is_reject = true makes the default an explicit unreachable-fail
    // marker — emits `bbq_fail` in the reader (and a write-side fail).
    // When is_reject is true, target is unused (None).
    switch_default = SwitchDefault(type_expr? target, interval? interval,
                                   bool is_reject)

    case_value    = IntValue(int64 value)
                  | RangeValue(int64 lo, int64 hi)
                  | StrValue(string value)
                  | IdentValue(identifier name)
                  | RefValue(identifier* path)

    // Interval
    //
    // StartEnd: explicit byte range [start, end]
    //Length:   relative to current position [length]
    interval      = StartEnd(expr start, expr end)
                  | Length(expr length)

    // Primitive kinds
    //
    // Covers all binary read types: integers (signed/unsigned, 8-64 bit),
    //floats (32/64 bit), raw bytes, strings, booleans.
    //Endianness is per-field: Little, Big, or Default (resolved by @endian).
    primitive_kind = IntegerKind(width width, signedness sign, endianness endian, encoding encoding)
                   | FloatKind(width width, endianness endian)
                   | BytesKind
                   | StringKind
                   | BoolKind

    width         = W8 | W16 | W32 | W64

    signedness    = Unsigned | Signed

    endianness    = Little | Big | Default

    // Integer byte encoding: a plain fixed-width little/big-endian field, or a
    // variable-length LEB128 varint (unsigned ULEB / signed SLEB). LEB128 is
    // inherently LSB-first, so it ignores endianness. `width` is the carrier
    // (decoded) width — W32 or W64.
    encoding      = Fixed | Uleb | Sleb

    // Expression language (unified arithmetic + boolean + bitwise)
    expr          = BinOp(expr left, binop op, expr right)
                  | UnaryOp(unaryop op, expr operand)
                  | Ternary(expr cond, expr then_branch, expr else_branch)
                  | IntLit(int64 value)
                  | FloatLit(float value)
                  | StrLit(string value)
                  | BoolLit(bool value)
                  | Ref(ref_path path)
                  | Call(identifier func, expr* args)
                  | EndianLit(endianness value)
                  | EOI
                  // Context builtin, written `@name` (e.g. @pos, @start, @end,
                  // @index, @buffer, @remaining). A reserved namespace distinct
                  // from format fields — the parser provides these, the format
                  // does not. See the "interval environment" model in the README.
                  | Builtin(identifier name)

    // Reference paths (field access chains)
    ref_path      = Simple(identifier name, identifier? resolved_path, identifier? resolved_parent, int64 resolved_depth)
                  | FieldAcc(ref_path base, identifier field)
                  | IndexAcc(ref_path base, expr index)

    // Binary operators
    binop         = Add | Sub | Mul | Div | Mod
                  | BitAnd | BitOr | BitXor | Shl | Shr
                  | And | Or
                  | Eq | Ne | Lt | Le | Gt | Ge

    // Unary operators
    unaryop       = Neg | BitNot | Not | Abs
}
