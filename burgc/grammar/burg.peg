COMPILER Burg

(. #include <string>
   #include <vector>
   #include <cstdint>
   #include "PegRuntime.h"
.)

CHARACTERS
  letter         = 'a'..'z' + 'A'..'Z' + '_' .
  digit          = '0'..'9' .
  ident_continue = letter + digit .

TOKENS
  ident           = letter { ident_continue } .
  integer         = digit { digit } .
  qualified_ident = letter { ident_continue } { ':' ':' letter { ident_continue } } .

COMMENTS FROM "//" TO "\n"
COMMENTS FROM "/*" TO "*/"

IGNORE '\r' + '\n' + '\t' + ' '

PRODUCTIONS

Burg
    (. std::vector<burg_ast::TermDecl*> terms;
       std::string start_sym;
       std::string ns;
       std::string members_block;
       std::string private_block;
       std::vector<std::string> headers;
       std::vector<burg_ast::Rule*> rules;
       burg_ast::Rule* r; .)
    = { Decl<terms, start_sym, ns, members_block, private_block, headers> }
      "RULES"
      { RuleDecl<&r>  (. rules.push_back(r); .) }
      (. skip(); if (!at_end()) return false; .)
    (. ast = new burg_ast::Spec();
       ast->terminals = std::move(terms);
       ast->start = std::move(start_sym);
       ast->ns = std::move(ns);
       ast->members = std::move(members_block);
       ast->private_helpers = std::move(private_block);
       ast->headers = std::move(headers);
       ast->rules = std::move(rules);
       ast->loc = {1, 1}; .)
.

Decl <. std::vector<burg_ast::TermDecl*> &terms, std::string &start, std::string &ns, std::string &members, std::string &priv, std::vector<std::string> &headers .>
    = TermDecl_<terms>
    | StartDecl<start>
    | NamespaceDecl<ns>
    | MembersDecl<members>
    | PrivateDecl<priv>
    | HeaderAction_<headers>
.

NamespaceDecl <. std::string &ns .>
    (. peg::Span ns_span; .)
    = "NAMESPACE"
      ident<ns_span>  (. ns = ns_span.to_string(); .)
.

MembersDecl <. std::string &members .>
    (. std::string code; .)
    = "MEMBERS"
      "(." (. if (!scan_to("." ")", code)) return false; .)
    (. members = code; .)
.

PrivateDecl <. std::string &priv .>
    (. std::string code; .)
    = "PRIVATE"
      "(." (. if (!scan_to("." ")", code)) return false; .)
    (. priv = code; .)
.

HeaderAction_ <. std::vector<std::string> &headers .>
    (. std::string code; .)
    = "(." (. if (!scan_to("." ")", code)) return false; .)
    (. headers.push_back(code); .)
.

TermDecl_ <. std::vector<burg_ast::TermDecl*> &terms .>
    (. peg::Span name_span; peg::Span num_span; peg::Span sym_span;
       std::string name; int64_t num = 0;
       std::string sym; bool is_sym = false; .)
    = "TERM"
      { ident<name_span>  (. name = name_span.to_string(); .)
        "="
        ( integer<num_span>          (. num = std::stoll(num_span.to_string());
                                       is_sym = false; .)
        | qualified_ident<sym_span>  (. sym = sym_span.to_string();
                                       is_sym = true;  .)
        )
        (. auto* t = new burg_ast::TermDecl();
           t->name = std::move(name);
           if (is_sym) t->symbol = std::move(sym);
           else        t->number = num;
           t->loc = {line(), col()};
           terms.push_back(t);
           name.clear(); sym.clear(); num = 0; is_sym = false; .)
      }
.

StartDecl <. std::string &start .>
    (. peg::Span start_span; .)
    = "START"
      ident<start_span>  (. start = start_span.to_string(); .)
.

RuleDecl <. burg_ast::Rule* *result .>
    (. peg::Span nt_span; peg::Span cost_span;
       std::string nt;
       burg_ast::TreePattern* pat;
       int64_t cost = 0;
       std::string guard;
       std::string action; .)
    = ident<nt_span>  (. nt = nt_span.to_string();
                        burg_ast::SourceLoc loc = {line(), col()}; .)
      ":"
      TreePat<&pat>
      [ "where"
        "(." (. if (!scan_to("." ")", guard)) return false; .) ]
      "=" integer<cost_span>  (. cost = std::stoll(cost_span.to_string()); .)
      [ "(." (. if (!scan_to("." ")", action)) return false; .) ]
      ";"
    (. *result = new burg_ast::Rule();
       (*result)->nonterm = std::move(nt);
       (*result)->pattern = pat;
       (*result)->cost = cost;
       (*result)->guard = std::move(guard);
       (*result)->action = std::move(action);
       (*result)->loc = loc; .)
.

TreePat <. burg_ast::TreePattern* *result .>
    (. peg::Span name_span;
       std::string name;
       std::vector<burg_ast::TreePattern*> children;
       burg_ast::TreePattern* child; .)
    = ident<name_span>  (. name = name_span.to_string();
                          burg_ast::SourceLoc loc = {line(), col()}; .)
      [ "("
        TreePat<&child>     (. children.push_back(child); .)
        { ","
          TreePat<&child>   (. children.push_back(child); .)
        }
        ")"
      ]
    (. *result = new burg_ast::TreePattern();
       (*result)->name = std::move(name);
       (*result)->children = std::move(children);
       (*result)->loc = loc; .)
.

END Burg.
