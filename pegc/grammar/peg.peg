// =============================================================
// PEG Parser Generator — Grammar-of-Grammars (Self-Hosted)
//
// Parses .peg files and builds a Grammar AST.
// This is the self-hosted version — compiled by pegc itself.
//
// Generate with:
//   ./build/pegc pegc/grammar/peg.peg -frames pegc/grammar/frames/ -o pegc/frontend/ -prefix ""
// =============================================================

COMPILER Peg

(. #include <string>
#include <vector>
#include <optional>
#include <cstdlib>
#include "PegRuntime.h"
.)

CHARACTERS
  letter         = 'a'..'z' + 'A'..'Z' + '_' .
  digit          = '0'..'9' .
  hex_digit      = digit + 'a'..'f' + 'A'..'F' .
  ident_continue = letter + digit .

TOKENS
  ident      = letter { ident_continue } .
  // \xNN is a hex byte escape — needed for charset ranges that
  // can't be expressed via printable ASCII (e.g. C0 control chars
  // in TOML's basic-string body restriction).
  char_lit   = '\''
               ( '\\' 'x' hex_digit hex_digit
               | '\\' ANY
               | !'\'' ANY )
               '\'' .
  string_lit = '"' { '\\' ANY | !'"' ANY } '"' .

COMMENTS FROM "//" TO "\n"
COMMENTS FROM "/*" TO "*/"

IGNORE '\r' + '\n' + '\t' + ' '

PRODUCTIONS

// ═══════════════════════════════════════════════════════════════
// Top-Level Grammar Structure
// ═══════════════════════════════════════════════════════════════

Peg
    (. peg::Span name_span;
       peg::Span endname_span;
       std::string name;
       std::string endname;
       std::vector<Header*> headers;
       std::vector<CharsetDef*> charsets;
       std::vector<TokenDef*> tokens;
       std::vector<CommentDef*> comments;
       std::string members;
       std::string priv;
       bool has_ignore = false;
       CharsetExpr* ignore_expr = nullptr;
       std::vector<Production*> productions; .)
    = "COMPILER"
      ident<name_span>      (. name = name_span.to_string(); .)
      { SemAction_<headers> }
      [ "MEMBERS"
        "(."                (. if (!scan_to("." ")", members)) return false; .)
      ]
      [ "PRIVATE"
        "(."                (. if (!scan_to("." ")", priv)) return false; .)
      ]
      [ "CHARACTERS"
        { CharsetDecl<charsets> }
      ]
      [ "TOKENS"
        { TokenDecl<tokens> }
      ]
      { CommentDecl<comments> }
      [ "IGNORE"
        CharsetExpr_<ignore_expr>
        (. has_ignore = true; .)
      ]
      "PRODUCTIONS"
      { ProductionDecl<productions> }
      "END"
      ident<endname_span>   (. endname = endname_span.to_string(); .)
      "."
    (. ast = new Grammar(std::move(name), std::move(headers),
           std::move(charsets), std::move(tokens), std::move(comments),
           std::move(members), std::move(priv),
           has_ignore,
           ignore_expr ? std::optional<CharsetExpr*>(ignore_expr) : std::nullopt,
           std::move(productions));
       ast->loc = SourceLoc{nullptr, 1, 1}; .)
.

// ── Semantic action as header code ──────────────────────────

SemAction_ <. std::vector<Header*> &headers .>
    (. std::string code; .)
    = "(." (. if (!scan_to("." ")", code)) return false; .)
    (. auto* h = new Header(TrimSemAction(code));
       h->loc = Loc();
       headers.push_back(h); .)
.

// ═══════════════════════════════════════════════════════════════
// CHARACTERS Section
// ═══════════════════════════════════════════════════════════════

CharsetDecl <. std::vector<CharsetDef*> &defs .>
    (. peg::Span csname_span; std::string csname; CharsetExpr* body; .)
    = ident<csname_span>  (. csname = csname_span.to_string(); SourceLoc loc = Loc(); .)
      "="
      CharsetExpr_<body>
      "."
    (. auto* d = new CharsetDef(std::move(csname), body);
       d->loc = loc;
       defs.push_back(d); .)
.

CharsetExpr_ <. CharsetExpr* &result .>
    (. CharsetExpr* rhs; .)
    = CharsetDiff<result>
      { "+"
        CharsetDiff<rhs>
        (. auto* u = new Union(result, rhs); u->loc = result->loc; result = u; .)
      }
.

CharsetDiff <. CharsetExpr* &result .>
    (. CharsetExpr* rhs; .)
    = CharsetPrimary<result>
      { "-"
        CharsetPrimary<rhs>
        (. auto* d = new Diff(result, rhs); d->loc = result->loc; result = d; .)
      }
.

CharsetPrimary <. CharsetExpr* &result .>
    (. peg::Span ch_span; peg::Span csname_span;
       char ch1 = 0, ch2 = 0; std::string csname; .)
    = char_lit<ch_span>  (. ch1 = peg::unescape_char_lit(ch_span);
                           result = new Single(static_cast<int>(ch1));
                           result->loc = Loc(); .)
      [ ".."
        char_lit<ch_span>  (. ch2 = peg::unescape_char_lit(ch_span);
                             result = new Range(static_cast<int>(ch1), static_cast<int>(ch2));
                             result->loc = Loc(); .)
      ]
    | "ANY"   (. result = new Any(); result->loc = Loc(); .)
    | ident<csname_span>  (. csname = csname_span.to_string();
                            result = new NameRef(std::move(csname));
                            result->loc = Loc(); .)
.

// ═══════════════════════════════════════════════════════════════
// TOKENS Section
// ═══════════════════════════════════════════════════════════════

// Token bodies use the same PegExpr AST as productions; tokens differ
// only in emission mode (no auto-skip between atoms).
TokenDecl <. std::vector<TokenDef*> &defs .>
    (. peg::Span tname_span; std::string tname; PegExpr* body; .)
    = ident<tname_span>   (. tname = tname_span.to_string(); SourceLoc loc = Loc(); .)
      "="
      PegBody<body>
      "."
    (. auto* d = new TokenDef(std::move(tname), body);
       d->loc = loc;
       defs.push_back(d); .)
.

// ═══════════════════════════════════════════════════════════════
// COMMENTS Section
// ═══════════════════════════════════════════════════════════════

CommentDecl <. std::vector<CommentDef*> &defs .>
    (. peg::Span open_span; peg::Span close_span; peg::Span tname_span;
       bool nested = false; bool structured = false; std::string open; std::string close_str; std::string tname; .)
    = "COMMENTS"
      "FROM"
      string_lit<open_span> (. open = peg::unescape_string_lit(open_span);
                              SourceLoc loc = Loc(); .)
      "TO"
      ( string_lit<close_span> (. close_str = peg::unescape_string_lit(close_span); .)
      | ident<tname_span>      (. close_str = tname_span.to_string(); .)
      )
      [ "NESTED"          (. nested = true; .) ]
      [ "STRUCTURED"      (. structured = true; .) ]   /* skip a balanced ()-nested, string-aware token group (e.g. (@…) annotations); the language-specific inner-comment awareness is a frame override */
    (. auto* c = new CommentDef(std::move(open), std::move(close_str), nested, structured);
       c->loc = loc;
       defs.push_back(c); .)
.

// ═══════════════════════════════════════════════════════════════
// PRODUCTIONS Section
// ═══════════════════════════════════════════════════════════════

ProductionDecl <. std::vector<Production*> &prods .>
    (. peg::Span pname_span;
       std::string pname;
       std::vector<Param*> params;
       std::string locals;
       std::string raw;
       bool has_locals = false;
       PegExpr* body; .)
    = ident<pname_span>   (. pname = pname_span.to_string(); SourceLoc loc = Loc(); .)
      [ "<." (. if (!scan_to("." ">", raw)) return false; .)
             (. ParseParams(raw, params); .)
      ]
      [ "(." (. if (!scan_to("." ")", locals)) return false; .)
             (. locals = TrimSemAction(locals); has_locals = true; .)
      ]
      "="
      PegBody<body>
      "."
    (. auto* p = new Production(std::move(pname), std::move(params),
           has_locals ? std::optional<std::string>(std::move(locals)) : std::nullopt,
           body);
       p->loc = loc;
       prods.push_back(p); .)
.

// ═══════════════════════════════════════════════════════════════
// PEG Expression Grammar
// ═══════════════════════════════════════════════════════════════

PegBody <. PegExpr* &result .>
    (. PegExpr* alt;
       std::vector<PegExpr*> alts; .)
    = PegSeq<result>      (. alts.push_back(result); .)
      { "|"
        PegSeq<alt>       (. alts.push_back(alt); .)
      }
    (. if (alts.size() > 1) {
           auto loc = result->loc;
           result = new Choice(std::move(alts));
           result->loc = loc;
       } .)
.

PegSeq <. PegExpr* &result .>
    (. PegExpr* elem;
       std::vector<PegExpr*> elems; .)
    = PegFactor<elem>     (. elems.push_back(elem); .)
      { PegFactor<elem>   (. elems.push_back(elem); .)
      }
    (. if (elems.size() == 1)
           result = elems[0];
       else {
           auto loc = elems[0]->loc;
           result = new Sequence(std::move(elems));
           result->loc = loc;
       } .)
.

PegFactor <. PegExpr* &result .>
    (. std::string code; PegExpr* inner; .)
    = "&"
      PegAtom<inner>
      (. result = new And(inner);
         result->loc = inner->loc; .)
    | "!"
      PegAtom<inner>
      (. result = new Not(inner);
         result->loc = inner->loc; .)
    | PegAtom<result>
    | "(." (. if (!scan_to("." ")", code)) return false; .)
      (. result = new Action(TrimSemAction(code));
         result->loc = Loc(); .)
    | "IF" "(" "(." (. if (!scan_to("." ")", code)) return false; .)
      ")"
      PegAtom<inner>
      (. result = new Resolver(TrimSemAction(code), inner);
         result->loc = inner->loc; .)
.

PegAtom <. PegExpr* &result .>
    (. peg::Span s_span; peg::Span ch_span; peg::Span name_span;
       PegExpr* inner; std::string s; char ch1 = 0, ch2 = 0; .)
    = string_lit<s_span>
      (. s = peg::unescape_string_lit(s_span);
         result = new Literal(std::move(s));
         result->loc = Loc(); .)
    | char_lit<ch_span>
      (. ch1 = peg::unescape_char_lit(ch_span);
         result = new Literal(std::string(1, ch1));
         result->loc = Loc(); .)
      [ ".."
        char_lit<ch_span>
        (. ch2 = peg::unescape_char_lit(ch_span);
           result = new CharRange(static_cast<int>(ch1), static_cast<int>(ch2));
           result->loc = Loc(); .)
      ]
    | "ANY"
      (. result = new AnyExpr();
         result->loc = Loc(); .)
    | ident<name_span>
      (. std::string rname = name_span.to_string(); SourceLoc loc = Loc();
         std::string args; .)
      [ "<."
        (. if (!scan_to("." ">", args)) return false;
           size_t b = args.find_first_not_of(" \t\r\n");
           size_t e = args.find_last_not_of(" \t\r\n");
           args = (b == std::string::npos) ? "" : args.substr(b, e - b + 1); .)
      | "<"
        (. if (!scan_to(">", args)) return false;
           size_t b = args.find_first_not_of(" \t\r\n");
           size_t e = args.find_last_not_of(" \t\r\n");
           args = (b == std::string::npos) ? "" : args.substr(b, e - b + 1); .)
      ]
      (. result = new RuleCall(std::move(rname), std::move(args));
         result->loc = loc; .)
    | "("
      PegBody<inner>
      ")"
      (. result = new Group(inner);
         result->loc = inner->loc; .)
    | "["
      PegBody<inner>
      "]"
      (. result = new Optional(inner);
         result->loc = inner->loc; .)
    | "{"
      PegBody<inner>
      (. bool is_plus = false; .)
      "}"
      [ "+"
        (. is_plus = true; .)
      ]
      (. if (is_plus) {
             result = new Plus(inner);
         } else {
             result = new Star(inner);
         }
         result->loc = inner->loc; .)
.

END Peg.
