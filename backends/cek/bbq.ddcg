// ── Unary ──────────────────────────────────────────────────

rule expr_unary_neg : ast.UnaryOp(op: Neg, operand: e) {
    let ev = gen(e, rho, ac, jump(Lnext), Lnext);
    cg_deliver(make_neg(ev), delta, gamma, Lnext);
}

rule expr_unary_bitnot : ast.UnaryOp(op: BitNot, operand: e) {
    let ev = gen(e, rho, ac, jump(Lnext), Lnext);
    cg_deliver(make_bit_not(ev), delta, gamma, Lnext);
}

rule expr_unary_not : ast.UnaryOp(op: Not, operand: e) {
    let ev = gen(e, rho, ac, jump(Lnext), Lnext);
    cg_deliver(make_not(ev), delta, gamma, Lnext);
}

// ── Ternary ────────────────────────────────────────────────

rule expr_ternary : ast.Ternary(cond: c, then_branch: t, else_branch: el) {
    let cv = gen(c, rho, ac, jump(Lnext), Lnext);
    let tv = gen(t, rho, ac, jump(Lnext), Lnext);
    let ev = gen(el, rho, ac, jump(Lnext), Lnext);
    cg_deliver(make_ternary(cv, tv, ev), delta, gamma, Lnext);
}

rule expr_endian_lit : ast.EndianLit(value: v) {
    // Endian literal compiles to a bool: true=little, false=big.
    cg_deliver(make_bool_lit(endian_to_bool(v)), delta, gamma, Lnext);
}

// ── Function call ──────────────────────────────────────────

rule expr_call : ast.Call(func: f, args: as) {
    let arg_irs = compile_call_args(as, rho, Lnext);
    cg_deliver(make_call(f, arg_irs), delta, gamma, Lnext);
}

// ── Structural: Rule (top-level entry compiled by the driver) ──

// Each rule's body compiles as a spine kont chain ending in Lnext.
// The driver passes Lnext = ReturnRule → Halt for each rule, so the
// body's tail naturally chains into return/halt.
rule rule_def : ast.Rule(name: n, body: b) {
    gen(b, rho, delta, gamma, Lnext);
}

// ── Structural: Struct ─────────────────────────────────────

rule struct_def : ast.Struct(fields: fs, constraint: cn) {
    // BeginStruct → fields (reverse) → [where?] → EndStruct → Lnext. The struct-level
    // `where` runs after the last field but BEFORE EndStruct, so it sits inside the
    // struct frame — exactly where a field-level where lives, so its on_false /
    // AbortRule propagates the same way. It still sees every field in the environment.
    let end_kont = make_end_struct(Lnext);
    let checked = wrap_struct_where(cn, rho, end_kont);
    let fields_chain = compile_fields(fs, rho, checked);
    cg_deliver(make_begin_struct(intern_field_or_anon(rho), fields_chain), delta, gamma, Lnext);
}

// ── Structural: Primitive ──────────────────────────────────

rule primitive_def : ast.Primitive(kind: k, constraint: cn, interval: iv) {
    // The primitive_kind AST distinguishes bytes/string (variable length
    // via interval) from int/float/bool (fixed primitive). The helper
    // dispatches on kind and wraps with EvalConstraint when constraint
    // is set.
    cg_deliver(compile_primitive(k, cn, iv, rho, Lnext),
               delta, gamma, Lnext);
}

// ── Structural: RuleRef ────────────────────────────────────

rule rule_ref_def : ast.RuleRef(name: n) {
    // Wrap InvokeRule with BeginStruct/EndStruct under the field name.
    // For `hdr: Inner`, this puts Inner's captures under a sub-struct
    // named "hdr" — matching the user-facing convention `result.hdr.x`
    // and the OLD compiler's behavior. The Inner rule body itself
    // doesn't add a wrapper (top-level rules inline per the driver).
    //
    // make_invoke_rule registers the InvokeRuleNode for forward-ref
    // patching; entry is filled in by compile_grammar after every rule
    // body is compiled, so recursive grammars link correctly.
    let end_st = make_end_struct(Lnext);
    let invoke = make_invoke_rule(n, find_backtrack_target(rho), end_st);
    cg_deliver(make_begin_struct(intern_field_or_anon(rho), invoke),
               delta, gamma, Lnext);
}

// ── Structural: Compute ────────────────────────────────────
// `compute(expr : type)` evaluates expr and binds it. The field name
// comes from the parent Field; this rule just emits BindCompute with
// the expression sub-tree.

rule compute_def : ast.Compute(expression: e) {
    let expr_ir = gen(e, rho, ac, jump(Lnext), Lnext);
    // Produce the computed value, then Capture (as Computed) + StoreEnv.
    cg_deliver(make_bind_compute(expr_ir, field_dest(intern_field_or_anon(rho), Lnext)),
               delta, gamma, Lnext);
}

// ── Structural: Extern ─────────────────────────────────────

rule extern_def : ast.Extern(func_name: f, write_func: w) {
    cg_deliver(make_external_call(f, w, field_dest(intern_field_or_anon(rho), Lnext)),
               delta, gamma, Lnext);
}

// ── Structural: EndianSwitch ───────────────────────────────

rule endian_switch_def : ast.EndianSwitch(endian_expr: e) {
    let expr_ir = gen(e, rho, ac, jump(Lnext), Lnext);
    cg_deliver(make_set_endian(expr_ir, Lnext), delta, gamma, Lnext);
}

// ── Structural: Bitfield ───────────────────────────────────

rule bitfield_def : ast.Bitfield(container: c, entries: es) {
    // An inline bitfield field (`flags: bitfield<...>`) nests its members under
    // a sub-struct named for the field — `result.flags.high` — so wrap the
    // member chain in BeginStruct/EndStruct, exactly like rule_ref_def does for
    // `hdr: Inner`. (Top-level `Flags = bitfield<...>` skips this: compile_grammar
    // inlines it flat into the rule struct, as it does for top-level structs.)
    let prim = to_prim_info(c);
    let end_st = make_end_struct(Lnext);
    let inner = compile_bitfield(prim, es, rho, end_st);
    cg_deliver(make_begin_struct(intern_field_or_anon(rho), inner), delta, gamma, Lnext);
}

// ── Structural: Optional ───────────────────────────────────

rule optional_def : ast.Optional(element: e, constraint: cn) {
    // A `where` constraint makes the optional predicated (if-cond, no
    // backtracking); without one it is try/restore. compile_optional builds
    // either, so both forms share the in_optional / Savepoint machinery and
    // the find_backtrack_target contract.
    cg_deliver(compile_optional(e, cn, rho, Lnext), delta, gamma, Lnext);
}

// ── Structural: Switch ─────────────────────────────────────

rule switch_def : ast.Switch(discriminator: d, cases: cs, default: dflt) {
    let cs_list = compile_switch_cases(cs, rho, Lnext);
    let disc = gen(d, rho, ac, jump(Lnext), Lnext);
    let default_target = compile_switch_default(dflt, rho, Lnext);
    let is_reject = switch_default_is_reject(dflt);
    cg_deliver(make_switch_dispatch(disc, cs_list, default_target, is_reject),
               delta, gamma, Lnext);
}

rule alternatives_def : ast.Alternatives(alts: a) {
    cg_deliver(compile_alternatives(a, rho, Lnext), delta, gamma, Lnext);
}

rule union_def : ast.Union(variants: vs) {
    // Union variants are essentially alternative type-exprs; reuse
    // the alternatives helper after stripping each variant's body.
    cg_deliver(compile_union(vs, rho, Lnext), delta, gamma, Lnext);
}

rule array_def : ast.Array(element: e, spec: s, element_interval: ei, resync: rs) {
    cg_deliver(compile_array(e, s, ei, rs, rho, Lnext), delta, gamma, Lnext);
}

