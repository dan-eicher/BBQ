COMPILER kitchensink

(. #include "kitchensink_runtime.h" .)

IMPORTS
  ast    = "kitchensink_ast.json"
  target = "kitchensink_target.json"

DESTINATIONS
  data_dest delta { effect | ac | spill(slot: int) }
  ctrl_dest gamma { fail | jump(target: label) }
  // Multi-variant ρ: frame is the basic env, scoped extends it with
  // a label. Both share `depth` so existing field-access / with-update
  // paths in feature_demo continue to work via the common-field rule.
  env_dest  rho   { frame(depth: int) | scoped(depth: int, label: int) }
  // User-defined closed sum — same machinery as δ/γ/ρ but doesn't
  // slot into the dispatcher signature. Useful for defunctionalising
  // pattern-dispatch over a finite set of "what to do" tags. Mixes
  // a nullary variant, a fielded variant with one int field, and a
  // fielded variant with two int fields to exercise the tagged-union
  // emit + match dispatch + ctor call paths.
  sum demo_op { OpNop | OpStep(delta: int) | OpRange(lo: int, hi: int) }
  ir_root int

AUXILIARIES
  trace_fire : (string) -> int
  cg_lit     : (int) -> int
  cg_seq     : (list<int>) -> int
  cg_pick    : (int, int) -> int
  cg_str     : (string) -> int
  cg_split   : (int) -> tuple<int, int>
  place      : (label) -> int
  log_value  : (target.value) -> int
  // Coverage-only auxes — invoked from feature_demo to exercise
  // BoolLit / TupleLit / list-as-aux-arg paths in the codegen.
  bool_demo  : (bool) -> int
  tup_sum    : (tuple<int, int>) -> int

  // Takes the matched AST node (via the `node` binding rule bodies
  // get for free). Real consumers use this for sema-sidecar lookups
  // keyed by node pointer.
  inspect_node : (ast.expr) -> int

  // Optional consumer hook: every dispatcher wraps the rule's
  // returned ir_root through this aux before returning. Two things
  // get exercised by declaring it: (1) the wrap call is emitted, and
  // (2) per-case rule splits with where-guards / nested-pattern
  // specialisations correctly `break;` after a match instead of
  // letting the unguarded fallthrough rule overwrite the result.
  // Without the break, declaring this hook would make the existing
  // result-sum assertion fail because the fallthrough `lit` /
  // `add` / `sym` rules would run on top of their guarded siblings.
  on_dispatch_result : (int) -> int

PREDICATES
  is_zero       : (int) -> bool
  is_short_name : (string) -> bool

// C-mode contract: MEMBERS is data fields only. Aux/pred bodies live
// in kitchensink_main.c as free functions.
//
// `bbq_arena*` is the same arena the asdl-c factories take, threaded
// through every BuildExpr. The trace is a fixed-size pointer ring —
// strings are arena-allocated by the consumer's trace_fire body.
MEMBERS (.
    bbq_arena* arena;
    SourceLoc current_loc;
    int next_label;
    const char* trace_entries[256];
    int trace_count;
.)

// Action-language helper: dispatches on δ via `match` and constructs
// a target::value via `build`. Exercises fun + match-as-expr + build.
fun dest_to_value(d : delta) -> target.value {
    match (d) {
        effect      => build target.Imm(0)
      | ac          => build target.Imm(99)
      | spill(slot) => build target.Slot(slot)
    };
}

// `match` over an asdl-enum subject lowers to `switch` on the value.
// `_` covers any future variants (and exercises WildcardPat in arm).
fun op_to_int(o : ast.op) -> int {
    match (o) {
        OpAdd => 1
      | OpSub => 2
      | OpMul => 3
      | _     => 0
    };
}

// Module-qualified enum-sum value (`ast.OpAdd`). Used when a bare
// enum-value name would be ambiguous across multiple loaded schemas.
// Lowers to the same constant as the bare form (here `AST_OP_ADD`).
fun pick_op() -> ast.op {
    ast.OpAdd;
}

// Block-as-expression — `{ stmts; tail_expr; }` evaluates the stmts
// in sequence and yields the tail. Most-needed shape: one arm of a
// ternary needs intermediate let-bindings and isn't a single expr.
fun block_expr_demo(x: int) -> int {
    x > 0
      ? x
      : { let neg = 0 - x;
          let twice = neg + neg;
          twice; };
}

// `if cond { … } else { … }` as a statement — direct replacement for
// `match (cond) { true => { … } | _ => { … } };` patterns. Body
// scopes are independent so let-bindings don't leak.
fun if_stmt_demo(x: int) -> int {
    let result = 0;
    if x > 0 {
        result := x;
    } else {
        result := 0 - x;
    }
    result;
}

// Indexed for-loop — `for (i, x) in xs { … }` exposes the integer
// index alongside the element so iterative algorithms don't have to
// hand-roll a counter via `let i = 0; …; i := i + 1;`. Backend maps
// to the natural form (C: `xs.data[i]`, C++: `xs[i]`) without the
// .ddcg author having to know.
fun indexed_for_demo(xs: list<int>) -> int {
    let last_pos = 0 - 1;
    for (i, v) in xs {
        if v > 0 {
            last_pos := i;
        }
    }
    last_pos;
}

// Exercises BindPat-default-with-subject-bind in a match arm —
// `_other` doesn't match any zero-arg dest variant of `delta`,
// so the C/C++ emitter generates `default:` plus a bind of the
// matched subject.
fun delta_default(d : delta) -> int {
    match (d) {
        effect => 1
      | _other => 99
    };
}

// Match on multi-variant env_dest with field bindings. The scoped
// arm uses shorthand to bind `label` and leaves `depth` unmentioned.
fun describe_rho(r : rho) -> int {
    match (r) {
        frame         => trace_fire("rho_frame")
      | scoped(label) => label
    };
}

// One fun per untested DSL form, all bundled into a single sink:
//   - UnaryOp (`-x`)
//   - ListLit + IndexAccExpr (`xs[0]`)
//   - WithExpr (`r with depth = 1`)
//   - FieldAccExpr on a Dest value (`r2.depth`)
//   - BoolLit (`true` literal arg)
//   - TupleLit (`(a, b)` constructor)
fun feature_demo(r : rho, x : int) -> int {
    let neg  = -x;
    let xs   = [x, neg];
    let head = xs[0];
    let r2   = r with depth := 1;
    let _    = bool_demo(true);
    let _    = tup_sum((head, neg));
    cg_pick(head, r2.depth);
}

// In big.ddcg this lives in big_imports.ddcg and is pulled in via
// `import`. The cross-file import is a parser/typecheck feature, not
// a code-gen one; inlined here so the C kitchensink stays single-file.
fun import_demo(n : int) -> int {
    let _ = trace_fire("import_demo");
    n;
}

// ── User-defined sum exercise: builds each demo_op variant, then
//    matches and reduces to a representative int per variant.
//    Validates: sum-type ctor calls (nullary + 1 field + 2 fields)
//    typecheck and emit; match over a sum-typed subject runs the
//    same dispatch machinery used for δ/γ/ρ.
fun demo_op_to_int(op : demo_op) -> int {
    match (op) {
        OpNop                      => 0
      | OpStep(delta: d)           => d
      | OpRange(lo: a, hi: b)      => a + b
    };
}
fun demo_op_demo(seed : int) -> int {
    let _   = trace_fire("demo_op_demo");
    let nop = OpNop;
    let st  = OpStep(seed);
    let rg  = OpRange(seed, seed + seed);
    demo_op_to_int(nop) + demo_op_to_int(st) + demo_op_to_int(rg);
}

RULES

// ── Nested ConstructorPat: zero-left optimisation fires before general Add.
rule add_zero_l : ast.Add(left: ast.Lit(n: 0), right: r) {
    trace_fire("add_zero_l");
    cg_pick(0, gen(r, rho, ac, fail));
}

// ── Where-guarded specialisation (predicate over int).
rule lit_zero : ast.Lit(n: x) where is_zero(x) {
    trace_fire("lit_zero");
    cg_lit(0);
}

// ── Tuple-destructuring let + ternary + tuple-returning aux.
//    Also fires the `feature_demo` and `delta_default` funs to
//    exercise the rule-body forms they cover (UnaryOp, ListLit,
//    IndexAccExpr, WithExpr, FieldAccExpr, BoolLit, TupleLit, and
//    BindPat-default-with-subject-bind in match arms).
rule lit : ast.Lit(n: x) {
    trace_fire("lit");
    let _ = feature_demo(rho, x);
    // Pass the matched AST node to an aux that needs it.
    let _ = inspect_node(node);
    // Exercise the scoped variant of rho — frame variant is exercised
    // via feature_demo above (rho is frame(0) from main).
    let _ = describe_rho(scoped(0, x));
    let _ = delta_default(spill(7));
    let (lo, hi) = cg_split(x > 100 ? 100 : x);
    cg_pick(lo, hi);
}

// ── General Add (fallback after the nested-pat specialisation).
rule add : ast.Add(left: l, right: r) {
    trace_fire("add");
    cg_pick(gen(l, rho, ac, fail), gen(r, rho, ac, fail));
}

// ── WildcardPat in rule head: first field wildcarded, second
//    constrained to a literal sub-pattern via nested ConstructorPat.
//    Must come BEFORE the generic `pair` rule below to win the match.
rule pair_x99 : ast.Pair(first: _, second: ast.Lit(n: 99)) {
    trace_fire("pair_x99");
    cg_lit(99);
}

// ── For-loop accumulator + list concat + Sequence-typed field bind.
rule seq : ast.Seq(items: es) {
    trace_fire("seq");
    let _ = import_demo(0);
    // Exercise the user-defined `sum demo_op` end-to-end: ctor
    // calls (nullary + one field + two fields), match dispatch,
    // and the same tagged-union emit machinery as δ/γ/ρ.
    let _ = demo_op_demo(3);
    let acc: list<int> = [];
    for e in es {
        acc := acc + [gen(e, rho, ac, fail)];
    }
    cg_seq(acc);
}

// ── Label statement + label-payload γ variant + match-driven action fun.
rule pair : ast.Pair(first: e1, second: e2) {
    trace_fire("pair");
    let _ = log_value(dest_to_value(ac));
    let _ = log_value(dest_to_value(spill(7)));
    label L;
    gen(e1, rho, effect, jump(L));
    place(L);
    cg_pick(gen(e2, rho, effect, fail), 0);
}

// ── StringPat: literal string match in a field.
rule sym_x : ast.Sym(name: "x") {
    trace_fire("sym_x");
    cg_str("x-special");
}

// ── String predicate guard.
rule sym_short : ast.Sym(name: n) where is_short_name(n) {
    trace_fire("sym_short");
    cg_str(n);
}

rule sym : ast.Sym(name: n) {
    trace_fire("sym");
    cg_str(n);
}

// ── NilPat: optional field with NULL.
rule maybe_none : ast.Maybe(sub: nil) {
    trace_fire("maybe_none");
    cg_lit(-1);
}

rule maybe_some : ast.Maybe(sub: s) {
    trace_fire("maybe_some");
    gen(s, rho, ac, fail);
}

// ── Per-op rules dispatch on the `op` enum constructor as a field-pat
//    constant — bare `OpAdd` is the enum value, not a value-bind.
rule binop_add : ast.BinOp(op: OpAdd, left: l, right: r) {
    trace_fire("binop_add");
    cg_pick(gen(l, rho, ac, fail), gen(r, rho, ac, fail));
}

rule binop_sub : ast.BinOp(op: OpSub, left: l, right: r) {
    trace_fire("binop_sub");
    cg_pick(gen(l, rho, ac, fail), gen(r, rho, ac, fail));
}

rule binop_mul : ast.BinOp(op: OpMul, left: l, right: r) {
    trace_fire("binop_mul");
    cg_pick(gen(l, rho, ac, fail), gen(r, rho, ac, fail));
}

// ── Enum-typed field bound by name, then matched on by a fun.
rule sel : ast.Sel(which: w) {
    trace_fire("sel");
    cg_lit(op_to_int(w));
}

// ── RestFieldPat (`...nums`) on a sequence-typed field. Mirrors
//    `Seq(items: items)` semantics but uses the `...` syntax.
rule multi : ast.Multi(...nums) {
    trace_fire("multi");
    cg_seq(nums);
}
