// bbq.ddcg — BBQ AST → CEK kont IR via DDCG.
//
// Drives the AST→IR translation per the design doc §5. Imports
// dybvig.ddcg's δ/γ/ρ destinations and codegen primitives.
//
// BBQ uses a narrow slice of DDCG:
//   * δ ∈ {ac, effect}.  ac for expression rules (the value flows
//     via the typed accumulator at runtime); effect for spine rules
//     (kont sub-trees threaded via `next`).
//   * γ = jump(L) only. The driver wraps each rule with γ=jump(Halt)
//     by allocating Halt + ReturnRule at the top.
//   * ρ is unit — BBQ has no break label.
//
// Spine konts carry `next` (per-variant in bbq_ir.asdl). Expression
// operator konts carry sub-tree pointers (left/right/cond/then/else)
// and have no `next`. Apply / consumer dynamic konts are runtime-
// allocated; ddcg only emits the static_kont side.

COMPILER bbq INTERNAL_DISPATCHERS

(.
   #include "BBQ_AST.h"
   #include "Sema.h"
   #include "KontNode.h"
   #include "ParseArena.h"
   #include "StringPool.h"
   #include "CompiledGrammar.h"
   #include <cassert>
   #include <cstring>
   #include <cstdio>
   #include <unordered_map>
   #include <utility>
   #include <vector>

   // ddcgc references generated IR types as `bbq_ir::*` (matching the
   // asdl module name `module bbq_ir`). Our hand-written runtime
   // declares them in `bbq::cek::` (the existing CEK namespace).
   // Alias one to the other so the ddcg-generated Compiler class
   // finds StaticKont / DynamicKont / Value / etc.
   namespace bbq_ir = bbq::cek;

   // Destination types live at `namespace bbq` scope — that's where
   // ddcgc generates `class Compiler`, and the generated dispatch
   // methods reference these as bare names (delta_t / gamma_t / rho_t).
   namespace bbq {

   // δ — paper §3.1 Location class. BBQ uses {effect, ac}.
   enum class DeltaTag : unsigned char { Effect, Ac, Stack, Local };
   struct delta_t { DeltaTag tag; int i; };
   inline delta_t effect()        { return {DeltaTag::Effect, 0}; }
   inline delta_t ac()            { return {DeltaTag::Ac,     0}; }
   inline delta_t stack()         { return {DeltaTag::Stack,  0}; }
   inline delta_t local(int i)    { return {DeltaTag::Local,  i}; }

   // γ — paper §3.2 control destination. BBQ uses jump(L) only.
   enum class GammaTag : unsigned char { Jump, Pair, Ret };
   struct gamma_t {
       GammaTag tag;
       bbq::cek::StaticKont* L;
       bbq::cek::StaticKont* Lt;
       bbq::cek::StaticKont* Lf;
   };
   inline gamma_t jump(bbq::cek::StaticKont* L)                                       { return {GammaTag::Jump, L,       nullptr, nullptr}; }
   inline gamma_t pair(bbq::cek::StaticKont* Lt, bbq::cek::StaticKont* Lf)            { return {GammaTag::Pair, nullptr, Lt,      Lf}; }
   inline gamma_t ret()                                                                { return {GammaTag::Ret,  nullptr, nullptr, nullptr}; }

   // ρ — lexical-scope chain consumed at compile time only. The
   // yoctojc pattern: each backtrackable scope wraps the caller's ρ
   // with a frame carrying the static failure target for inner
   // where-checks. find_backtrack_target walks ρ at compile time to
   // resolve the on_false destination; intern_field_or_anon walks to
   // the innermost in_field for capture naming.
   //
   //   in_field      — current field name, for capture metadata.
   //                   intern_field_or_anon walks to it.
   //   in_alt        — non-last arm of an alt; next_arm is the
   //                   compile-time-baked OnFailKont link that
   //                   restores the savepoint and dispatches to the
   //                   next arm.
   //   in_optional   — optional inner; skip is the OnFailKont link
   //                   that restores + pops + jumps past the optional.
   //   in_array_elem — array-element scope. Acts as a name barrier
   //                   for intern_field_or_anon. skip is non-null only
   //                   in resync mode (= the ResyncKont); otherwise
   //                   find_backtrack_target walks past transparently.
   //
   // The struct is a POD; `parent` is a pointer because C++ structs
   // can't recurse by value. Constructors are Compiler member methods
   // (see PRIVATE block) so parent allocation goes through arena_;
   // ddcgc-emitted calls resolve to `this->ctor(...)` via bare-name
   // lookup in dispatcher methods.
   enum class RhoTag : unsigned char {
       Root,
       InField,
       InAlt,
       InOptional,
       InArrayElem,
   };
   struct rho_t {
       RhoTag tag;
       const char* name;                  // InField only
       bbq::cek::StaticKont* fail_target; // InAlt.next_arm / InOptional.skip / InArrayElem.skip
       rho_t* parent;                     // every non-Root variant
   };

   } // namespace bbq
.)

IMPORTS
  ast = "bbq.json"
  ir  = "bbq_ir.json"

DESTINATIONS
  // The compiler emits only static_kont variants (dynamic_kont konts
  // are runtime-allocated). ir_root binds to that sum.
  ir_root ir.static_kont

  // BBQ-narrow destination languages. δ uses {effect, ac} only; γ uses
  // jump only. ρ is a recursive scope chain — every backtrackable
  // construct pushes a frame so where-failures resolve their on_false
  // target via static find_backtrack_target walks instead of runtime
  // frame walking.
  data_dest delta { effect | ac }
  ctrl_dest gamma { jump(L: ir_root) }
  env_dest  rho   { root
                  | in_field      (name: ident,                            parent: rho)
                  | in_alt        (next_arm: ir_root,                      parent: rho)
                  | in_optional   (skip: ir_root,                          parent: rho)
                  | in_array_elem (skip: ir_root,                          parent: rho) }

AUXILIARIES
  // Hard-fail for paper-undefined γ contexts. BBQ's driver wraps
  // every rule with γ=jump(Halt), so inner rule bodies never see
  // ret or pair forms. Reaching panic_unreachable means a normalizer
  // bug or a rule that synthesized the wrong γ.
  panic_unreachable     : ()                  -> ir_root

  // Static_kont allocators — one per emitted variant. Each is a
  // thin arena.alloc<*Kont>() wrapper; the runtime invoke()s live
  // in Machine.cpp.

  // Spine
  make_match_primitive  : (primitive_info, ir_root) -> ir_root  // prim, next
  make_capture          : (ident, ir_root) -> ir_root  // name, next  → output tree
  make_store_env        : (ident, ir_root) -> ir_root  // name, next  → E binding
  field_dest            : (ident, ir_root) -> ir_root  // name, next  → the field's destination
  make_begin_struct     : (ident, ir_root) -> ir_root
  make_begin_variant    : (ident, int, ir_root) -> ir_root  // name, tag, next
  make_end_struct       : (ir_root) -> ir_root
  make_eval_constraint  : (ir_root, ir_root, ir_root) -> ir_root  // expr, on_false, next
  make_bind_compute     : (ir_root, ir_root) -> ir_root  // expr, next
  // Interval region: Seek (pos := ac), PushInterval (push ac as the end bound;
  // relative => pos+ac for @[length]), PopInterval. interval_entry wraps a body
  // that already chains into PopInterval with the seek/push entry sequence.
  make_seek             : (ir_root, ir_root) -> ir_root          // expr, next
  make_push_interval    : (bool, ir_root, ir_root) -> ir_root    // relative, expr, next
  make_pop_interval     : (bool, ir_root) -> ir_root    // checked, next
  interval_entry        : (ast.interval, rho, ir_root) -> ir_root  // interval, rho, body
  // The interval attached to a type-body node (Primitive/RuleRef/Array/Extern), or
  // null. Intervals belong to the invocation, so this is where most attach.
  interval_of           : (ast.type_expr) -> ast.interval
  // Allocates an InvokeRuleNode with entry=nullptr and registers
  // (&node->entry, name) on pending_patches_. compile_grammar resolves
  // every patch by looking name up in rule_entries_ once all rules are
  // compiled — this is how recursive grammars link. caller_fail_target
  // is the caller's static failure destination (find_backtrack_target
  // of the call site's ρ); null at top-level rule calls.
  make_invoke_rule      : (ident, ir_root, ir_root) -> ir_root  // name, caller_fail_target, next
  make_return_rule      : (ir_root) -> ir_root
  // Allocate one OnFailKont link in a backtrack chain. compile_alts
  // builds the full chain right-to-left so each link's target is
  // known when its predecessor is allocated. target=null + pop_frame
  // means "exhausted — pop savepoint and re-fail outward."
  make_on_fail          : (ir_root, ir_root, bool) -> ir_root  // target, next_on_fail, pop_frame
  // Cross-rule failure handler. Used as the on_false target when a
  // where-check at a rule's top level has no in-rule backtrack frame.
  make_abort_rule       : () -> ir_root
  make_begin_choice     : (ir_root, ir_root) -> ir_root  // on_fail_target, first
  make_commit_choice    : (ir_root) -> ir_root
  make_begin_optional   : (ir_root, ir_root, ir_root) -> ir_root  // on_fail_target, inner, next
  make_end_optional     : (ir_root) -> ir_root
  make_begin_array      : (ident, array_mode, ir_root, ir_root, ir_root, ir_root, ir_root) -> ir_root
  make_array_next       : (array_mode, ir_root, ir_root, ir_root, ir_root, bool) -> ir_root
  make_end_array        : (bool, ir_root) -> ir_root
  make_resync           : (ir_root, ir_root) -> ir_root  // body_entry, end_node
  make_switch_dispatch  : (ir_root, list<ir.switch_case>, ir_root, bool) -> ir_root  // disc, cases, default_target, default_reject
  make_extract_bits     : (primitive_info, int, int, bool, ir_root) -> ir_root  // container, width_bits, offset_before, is_signed, next
  make_advance_pos      : (int, ir_root) -> ir_root  // by, next
  make_set_endian       : (ir_root, ir_root) -> ir_root  // expr, next
  make_external_call    : (string, string, ir_root) -> ir_root  // func_name, write_func, next
  make_match_bytes      : (ir_root, bool, ir_root) -> ir_root  // length, is_string, next
  make_halt             : () -> ir_root

  // Expression leaves
  make_int_lit          : (int) -> ir_root
  make_bool_lit         : (bool) -> ir_root
  make_float_lit        : (float) -> ir_root
  make_str_lit          : (string) -> ir_root  // StrLit.value is string
  make_ref              : (ident) -> ir_root
  make_pos              : () -> ir_root
  make_remaining        : () -> ir_root
  make_buffer           : () -> ir_root
  make_start            : () -> ir_root
  make_end              : () -> ir_root
  // Map an @name context builtin to its leaf kont.
  make_builtin          : (ident) -> ir_root
  make_eoi              : () -> ir_root
  make_loop_var         : () -> ir_root

  // Unary
  make_neg              : (ir_root) -> ir_root
  make_bit_not          : (ir_root) -> ir_root
  make_not              : (ir_root) -> ir_root

  // Binop arithmetic
  make_add              : (ir_root, ir_root) -> ir_root
  make_sub              : (ir_root, ir_root) -> ir_root
  make_mul              : (ir_root, ir_root) -> ir_root
  make_div              : (ir_root, ir_root) -> ir_root
  make_mod              : (ir_root, ir_root) -> ir_root

  // Binop bitwise
  make_bit_and          : (ir_root, ir_root) -> ir_root
  make_bit_or           : (ir_root, ir_root) -> ir_root
  make_bit_xor          : (ir_root, ir_root) -> ir_root
  make_shl              : (ir_root, ir_root) -> ir_root
  make_shr              : (ir_root, ir_root) -> ir_root

  // Binop comparison
  make_eq               : (ir_root, ir_root) -> ir_root
  make_ne               : (ir_root, ir_root) -> ir_root
  make_lt               : (ir_root, ir_root) -> ir_root
  make_le               : (ir_root, ir_root) -> ir_root
  make_gt               : (ir_root, ir_root) -> ir_root
  make_ge               : (ir_root, ir_root) -> ir_root

  // Logical short-circuit
  make_logical_and      : (ir_root, ir_root) -> ir_root
  make_logical_or       : (ir_root, ir_root) -> ir_root

  // Ternary
  make_ternary          : (ir_root, ir_root, ir_root) -> ir_root

  // Function call
  make_call             : (ident, list<ir_root>) -> ir_root

  // Path navigation
  make_path_start       : (ident) -> ir_root
  make_field_access     : (ident, ir_root) -> ir_root
  make_index_access     : (ir_root, ir_root) -> ir_root
  make_capture_value    : (ir_root) -> ir_root

  // ── BBQ-specific helpers ─────────────────────────────────

  // Convert a BBQ AST primitive_kind into the runtime PrimitiveInfo.
  to_prim_info          : (ast.primitive_kind) -> primitive_info

  // Dispatch on primitive_kind: bytes/string emit MatchBytes with the
  // length from the interval; int/float/bool emit MatchPrimitive.
  // Wraps with EvalConstraint when constraint is set.
  compile_primitive     : (ast.primitive_kind, ast.expr, ast.interval, rho, ir_root) -> ir_root

  // Wrap a tail with a struct-level `where` check (after all fields), or
  // return it unchanged when the struct has no constraint.
  wrap_struct_where     : (ast.expr, rho, ir_root) -> ir_root

  // Compile an Array — emits BeginArray + body + ArrayNext + EndArray
  // with the body→ArrayNext→body cycle. Body's Lnext is the ArrayNext
  // node; ArrayNext.body_entry is patched to the body head after
  // compilation (forward-ref via member-mutation rather than fresh_kont).
  compile_array         : (ast.type_expr, ast.array_spec, ast.interval, bool, rho, ir_root) -> ir_root

  // Compile an Optional. With a `where` constraint it is predicated — a plain
  // boolean branch (EvalConstraint): true parses the element (mandatory, a
  // failure propagates), false skips straight to Lnext (absent). No Savepoint.
  // Without a constraint it is try/restore: parse under a Savepoint, and on
  // failure restore and continue with the element absent.
  compile_optional      : (ast.type_expr, ast.expr, rho, ir_root) -> ir_root

  // Compile alternatives / union to BeginChoice + per-alt CommitChoice
  // chains. Single-alt cases compile the alt directly (no choice).
  compile_alternatives  : (list<ast.type_expr>, rho, ir_root) -> ir_root
  compile_union         : (list<ast.variant>, rho, ir_root) -> ir_root

  // Compile a list of args (each ast.expr) into a list of value
  // sub-tree IRs. Each arg is gen'd with δ=ac, γ=jump(Lnext).
  compile_call_args     : (list<ast.expr>, rho, ir_root) -> list<ir_root>

  // Compile a sequence of fields into a spine kont chain ending in
  // the supplied tail. Fields are compiled in reverse (last field
  // chains into tail, prev chains into next, etc.). Each field body
  // sees ρ = in_field(name, parent=enclosing_rho) so backtrack frames
  // outside the struct remain reachable from inner where-checks.
  compile_fields        : (list<ast.field>, rho, ir_root)   -> ir_root

  // Compile a bitfield entry list into the runtime entry array shape.
  compile_bitfield      : (primitive_info, list<ast.bitfield_entry>, rho, ir_root) -> ir_root

  // Compile a sequence of switch cases.
  compile_switch_cases  : (list<ast.switch_case>, rho, ir_root) -> list<ir.switch_case>

  // Compile the optional default branch, returning a kont (or
  // nullptr-equivalent) for the SwitchDispatch's default_target.
  compile_switch_default : (ast.switch_default, rho, ir_root) -> ir_root
  // True only for an explicit `default: reject` (distinct from no-default), so
  // the runtime's no-match failure can name the cause.
  switch_default_is_reject : (ast.switch_default) -> bool

  // Convert an endianness AST literal to a bool (true=little, false=big).
  endian_to_bool        : (ast.endianness) -> bool

  // Compile a ref-path into a chain of path-nav konts terminating in
  // a PathStartKont. `then_capture` controls whether the outermost
  // call wraps with CaptureValueKont (true at the user-facing edge,
  // false when this path is the base of another path step).
  compile_ref_path      : (ast.ref_path, ident, bool) -> ir_root
  compile_ref_index_path : (ast.ref_path, ir_root, bool) -> ir_root

  // Read the current field name from rho (empty if compiling a
  // rule-level body — anonymous capture). Walks to the innermost
  // in_field. in_array_elem is a name barrier (elements are
  // anonymous regardless of the array's name).
  intern_field_or_anon  : (rho)                -> ident

  // Walk ρ to the innermost backtrackable scope's static failure
  // target. Returns nullptr at root — caller substitutes
  // AbortRuleKont. Used by compile_primitive's where-check on_false
  // and by make_invoke_rule to bake caller_fail_target.
  find_backtrack_target : (rho)                -> ir_root

  // Resolve a Simple ref name to either a built-in leaf (i / pos /
  // remaining / at_end) or a user-defined RefKont. Avoids ddcg's
  // lack of ident-vs-string equality in rule bodies.
  make_ref_or_builtin   : (ident, ident, ident, int) -> ir_root  // name, resolved_path, resolved_parent, resolved_depth

MEMBERS (.
    // ── Public API: the only entry point on bbq::Compiler ──────
    //
    // Per design doc §5.4: the driver owns program-exit wrapping.
    // For each rule:
    //   1. Allocate the rule's exit kont chain: Halt at the bottom,
    //      ReturnRule on top. Top-level entries push a throwaway
    //      ReturnFrame in the runtime so ReturnRule has something to
    //      pop; inner calls (via InvokeRule) push real ReturnFrames.
    //   2. Compile the rule body with γ=jump(exit). Top-level Struct
    //      bodies inline (no BeginStruct wrapper) so user-facing
    //      results expose `result.<field>` rather than
    //      `result.<empty>.<field>`.
    //   3. Record the body head in rule_entries_.
    //
    // After every rule has compiled, walk pending_patches_ and resolve
    // each (slot, name) to rule_entries_[name]. Sema rejects refs to
    // unknown rule names before we get here, so an unresolved patch
    // means an internal invariant was broken.
    bbq::cek::CompiledGrammar* compile_grammar(BBQ::Grammar* grammar) {
        if (!grammar) return nullptr;
        auto* result = new bbq::cek::CompiledGrammar();
        arena_   = &result->arena;
        strings_ = &result->strings;
        rule_entries_.clear();
        pending_patches_.clear();

        std::vector<bbq::cek::CompiledGrammar::RuleEntry> entries;
        entries.reserve(grammar->rules.size());

        for (auto* rule : grammar->rules) {
            auto* halt = arena_->alloc<bbq::cek::HaltNode>();
            auto* exit_kont = make_return_rule(halt);
            auto* exit_static = static_cast<bbq::cek::StaticKont*>(exit_kont);

            ::bbq::rho_t rho = root();
            bbq::cek::StaticKont* body_head = nullptr;
            if (auto* st = dynamic_cast<BBQ::Struct*>(rule->body)) {
                // Top-level structs inline their fields directly (no BeginStruct
                // wrapper). A struct-level `where` still applies: it runs after the
                // fields, before ReturnRule. (struct_def handles the nested case.)
                bbq::cek::StaticKont* tail = wrap_struct_where(st->constraint, rho, exit_static);
                body_head = compile_fields(st->fields, rho, tail);
            } else if (auto* bf = dynamic_cast<BBQ::Bitfield*>(rule->body)) {
                // Top-level bitfields inline their members directly into the rule
                // struct (no BeginStruct wrapper), the same shape as top-level
                // structs. bitfield_def handles the nested (inline field) case,
                // where the members must sit under their own sub-struct scope.
                bbq::cek::PrimitiveInfo prim = to_prim_info(bf->container);
                body_head = compile_bitfield(prim, bf->entries, rho, exit_static);
            } else {
                body_head = compile_type_expr(
                    rule->body, rho, ::bbq::effect(),
                    ::bbq::jump(exit_static), exit_static);
            }

            rule_entries_[rule->name] = body_head;
            entries.push_back({result->strings.intern(rule->name), body_head});
        }

        // Resolve every InvokeRuleNode's entry by looking up its rule
        // name in rule_entries_. Recursive grammars round-trip cleanly
        // here: the back-edge from kid → Tree finds Tree's body head.
        for (auto& [slot, name] : pending_patches_) {
            auto it = rule_entries_.find(name);
            if (it == rule_entries_.end()) {
                std::fprintf(stderr,
                    "bbq compile: unresolved rule reference '%s' "
                    "(Sema should have caught this)\n", name.c_str());
                std::abort();
            }
            *slot = it->second;
        }

        if (!entries.empty()) {
            result->rules = static_cast<bbq::cek::CompiledGrammar::RuleEntry*>(
                result->arena.allocate(
                    entries.size() * sizeof(bbq::cek::CompiledGrammar::RuleEntry),
                    alignof(bbq::cek::CompiledGrammar::RuleEntry)));
            for (size_t i = 0; i < entries.size(); ++i) {
                result->rules[i] = entries[i];
            }
            result->rule_count = static_cast<int>(entries.size());
        }

        for (auto* d : grammar->directives) {
            if (auto* ed = dynamic_cast<BBQ::EndianDirective*>(d)) {
                result->default_little_endian =
                    (ed->endian == BBQ::Endianness::Little);
            }
        }

        // Pre-intern built-in function names into result->strings so
        // CallApplyKont's dispatch can use pointer-equality against
        // call-site func_name pointers (also interned in this pool).
        bbq::cek::populate_builtins(*result);

        return result;
    }
.)

PRIVATE (.
    // Allocation arena for IR konts, owned by the compiled grammar.
    bbq::ParseArena* arena_ = nullptr;
    bbq::cek::StringPool* strings_ = nullptr;

    // Rule entry table — populated as each rule finishes compiling.
    // After the per-rule loop in compile_grammar, every rule name maps
    // to its real body-head kont. pending_patches_ is then resolved
    // against this table.
    std::unordered_map<std::string, bbq::cek::StaticKont*> rule_entries_;

    // Forward-reference patch list. make_invoke_rule allocates an
    // InvokeRuleNode with entry=nullptr and pushes (&node->entry, name)
    // onto this list. compile_grammar walks the list at the end and
    // resolves each slot to rule_entries_[name]. Sema rejects any
    // unknown name before we get here, so unresolved entries indicate
    // a Sema/compiler invariant violation and abort.
    std::vector<std::pair<bbq::cek::KontNode**, std::string>> pending_patches_;

    // ddcgc-generated dispatch threads `current_loc` from each AST
    // node it traverses (via `current_loc = node->loc`). Type matches
    // BBQ_AST.h's SourceLoc. Rule bodies don't currently consume it
    // but keeping it correct so generated code compiles.
    BBQ::SourceLoc current_loc{};

    // ── ρ constructors (member methods so parent allocation hits arena_) ──
    //
    // The C++ ddcg backend calls these as `this->ctor(...)` via bare-
    // name lookup in dispatcher methods (per emit_backend.h:118-120
    // design intent). All non-Root variants arena-copy parent so the
    // resulting rho_t is self-contained; ρ chains live as long as the
    // ParseArena, which is the right scope (ρ is throwaway after
    // compile_grammar but the arena is per-CompiledGrammar anyway).
    //
    // ρ frames are POD-copied from `parent_val` into a fresh arena slot
    // via placement-new; arena_->alloc<rho_t>() returns aligned storage.
    ::bbq::rho_t* arena_rho(::bbq::rho_t parent_val) {
        auto* p = arena_->alloc<::bbq::rho_t>();
        *p = parent_val;
        return p;
    }

    ::bbq::rho_t root() {
        return ::bbq::rho_t{::bbq::RhoTag::Root, nullptr, nullptr, nullptr};
    }
    ::bbq::rho_t in_field(const std::string& name, ::bbq::rho_t parent_val) {
        const char* n = name.empty() ? nullptr : strings_->intern(name);
        return ::bbq::rho_t{::bbq::RhoTag::InField, n,
                            nullptr, arena_rho(parent_val)};
    }
    ::bbq::rho_t in_alt(bbq::cek::StaticKont* next_arm, ::bbq::rho_t parent_val) {
        return ::bbq::rho_t{::bbq::RhoTag::InAlt, nullptr,
                            next_arm, arena_rho(parent_val)};
    }
    ::bbq::rho_t in_optional(bbq::cek::StaticKont* skip, ::bbq::rho_t parent_val) {
        return ::bbq::rho_t{::bbq::RhoTag::InOptional, nullptr,
                            skip, arena_rho(parent_val)};
    }
    ::bbq::rho_t in_array_elem(bbq::cek::StaticKont* skip,
                               ::bbq::rho_t parent_val) {
        return ::bbq::rho_t{::bbq::RhoTag::InArrayElem, nullptr,
                            skip, arena_rho(parent_val)};
    }

    // ── make_X allocators ─────────────────────────────────────

    bbq::cek::StaticKont* make_match_primitive(bbq::cek::PrimitiveInfo p, bbq::cek::StaticKont* nx) {
        auto* k = arena_->alloc<bbq::cek::MatchPrimitiveNode>();
        k->prim = p; k->next = nx;
        return k;
    }
    // Concrete store konts: each consumes the producer's value in ac and does its
    // one thing. Capture → record an output-tree node; StoreEnv → bind in E; Drop
    // → discard. The name (the WHERE) lives on the store, not the producer.
    bbq::cek::StaticKont* make_capture(const std::string& nm, bbq::cek::StaticKont* nx) {
        auto* k = arena_->alloc<bbq::cek::CaptureKont>();
        k->name = nm.empty() ? nullptr : strings_->intern(nm); k->next = nx;
        return k;
    }
    bbq::cek::StaticKont* make_store_env(const std::string& nm, bbq::cek::StaticKont* nx) {
        auto* k = arena_->alloc<bbq::cek::StoreEnvKont>();
        k->name = nm.empty() ? nullptr : strings_->intern(nm); k->next = nx;
        return k;
    }
    // A field's name picks its placement. Any real name Captures into the output
    // tree AND binds in E. `_` skips Capture — never in the output struct — but
    // StoreEnv stays (under the name `_`), because a `_` field's own `where` (and
    // a `_` length sizing a later array) read the value back through E; a
    // separator is `_` for arrays, so the same path verifies a delimiter. "Don't
    // store in the struct" = skip Capture; the binding is internal plumbing kept
    // for verification. (There is no pure-discard placement: every "don't store"
    // case still wants the binding.)
    bbq::cek::StaticKont* field_dest(const std::string& nm, bbq::cek::StaticKont* tail) {
        if (nm == "_") return make_store_env(nm, tail);
        return make_capture(nm, make_store_env(nm, tail));
    }
    bbq::cek::StaticKont* make_begin_struct(const std::string& nm, bbq::cek::StaticKont* nx) {
        auto* k = arena_->alloc<bbq::cek::BeginStructNode>();
        k->struct_name = strings_->intern(nm); k->next = nx;
        return k;
    }
    bbq::cek::StaticKont* make_begin_variant(const std::string& nm, int tag,
                                             bbq::cek::StaticKont* nx) {
        auto* k = arena_->alloc<bbq::cek::BeginVariantNode>();
        k->variant_name = strings_->intern(nm); k->variant_tag = tag; k->next = nx;
        return k;
    }
    bbq::cek::StaticKont* make_end_struct(bbq::cek::StaticKont* nx) {
        auto* k = arena_->alloc<bbq::cek::EndStructNode>();
        k->next = nx;
        return k;
    }
    bbq::cek::StaticKont* make_seek(bbq::cek::StaticKont* expr, bbq::cek::StaticKont* nx) {
        auto* k = arena_->alloc<bbq::cek::SeekKont>();
        k->expr = expr; k->next = nx; return k;
    }
    bbq::cek::StaticKont* make_push_interval(bool relative, bbq::cek::StaticKont* expr,
                                             bbq::cek::StaticKont* nx) {
        auto* k = arena_->alloc<bbq::cek::PushIntervalNode>();
        k->relative = relative; k->expr = expr; k->next = nx; return k;
    }
    bbq::cek::StaticKont* make_pop_interval(bool checked, bbq::cek::StaticKont* nx) {
        auto* k = arena_->alloc<bbq::cek::PopIntervalNode>();
        k->checked = checked; k->next = nx; return k;
    }

    // Wrap a body (already chained into a PopInterval) with the interval entry
    // sequence. StartEnd: eval(start) -> Seek -> eval(end) -> PushInterval(abs) -> body.
    // Length: eval(len) -> PushInterval(rel = pos+len) -> body (no seek). The start/end
    // expressions deliver to the accumulator (ac) that Seek/PushInterval consume.
    bbq::cek::StaticKont* interval_entry(BBQ::Interval* iv, ::bbq::rho_t r,
                                         bbq::cek::StaticKont* body) {
        if (auto* se = dynamic_cast<BBQ::StartEnd*>(iv)) {
            // Seek(start) -> PushInterval(abs end) -> body. Each kont carries its
            // offset expression and triggers it (gamma is a placeholder — the apply
            // consumer is pushed below the expr, so the expr's own continuation is
            // never taken).
            auto* end_e = compile_expr(se->end, r, ::bbq::ac(), ::bbq::jump(body), body);
            auto* push = make_push_interval(false, end_e, body);
            auto* start_e = compile_expr(se->start, r, ::bbq::ac(), ::bbq::jump(push), push);
            return make_seek(start_e, push);
        }
        if (auto* len = dynamic_cast<BBQ::Length*>(iv)) {
            auto* len_e = compile_expr(len->length, r, ::bbq::ac(), ::bbq::jump(body), body);
            return make_push_interval(true, len_e, body);
        }
        return body;
    }

    BBQ::Interval* interval_of(BBQ::TypeExpr* node) {
        if (auto* p  = dynamic_cast<BBQ::Primitive*>(node))
            return p->interval.has_value() ? p->interval.value() : nullptr;
        if (auto* rr = dynamic_cast<BBQ::RuleRef*>(node))
            return rr->interval.has_value() ? rr->interval.value() : nullptr;
        if (auto* a  = dynamic_cast<BBQ::Array*>(node))
            return a->interval.has_value() ? a->interval.value() : nullptr;
        if (auto* e  = dynamic_cast<BBQ::Extern*>(node))
            return e->interval.has_value() ? e->interval.value() : nullptr;
        return nullptr;
    }
    bbq::cek::StaticKont* make_eval_constraint(bbq::cek::StaticKont* e,
                                               bbq::cek::StaticKont* on_false,
                                               bbq::cek::StaticKont* nx) {
        auto* k = arena_->alloc<bbq::cek::EvalConstraintNode>();
        k->constraint_expr = e; k->on_false = on_false; k->next = nx;
        return k;
    }
    bbq::cek::StaticKont* make_bind_compute(bbq::cek::StaticKont* e, bbq::cek::StaticKont* nx) {
        auto* k = arena_->alloc<bbq::cek::BindComputeNode>();
        k->compute_expr = e; k->next = nx;
        return k;
    }
    bbq::cek::StaticKont* make_invoke_rule(const std::string& nm,
                                           bbq::cek::StaticKont* caller_fail_target,
