// =============================================================
// PEG Parser Generator — Grammar-of-Grammars (Self-Hosted)
//
// Parses .peg files and builds a Grammar AST.
// This is the self-hosted version — compiled by pegc itself.
//
// Generate with:
//   ./build/pegc pegc/grammar/peg.peg -frames pegc/grammar/frames/ -o pegc/frontend/ -prefix ""
// =============================================================

COMPILER Peg

(. #include <string>
#include <vector>
#include <optional>
#include <cstdlib>
.)

COMMENTS FROM "//" TO "\n"
COMMENTS FROM "/*" TO "*/"

IGNORE '\r' + '\n' + '\t' + ' '

PRODUCTIONS

// ═══════════════════════════════════════════════════════════════
// Top-Level Grammar Structure
// ═══════════════════════════════════════════════════════════════

Peg
    (. std::string name;
       std::string endname;
       std::vector<Header*> headers;
       std::vector<CharsetDef*> charsets;
       std::vector<TokenDef*> tokens;
       std::vector<CommentDef*> comments;
       bool has_ignore = false;
       CharsetExpr* ignore_expr = nullptr;
       std::vector<Production*> productions; .)
    = "COMPILER"
      ident<name>
      { SemAction_<headers> }
      [ "CHARACTERS"
        { CharsetDecl<charsets> }
      ]
      [ "TOKENS"
        { TokenDecl<tokens> }
      ]
      { CommentDecl<comments> }
      [ "IGNORE"
        CharsetExpr_<ignore_expr>
        (. has_ignore = true; .)
      ]
      "PRODUCTIONS"
      { ProductionDecl<productions> }
      "END"
      ident<endname>
      "."
    (. ast = new Grammar(std::move(name), std::move(headers),
           std::move(charsets), std::move(tokens), std::move(comments),
           has_ignore,
           ignore_expr ? std::optional<CharsetExpr*>(ignore_expr) : std::nullopt,
           std::move(productions));
       ast->loc = SourceLoc{nullptr, 1, 1}; .)
.

// ── Semantic action as header code ──────────────────────────

SemAction_ <. std::vector<Header*> &headers .>
    (. std::string code; .)
    = "(." (. if (!scan_to("." ")", code)) return false; .)
    (. auto* h = new Header(TrimSemAction(code));
       h->loc = Loc();
       headers.push_back(h); .)
.

// ═══════════════════════════════════════════════════════════════
// CHARACTERS Section
// ═══════════════════════════════════════════════════════════════

CharsetDecl <. std::vector<CharsetDef*> &defs .>
    (. std::string csname; CharsetExpr* body; .)
    = ident<csname>       (. SourceLoc loc = Loc(); .)
      "="
      CharsetExpr_<body>
      "."
    (. auto* d = new CharsetDef(std::move(csname), body);
       d->loc = loc;
       defs.push_back(d); .)
.

CharsetExpr_ <. CharsetExpr* &result .>
    (. CharsetExpr* rhs; .)
    = CharsetDiff<result>
      { "+"
        CharsetDiff<rhs>
        (. auto* u = new Union(result, rhs); u->loc = result->loc; result = u; .)
      }
.

CharsetDiff <. CharsetExpr* &result .>
    (. CharsetExpr* rhs; .)
    = CharsetPrimary<result>
      { "-"
        CharsetPrimary<rhs>
        (. auto* d = new Diff(result, rhs); d->loc = result->loc; result = d; .)
      }
.

CharsetPrimary <. CharsetExpr* &result .>
    (. char ch1, ch2; std::string csname; .)
    = char_lit<ch1>  (. result = new Single(static_cast<int>(ch1)); result->loc = Loc(); .)
      [ ".."
        char_lit<ch2>  (. result = new Range(static_cast<int>(ch1), static_cast<int>(ch2)); result->loc = Loc(); .)
      ]
    | "ANY"   (. result = new Any(); result->loc = Loc(); .)
    | ident<csname>  (. result = new NameRef(std::move(csname)); result->loc = Loc(); .)
.

// ═══════════════════════════════════════════════════════════════
// TOKENS Section
// ═══════════════════════════════════════════════════════════════

TokenDecl <. std::vector<TokenDef*> &defs .>
    (. std::string tname; TokenExpr* pat; .)
    = ident<tname>        (. SourceLoc loc = Loc(); .)
      "="
      TokenExpr_<pat>
      "."
    (. auto* d = new TokenDef(std::move(tname), pat);
       d->loc = loc;
       defs.push_back(d); .)
.

TokenExpr_ <. TokenExpr* &result .>
    (. TokenExpr* alt;
       std::vector<TokenExpr*> alts; .)
    = TokenSeq<result>    (. alts.push_back(result); .)
      { "|"
        TokenSeq<alt>     (. alts.push_back(alt); .)
      }
    (. if (alts.size() > 1) {
           auto loc = result->loc;
           result = new TAlternation(std::move(alts));
           result->loc = loc;
       } .)
.

TokenSeq <. TokenExpr* &result .>
    (. TokenExpr* elem;
       std::vector<TokenExpr*> elems; .)
    = TokenFactor<elem>   (. elems.push_back(elem); .)
      { TokenFactor<elem>  (. elems.push_back(elem); .)
      }
    (. if (elems.size() == 1)
           result = elems[0];
       else {
           auto loc = elems[0]->loc;
           result = new TSequence(std::move(elems));
           result->loc = loc;
       } .)
.

TokenFactor <. TokenExpr* &result .>
    (. TokenExpr* inner; .)
    = TokenAtom<result>
    | "{"
      TokenExpr_<inner>
      "}"
      (. result = new TStar(inner); result->loc = inner->loc; .)
    | "["
      TokenExpr_<inner>
      "]"
      (. result = new TOptional(inner); result->loc = inner->loc; .)
.

TokenAtom <. TokenExpr* &result .>
    (. std::string s; char ch1, ch2; TokenExpr* inner; .)
    = string_lit<s>     (. result = new TLiteral(std::move(s)); result->loc = Loc(); .)
    | char_lit<ch1>     (. result = new TLiteral(std::string(1, ch1));
                           result->loc = Loc(); .)
      [ ".."
        char_lit<ch2>   (. result = new TRange(static_cast<int>(ch1), static_cast<int>(ch2)); result->loc = Loc(); .)
      ]
    | ident<s>          (. result = new TCharset(std::move(s)); result->loc = Loc(); .)
    | "(" TokenExpr_<inner> ")"   (. result = inner; .)
.

// ═══════════════════════════════════════════════════════════════
// COMMENTS Section
// ═══════════════════════════════════════════════════════════════

CommentDecl <. std::vector<CommentDef*> &defs .>
    (. bool nested = false; std::string open; std::string close_str; std::string tname; .)
    = "COMMENTS"
      "FROM"
      string_lit<open>    (. SourceLoc loc = Loc(); .)
      "TO"
      ( string_lit<close_str>
      | ident<tname>      (. close_str = std::move(tname); .)
      )
      [ "NESTED"          (. nested = true; .) ]
    (. auto* c = new CommentDef(std::move(open), std::move(close_str), nested);
       c->loc = loc;
       defs.push_back(c); .)
.

// ═══════════════════════════════════════════════════════════════
// PRODUCTIONS Section
// ═══════════════════════════════════════════════════════════════

ProductionDecl <. std::vector<Production*> &prods .>
    (. std::string pname;
       std::vector<Param*> params;
       std::string locals;
       std::string raw;
       bool has_locals = false;
       PegExpr* body; .)
    = ident<pname>        (. SourceLoc loc = Loc(); .)
      [ "<." (. if (!scan_to("." ">", raw)) return false; .)
             (. ParseParams(raw, params); .)
      ]
      [ "(." (. if (!scan_to("." ")", locals)) return false; .)
             (. locals = TrimSemAction(locals); has_locals = true; .)
      ]
      "="
      PegBody<body>
      "."
    (. auto* p = new Production(std::move(pname), std::move(params),
           has_locals ? std::optional<std::string>(std::move(locals)) : std::nullopt,
           body);
       p->loc = loc;
       prods.push_back(p); .)
.

// ═══════════════════════════════════════════════════════════════
// PEG Expression Grammar
// ═══════════════════════════════════════════════════════════════

PegBody <. PegExpr* &result .>
    (. PegExpr* alt;
       std::vector<PegExpr*> alts; .)
    = PegSeq<result>      (. alts.push_back(result); .)
      { "|"
        PegSeq<alt>       (. alts.push_back(alt); .)
      }
    (. if (alts.size() > 1) {
           auto loc = result->loc;
           result = new Choice(std::move(alts));
           result->loc = loc;
       } .)
.

PegSeq <. PegExpr* &result .>
    (. PegExpr* elem;
       std::vector<PegExpr*> elems; .)
    = PegFactor<elem>     (. elems.push_back(elem); .)
      { PegFactor<elem>   (. elems.push_back(elem); .)
      }
    (. if (elems.size() == 1)
           result = elems[0];
       else {
           auto loc = elems[0]->loc;
           result = new Sequence(std::move(elems));
           result->loc = loc;
       } .)
.

PegFactor <. PegExpr* &result .>
    (. std::string code; PegExpr* inner; .)
    = "&"
      PegAtom<inner>
      (. result = new And(inner);
         result->loc = inner->loc; .)
    | "!"
      PegAtom<inner>
      (. result = new Not(inner);
         result->loc = inner->loc; .)
    | PegAtom<result>
    | "(." (. if (!scan_to("." ")", code)) return false; .)
      (. result = new Action(TrimSemAction(code));
         result->loc = Loc(); .)
    | "IF" "(" "(." (. if (!scan_to("." ")", code)) return false; .)
      ")"
      PegAtom<inner>
      (. result = new Resolver(TrimSemAction(code), inner);
         result->loc = inner->loc; .)
.

PegAtom <. PegExpr* &result .>
    (. PegExpr* inner; std::string s; char ch; .)
    = string_lit<s>
      (. result = new Literal(std::move(s));
         result->loc = Loc(); .)
    | char_lit<ch>
      (. result = new Literal(std::string(1, ch));
         result->loc = Loc(); .)
    | "ANY"
      (. result = new AnyExpr();
         result->loc = Loc(); .)
    | ident<s>
      (. std::string rname = std::move(s); SourceLoc loc = Loc();
         std::string args; .)
      [ "<."
        (. if (!scan_to("." ">", args)) return false;
           size_t b = args.find_first_not_of(" \t\r\n");
           size_t e = args.find_last_not_of(" \t\r\n");
           args = (b == std::string::npos) ? "" : args.substr(b, e - b + 1); .)
      | "<"
        (. if (!scan_to(">", args)) return false;
           size_t b = args.find_first_not_of(" \t\r\n");
           size_t e = args.find_last_not_of(" \t\r\n");
           args = (b == std::string::npos) ? "" : args.substr(b, e - b + 1); .)
      ]
      (. result = new RuleCall(std::move(rname), std::move(args));
         result->loc = loc; .)
    | "("
      PegBody<inner>
      ")"
      (. result = new Group(inner);
         result->loc = inner->loc; .)
    | "["
      PegBody<inner>
      "]"
      (. result = new Optional(inner);
         result->loc = inner->loc; .)
    | "{"
      PegBody<inner>
      (. bool is_plus = false; .)
      "}"
      [ "+"
        (. is_plus = true; .)
      ]
      (. if (is_plus) {
             result = new Plus(inner);
         } else {
             result = new Star(inner);
         }
         result->loc = inner->loc; .)
.

END Peg.
