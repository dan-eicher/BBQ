// =============================================================
// ParserKont — Continuation-graph IR for pegc parser codegen
//
// DDCG decomposition the BBQ tool family is meant to converge on:
//
//   .peg file        ── pegc parser            ──>  PegExpr AST
//   PegExpr AST      ── ddcgc(pegc.ddcg)       ──>  ParserKont graph
//   ParserKont graph ── burgc(pegc-{cpp,c}.burg)──>  C/C++ parser source
//
// Each KontNode kind below corresponds to a `cg_*` free function in
// pegc/runtime/{cpp,c}_emit.{h,cpp}. Phase 5/6 will replace the
// hand-written switch dispatch in {C,}ParserEmitter with ddcgc-
// generated code that builds this graph, plus burgc-generated
// lowerings that walk the graph and call the cg_* functions.
//
// ── PegExpr (source AST) -> KontNode (this IR) mapping ──
//
//   Sequence(elements)         ─>  KSeq(elems)
//   Choice(alternatives)       ─>  KChoice(alts)
//   Star(body)                 ─>  KStar(body)
//   Plus(body)                 ─>  KPlus(body)
//   Optional(body)             ─>  KOptional(body)
//   And(body)                  ─>  KAnd(body)            // &e, zero-width assertion
//   Not(body)                  ─>  KNot(body)            // !e, negative lookahead
//   Literal(value)             ─>  KMatchString(value)
//   AnyExpr                    ─>  KMatchAny
//   CharRange(from, to)        ─>  KMatchCharRange(from, to)
//   CharsetRef(name)           ─>  KMatchCharset(name)
//   RuleCall(name)    [charset]─>  KMatchCharset(name)   // frontend resolves name kind
//   RuleCall(name,args)[token] ─>  KCallToken(name, args)
//   RuleCall(name,args)[prod]  ─>  KCallProduction(name, args)
//   RuleCall(name,args)[extern]─>  KCallExtern(name, args)
//   Action(code)               ─>  KAction(code)
//   Resolver(cond, body)       ─>  KResolver(cond, body)
//   Group(body)                ─>  recurse on body (no KGroup node — transparent)
//
// ── Optimization opportunities ──
//
// These lower as cost-1 BURG alternatives in pegc-{cpp,c}.burg, NOT as
// new IR shapes. The kont graph stays naive; burgc's pattern matcher
// recognises shapes that have a tighter codegen than the general rule:
//
//   - Head-fail dispatch:
//       KChoice(alts) where each alt's first element is a distinct
//       literal (and we're not in lex mode where keyword-shape literals
//       would need boundary checks). Lowers to peek_at chains.
//
//   - Span loop:
//       KStar(KMatchCharset(_)) lowers to a tight while-loop instead
//       of the general save/match/restore pattern.
//
//   - Tail call:
//       KCallProduction in tail position skips the call/return overhead.
//
// ── ddcgc consumes this schema ──
//
// ParserKont.asdl is consumed by asdl in two ways:
//   1. as a C++ struct generator → pegc/runtime/ParserKont.h
//   2. as a JSON schema source for ddcgc + burgc type-checking
//      → pegc/grammar/ParserKont.json
//
// Both outputs are auto-regenerated by CMake whenever this file (or
// the asdl tool itself) changes. See pegc/CMakeLists.txt.
// =============================================================

module ParserKont {

    // The primary AST sum. Each kind maps to one cg_* free function in
    // pegc/runtime/{cpp,c}_emit.{h,cpp}; see the mapping table above.
    kont = KSeq(kont* elems)
         | KChoice(kont* alts)
         | KStar(kont body)
         | KPlus(kont body)
         | KOptional(kont body)
         | KAnd(kont body)
         | KNot(kont body)
         | KMatchString(string value)
         | KMatchAny
         | KMatchCharRange(int from, int to)
         | KMatchCharset(identifier name)
         | KCallProduction(identifier name, string args)
         | KCallToken(identifier name, string args)
         | KCallExtern(identifier name, string args)
         | KAction(string code)
         | KResolver(string cond, kont body)
}
