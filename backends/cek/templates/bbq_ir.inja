        if (kind == PrimKind::Float) {
            return (width == PrimWidth::W64) ? 8 : 4;
        }
        switch (width) {
            case PrimWidth::W8:  return 1;
            case PrimWidth::W16: return 2;
            case PrimWidth::W32: return 4;
            case PrimWidth::W64: return 8;
        }
        return 0;
    }
};

