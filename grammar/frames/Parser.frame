    PrimitiveKind* DecodePrimitive(const std::string &s, SourceLoc loc) {
        if (s == "bool")   { auto* n = new BoolKind();   n->loc = loc; return n; }
        if (s == "bytes")  { auto* n = new BytesKind();  n->loc = loc; return n; }
        if (s == "string") { auto* n = new StringKind(); n->loc = loc; return n; }

        // Float types
        if (s.substr(0, 5) == "float") {
            Width w = (s.find("64") != std::string::npos) ? Width::W64 : Width::W32;
            Endianness e = Endianness::Default;
            if (s.size() > 7) {
                std::string suf = s.substr(s.size() - 2);
                if (suf == "le") e = Endianness::Little;
                else if (suf == "be") e = Endianness::Big;
            }
            auto* n = new FloatKind(w, e); n->loc = loc; return n;
        }

        // Integer types (uint* / int*)
        if (s.substr(0, 4) == "uint" || s.substr(0, 3) == "int") {
            Signedness sign = Signedness::Signed;
            std::string rest = s;
            if (s.substr(0, 4) == "uint") { sign = Signedness::Unsigned; rest = s.substr(4); }
            else if (s.substr(0, 3) == "int") { rest = s.substr(3); }

            Width w = Width::W8;
            if (rest.find("64") != std::string::npos) w = Width::W64;
            else if (rest.find("32") != std::string::npos) w = Width::W32;
            else if (rest.find("16") != std::string::npos) w = Width::W16;

            Endianness e = Endianness::Default;
            if (s.size() > 5) {
                std::string suf = s.substr(s.size() - 2);
                if (suf == "le") e = Endianness::Little;
                else if (suf == "be") e = Endianness::Big;
            }

            auto* n = new IntegerKind(w, sign, e); n->loc = loc; return n;
        }

        return nullptr;
    }

