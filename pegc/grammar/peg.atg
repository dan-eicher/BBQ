// =============================================================
// PEG Parser Generator — Grammar-of-Grammars (Bootstrap)
//
// Parses .peg files (Coco/R-compatible EBNF with PEG semantics)
// and builds a Grammar AST.
//
// Bootstrap: compiled with Coco/R into Scanner.h/.cpp + Parser.h/.cpp
// Self-host: later replaced by pegc-generated parser from peg.peg
//
// Generate with:
//   ../../CocoR-CPP/coco peg.atg -frames ../../CocoR-CPP/src/ -o ../frontend/
// =============================================================

#include <string>
#include <vector>
#include <optional>
#include <cstdlib>
#include <codecvt>
#include <locale>

#include "GrammarAST.h"

using namespace PegGrammar;

COMPILER Peg

	// ── Result ──────────────────────────────────────────────
	Grammar* ast = nullptr;

	// ── Token conversion helpers ────────────────────────────
	std::wstring_convert<std::codecvt_utf8<wchar_t>> converter;

	std::string Str() {
		return converter.to_bytes(t->val);
	}

	std::string Str(Token *tok) {
		return converter.to_bytes(tok->val);
	}

	std::string UnquoteStr() {
		std::string s = Str();
		if (s.size() >= 2 && s.front() == '"' && s.back() == '"')
			s = s.substr(1, s.size() - 2);
		// Decode escape sequences
		std::string out;
		for (size_t i = 0; i < s.size(); i++) {
			if (s[i] == '\\' && i + 1 < s.size()) {
				switch (s[i+1]) {
					case 'n': out += '\n'; i++; break;
					case 'r': out += '\r'; i++; break;
					case 't': out += '\t'; i++; break;
					case '\\': out += '\\'; i++; break;
					case '"': out += '"'; i++; break;
					case '0': out += '\0'; i++; break;
					default: out += s[i]; break;
				}
			} else {
				out += s[i];
			}
		}
		return out;
	}

	std::string UnquoteChr() {
		std::string s = Str();
		if (s.size() >= 2 && s.front() == '\'' && s.back() == '\'')
			return s.substr(1, s.size() - 2);
		return s;
	}

	// Decode character literal: 'a', '\n', '\x41'
	int DecodeChar(const std::string &s) {
		if (s.empty()) return 0;
		if (s[0] != '\\') return static_cast<unsigned char>(s[0]);
		if (s.size() < 2) return 0;
		switch (s[1]) {
			case 'n': return '\n';
			case 'r': return '\r';
			case 't': return '\t';
			case '\\': return '\\';
			case '\'': return '\'';
			case '"': return '"';
			case '0': return '\0';
			case 'x': case 'X':
				if (s.size() >= 4)
					return static_cast<int>(std::strtol(s.c_str() + 2, nullptr, 16));
				return 0;
			default: return static_cast<unsigned char>(s[1]);
		}
	}

	// ── Source location helper ──────────────────────────────
	SourceLoc Loc() {
		return SourceLoc{nullptr, t->line, t->col};
	}

	// ── Strip (. .) delimiters from semaction token ─────────
	std::string StripSemAction() {
		std::string s = Str();
		if (s.size() >= 4 && s[0] == '(' && s[1] == '.' &&
		    s[s.size()-2] == '.' && s[s.size()-1] == ')') {
			s = s.substr(2, s.size() - 4);
		}
		// Trim leading/trailing whitespace
		size_t start = s.find_first_not_of(" \t\r\n");
		size_t end = s.find_last_not_of(" \t\r\n");
		if (start == std::string::npos) return "";
		return s.substr(start, end - start + 1);
	}

	// ── Strip <. .> delimiters from paramblock token ────────
	std::string StripParamBlock() {
		std::string s = Str();
		if (s.size() >= 4 && s[0] == '<' && s[1] == '.' &&
		    s[s.size()-2] == '.' && s[s.size()-1] == '>') {
			s = s.substr(2, s.size() - 4);
		}
		return s;
	}

	// ── Parse formal parameters from paramblock content ─────
	void ParseParams(const std::string &raw, std::vector<Param*> &params) {
		// Split by commas, respecting <> nesting for templates
		std::vector<std::string> parts;
		int depth = 0;
		size_t start = 0;
		for (size_t i = 0; i < raw.size(); i++) {
			if (raw[i] == '<') depth++;
			else if (raw[i] == '>') depth--;
			else if (raw[i] == ',' && depth == 0) {
				parts.push_back(raw.substr(start, i - start));
				start = i + 1;
			}
		}
		parts.push_back(raw.substr(start));

		for (auto &part : parts) {
			// Trim
			size_t ps = part.find_first_not_of(" \t\r\n");
			size_t pe = part.find_last_not_of(" \t\r\n");
			if (ps == std::string::npos) continue;
			std::string trimmed = part.substr(ps, pe - ps + 1);
			if (trimmed.empty()) continue;

			// Find last identifier (the param name)
			size_t name_end = trimmed.size();
			while (name_end > 0 && (std::isalnum(trimmed[name_end-1]) || trimmed[name_end-1] == '_'))
				name_end--;
			std::string name = trimmed.substr(name_end);
			if (name.empty()) continue;

			// Check for & before name
			bool is_ref = false;
			size_t type_end = name_end;
			while (type_end > 0 && trimmed[type_end-1] == ' ') type_end--;
			if (type_end > 0 && trimmed[type_end-1] == '&') {
				is_ref = true;
				type_end--;
			}
			while (type_end > 0 && trimmed[type_end-1] == ' ') type_end--;

			std::string type_code = trimmed.substr(0, type_end);
			auto* p = new Param(std::move(type_code), std::move(name), is_ref);
			p->loc = Loc();
			params.push_back(p);
		}
	}


CHARACTERS
	letter   = 'a'..'z' + 'A'..'Z' + '_'.
	digit    = '0'..'9'.
	hexdigit = digit + 'a'..'f' + 'A'..'F'.
	strchar  = ANY - '"' - '\r' - '\n'.
	chrchar  = ANY - '\'' - '\r' - '\n'.
	nodot    = ANY - '.'.
	norpar   = ANY - ')'.
	nogt     = ANY - '>'.
	cr       = '\r'.
	lf       = '\n'.
	tab      = '\t'.

TOKENS
	ident     = letter { letter | digit }.

	intlit    = '0' ( 'x' | 'X' ) hexdigit { hexdigit }
	          | digit { digit }.

	stringlit = '"' { strchar } '"'.
	charlit   = '\'' { chrchar } '\''.

	// Semantic action block: (. ... .)
	// Captured as a single token; content extracted by StripSemAction()
	semaction = "(." { nodot | '.' norpar } ".)".

	// Formal parameter block: <. ... .>
	// Captured as a single token; parsed by ParseParams()
	paramblock = "<." { nodot | '.' nogt } ".>".


COMMENTS FROM "//" TO lf
COMMENTS FROM "/*" TO "*/"

IGNORE cr + lf + tab

PRODUCTIONS

// ═══════════════════════════════════════════════════════════════
// Top-Level Grammar Structure
// ═══════════════════════════════════════════════════════════════

Peg
	(. std::string name;
	   std::vector<Header*> headers;
	   std::vector<CharsetDef*> charsets;
	   std::vector<TokenDef*> tokens;
	   std::vector<CommentDef*> comments;
	   bool has_ignore = false;
	   CharsetExpr* ignore_expr = nullptr;
	   std::vector<Production*> productions; .)
	= "COMPILER"
	  ident                (. name = Str(); .)
	  { SemAction_<headers> }
	  [ "CHARACTERS"
	    { CharsetDecl<charsets> }
	  ]
	  [ "TOKENS"
	    { TokenDecl<tokens> }
	  ]
	  { CommentDecl<comments> }
	  [ "IGNORE"
	    CharsetExpr_<ignore_expr>
	    (. has_ignore = true; .)
	  ]
	  "PRODUCTIONS"
	  { ProductionDecl<productions> }
	  "END"
	  ident
	  "."
	(. ast = new Grammar(std::move(name), std::move(headers),
	       std::move(charsets), std::move(tokens), std::move(comments),
	       has_ignore,
	       ignore_expr ? std::optional<CharsetExpr*>(ignore_expr) : std::nullopt,
	       std::move(productions));
	   ast->loc = SourceLoc{nullptr, 1, 1}; .)
.

// ── Semantic action as header code ──────────────────────────

SemAction_ <. std::vector<Header*> &headers .>
	= semaction
	(. auto* h = new Header(StripSemAction());
	   h->loc = Loc();
	   headers.push_back(h); .)
.

// ═══════════════════════════════════════════════════════════════
// CHARACTERS Section
// ═══════════════════════════════════════════════════════════════

CharsetDecl <. std::vector<CharsetDef*> &defs .>
	(. std::string name; CharsetExpr* body; .)
	= ident           (. name = Str(); SourceLoc loc = Loc(); .)
	  "="
	  CharsetExpr_<body>
	  "."
	(. auto* d = new CharsetDef(std::move(name), body);
	   d->loc = loc;
	   defs.push_back(d); .)
.

CharsetExpr_ <. CharsetExpr* &result .>
	(. CharsetExpr* rhs; .)
	= CharsetDiff<result>
	  { "+"
	    CharsetDiff<rhs>
	    (. auto* u = new Union(result, rhs); u->loc = result->loc; result = u; .)
	  }
.

CharsetDiff <. CharsetExpr* &result .>
	(. CharsetExpr* rhs; .)
	= CharsetPrimary<result>
	  { "-"
	    CharsetPrimary<rhs>
	    (. auto* d = new Diff(result, rhs); d->loc = result->loc; result = d; .)
	  }
.

CharsetPrimary <. CharsetExpr* &result .>
	(. int ch1, ch2; std::string s; .)
	= charlit       (. s = UnquoteChr(); ch1 = DecodeChar(s);
	                   result = new Single(ch1); result->loc = Loc(); .)
	  [ ".."
	    charlit     (. s = UnquoteChr(); ch2 = DecodeChar(s);
	                   result = new Range(ch1, ch2); result->loc = Loc(); .)
	  ]
	| "ANY"         (. result = new Any(); result->loc = Loc(); .)
	| ident         (. result = new NameRef(Str()); result->loc = Loc(); .)
.

// ═══════════════════════════════════════════════════════════════
// TOKENS Section
// ═══════════════════════════════════════════════════════════════

TokenDecl <. std::vector<TokenDef*> &defs .>
	(. std::string name; TokenExpr* pat; .)
	= ident            (. name = Str(); SourceLoc loc = Loc(); .)
	  "="
	  TokenExpr_<pat>
	  "."
	(. auto* d = new TokenDef(std::move(name), pat);
	   d->loc = loc;
	   defs.push_back(d); .)
.

TokenExpr_ <. TokenExpr* &result .>
	(. TokenExpr* alt;
	   std::vector<TokenExpr*> alts; .)
	= TokenSeq<result>    (. alts.push_back(result); .)
	  { "|"
	    TokenSeq<alt>     (. alts.push_back(alt); .)
	  }
	(. if (alts.size() > 1) {
	       auto loc = result->loc;
	       result = new TAlternation(std::move(alts));
	       result->loc = loc;
	   } .)
.

TokenSeq <. TokenExpr* &result .>
	(. TokenExpr* elem;
	   std::vector<TokenExpr*> elems; .)
	= TokenFactor<elem>   (. elems.push_back(elem); .)
	  { TokenFactor<elem>  (. elems.push_back(elem); .)
	  }
	(. if (elems.size() == 1)
	       result = elems[0];
	   else {
	       auto loc = elems[0]->loc;
	       result = new TSequence(std::move(elems));
	       result->loc = loc;
	   } .)
.

TokenFactor <. TokenExpr* &result .>
	(. TokenExpr* inner; .)
	= TokenAtom<result>
	| "{"
	  TokenExpr_<inner>
	  "}"
	  (. result = new TStar(inner); result->loc = inner->loc; .)
	| "["
	  TokenExpr_<inner>
	  "]"
	  (. result = new TOptional(inner); result->loc = inner->loc; .)
.

TokenAtom <. TokenExpr* &result .>
	(. std::string s; int ch1, ch2; TokenExpr* inner; .)
	= stringlit     (. result = new TLiteral(UnquoteStr()); result->loc = Loc(); .)
	| charlit       (. s = UnquoteChr(); ch1 = DecodeChar(s);
	                   result = new TLiteral(std::string(1, static_cast<char>(ch1)));
	                   result->loc = Loc(); .)
	  [ ".."
	    charlit     (. s = UnquoteChr(); ch2 = DecodeChar(s);
	                   result = new TRange(ch1, ch2); result->loc = Loc(); .)
	  ]
	| ident         (. result = new TCharset(Str()); result->loc = Loc(); .)
	| "(" TokenExpr_<inner> ")"   (. result = inner; .)
.

// ═══════════════════════════════════════════════════════════════
// COMMENTS Section
// ═══════════════════════════════════════════════════════════════

CommentDecl <. std::vector<CommentDef*> &defs .>
	(. bool nested = false; std::string close_str; .)
	= "COMMENTS"
	  "FROM"
	  stringlit   (. std::string open = UnquoteStr(); SourceLoc loc = Loc(); .)
	  "TO"
	  ( stringlit  (. close_str = UnquoteStr(); .)
	  | ident      (. close_str = Str(); .)
	  )
	  [ "NESTED"   (. nested = true; .) ]
	(. auto* c = new CommentDef(std::move(open), std::move(close_str), nested);
	   c->loc = loc;
	   defs.push_back(c); .)
.

// ═══════════════════════════════════════════════════════════════
// PRODUCTIONS Section
// ═══════════════════════════════════════════════════════════════

ProductionDecl <. std::vector<Production*> &prods .>
	(. std::string name;
	   std::vector<Param*> params;
	   std::string locals;
	   bool has_locals = false;
	   PegExpr* body; .)
	= ident              (. name = Str(); SourceLoc loc = Loc(); .)
	  [ paramblock       (. ParseParams(StripParamBlock(), params); .) ]
	  [ semaction         (. locals = StripSemAction(); has_locals = true; .) ]
	  "="
	  PegBody<body>
	  "."
	(. auto* p = new Production(std::move(name), std::move(params),
	       has_locals ? std::optional<std::string>(std::move(locals)) : std::nullopt,
	       body);
	   p->loc = loc;
	   prods.push_back(p); .)
.

// ═══════════════════════════════════════════════════════════════
// PEG Expression Grammar
// ═══════════════════════════════════════════════════════════════

PegBody <. PegExpr* &result .>
	(. PegExpr* alt;
	   std::vector<PegExpr*> alts; .)
	= PegSeq<result>      (. alts.push_back(result); .)
	  { "|"
	    PegSeq<alt>       (. alts.push_back(alt); .)
	  }
	(. if (alts.size() > 1) {
	       auto loc = result->loc;
	       result = new Choice(std::move(alts));
	       result->loc = loc;
	   } .)
.

PegSeq <. PegExpr* &result .>
	(. PegExpr* elem;
	   std::vector<PegExpr*> elems; .)
	= PegFactor<elem>     (. elems.push_back(elem); .)
	  { PegFactor<elem>   (. elems.push_back(elem); .)
	  }
	(. if (elems.size() == 1)
	       result = elems[0];
	   else {
	       auto loc = elems[0]->loc;
	       result = new Sequence(std::move(elems));
	       result->loc = loc;
	   } .)
.

PegFactor <. PegExpr* &result .>
	(. std::string code; PegExpr* inner; .)
	= "&"
	  PegAtom<inner>
	  (. result = new And(inner);
	     result->loc = inner->loc; .)
	| "!"
	  PegAtom<inner>
	  (. result = new Not(inner);
	     result->loc = inner->loc; .)
	| PegAtom<result>
	| semaction
	  (. result = new Action(StripSemAction());
	     result->loc = Loc(); .)
	| "IF" "(" semaction ")"
	  PegAtom<inner>
	  (. result = new Resolver(StripSemAction(), inner);
	     result->loc = inner->loc; .)
.

PegAtom <. PegExpr* &result .>
	(. PegExpr* inner; .)
	= stringlit
	  (. result = new Literal(UnquoteStr());
	     result->loc = Loc(); .)
	| charlit
	  (. result = new Literal(UnquoteChr());
	     result->loc = Loc(); .)
	| "ANY"
	  (. result = new AnyExpr();
	     result->loc = Loc(); .)
	| ident
	  (. std::string name = Str(); SourceLoc loc = Loc();
	     std::vector<Arg*> args; .)
	  [ "<"
	    ArgExpr<args>
	    { ","
	      ArgExpr<args>
	    }
	    ">"
	  ]
	  (. result = new RuleCall(std::move(name), std::move(args));
	     result->loc = loc; .)
	| "("
	  PegBody<inner>
	  ")"
	  (. result = new Group(inner);
	     result->loc = inner->loc; .)
	| "["
	  PegBody<inner>
	  "]"
	  (. result = new Optional(inner);
	     result->loc = inner->loc; .)
	| "{"
	  PegBody<inner>
	  (. bool is_plus = false; .)
	  "}"
	  [ "+"
	    (. is_plus = true; .)
	  ]
	  (. if (is_plus) {
	         result = new Plus(inner);
	     } else {
	         result = new Star(inner);
	     }
	     result->loc = inner->loc; .)
.

// ── Actual argument expression ───────────────────────────────
// Collects tokens that form a single argument expression.
// Simple: just identifiers, with optional & prefix.

ArgExpr <. std::vector<Arg*> &args .>
	(. std::string expr; .)
	= [ "&"           (. expr = "&"; .) ]
	  ident            (. expr += Str(); .)
	(. auto* a = new Arg(std::move(expr));
	   a->loc = Loc();
	   args.push_back(a); .)
.

END Peg.
