COMPILER big

(. #include "big_runtime.h" .)

IMPORTS
  ast    = "big_ast.json"
  target = "big_target.json"

DESTINATIONS
  // ρ tracks recursion depth — threaded through every gen() call.
  // big_imports.ddcg supplies delta + gamma; ρ is local to big.ddcg
  // because big_imports.ddcg's funs are pure (don't touch ρ).
  env_dest rho { depth: int }
  ir_root int

// big_imports.ddcg supplies `delta`, `gamma`, and `trace_fire` —
// merged in via the import below. Demonstrates that a library's
// AUXILIARIES + DESTINATIONS reach the importer without redeclaration.
AUXILIARIES
  cg_lit     : (int) -> int
  cg_seq     : (list<int>) -> int
  cg_pick    : (int, int) -> int
  cg_str     : (string) -> int
  cg_split   : (int) -> tuple<int, int>
  place      : (label) -> int
  log_value  : (target.value) -> int
  // Coverage-only auxes (mirror kitchensink.ddcg) — exercise BoolLit,
  // TupleLit constructor, and tuple-typed aux argument.
  bool_demo  : (bool) -> int
  tup_sum    : (tuple<int, int>) -> int

PREDICATES
  is_zero       : (int) -> bool
  is_short_name : (string) -> bool

MEMBERS (.
    using label_t = int;
    SourceLoc current_loc;
    int next_label = 0;
    std::vector<std::string> trace;

    label_t fresh_label() { return next_label++; }
    int place(label_t L) {
        trace.push_back("place:L" + std::to_string(L));
        return 0;
    }

    int trace_fire(const std::string& name) {
        trace.push_back("rule:" + name);
        return 0;
    }
    int cg_lit(int n) {
        trace.push_back("cg_lit:" + std::to_string(n));
        return n;
    }
    int cg_seq(std::vector<int> xs) {
        trace.push_back("cg_seq:" + std::to_string(xs.size()));
        int s = 0; for (int x : xs) s += x; return s;
    }
    int cg_pick(int a, int b) {
        trace.push_back("cg_pick");
        return a + b;
    }
    int cg_str(std::string s) {
        trace.push_back("cg_str:" + s);
        return static_cast<int>(s.size());
    }
    std::tuple<int, int> cg_split(int x) {
        trace.push_back("cg_split:" + std::to_string(x));
        return {x / 2, x - x / 2};
    }

    bool is_zero(int n)              { return n == 0; }
    bool is_short_name(std::string s) { return s.size() < 4; }

    int bool_demo(bool b) {
        trace.push_back(std::string("bool_demo:") + (b ? "true" : "false"));
        return b ? 1 : 0;
    }
    int tup_sum(std::tuple<int,int> t) {
        trace.push_back("tup_sum:" + std::to_string(std::get<0>(t)) +
                        ":" + std::to_string(std::get<1>(t)));
        return std::get<0>(t) + std::get<1>(t);
    }

    int log_value(target::Value* v) {
        // 0=Imm, 1=Slot — see target::Value::kind_tag().
        const char* kind = v->kind_tag() == 0 ? "imm" : "slot";
        trace.push_back(std::string("log_value:") + kind +
                        ":" + std::to_string(v->payload()));
        return v->payload();
    }
.)

// Action-language helper: dispatches on δ via `match` and constructs a
// target::Value via `build`. Exercises fun + match + build together.
fun dest_to_value(d : delta) -> target.value {
    match (d) {
        effect      => build target.Imm(0)
      | ac          => build target.Imm(99)
      | spill(slot) => build target.Slot(slot)
    };
}

// `match` over an asdl-enum subject lowers to `switch` on the enum value.
// `_` covers any future variants (and exercises WildcardPat in arm).
fun op_to_int(o : ast.op) -> int {
    match (o) {
        OpAdd => 1
      | OpSub => 2
      | OpMul => 3
      | _     => 0
    };
}

// Exercises BindPat-default-with-subject-bind in a match arm.
fun delta_default(d : delta) -> int {
    match (d) {
        effect => 1
      | _other => 99
    };
}

// One fun per untested DSL form bundled into a single sink — UnaryOp,
// ListLit + IndexAccExpr, WithExpr, FieldAccExpr on a Dest value,
// BoolLit, TupleLit constructor.
fun feature_demo(r : rho, x : int) -> int {
    let neg  = -x;
    let xs   = [x, neg];
    let head = xs[0];
    let r2   = r with depth := 1;
    let _    = bool_demo(true);
    let _    = tup_sum((head, neg));
    cg_pick(head, r2.depth);
}

import "big_imports.ddcg"

RULES

// ── Nested ConstructorPat: zero-left optimisation fires before general Add
rule add_zero_l : ast.Add(left: ast.Lit(n: 0), right: r) {
    trace_fire("add_zero_l");
    cg_pick(0, gen(r, rho, ac, fail));
}

// ── Where-guarded specialisation (predicate over int)
rule lit_zero : ast.Lit(n: x) where is_zero(x) {
    trace_fire("lit_zero");
    cg_lit(0);
}

// ── Tuple-destructuring let + ternary + tuple-returning aux.
//    Also fires `feature_demo` and `delta_default` to exercise
//    UnaryOp, ListLit, IndexAccExpr, WithExpr, FieldAccExpr, BoolLit,
//    TupleLit, and BindPat-default-with-subject-bind in match arms.
rule lit : ast.Lit(n: x) {
    trace_fire("lit");
    let _ = feature_demo(rho, x);
    let _ = delta_default(spill(7));
    let (lo, hi) = cg_split(x > 100 ? 100 : x);
    cg_pick(lo, hi);
}

// ── General Add (fallback after the nested-pat specialisation)
rule add : ast.Add(left: l, right: r) {
    trace_fire("add");
    cg_pick(gen(l, rho, ac, fail), gen(r, rho, ac, fail));
}

// ── WildcardPat in rule head: first field wildcarded, second
//    constrained to a literal sub-pattern via nested ConstructorPat.
rule pair_x99 : ast.Pair(first: _, second: ast.Lit(n: 99)) {
    trace_fire("pair_x99");
    cg_lit(99);
}

// ── RestFieldPat (`...nums`) on a sequence-typed field.
rule multi : ast.Multi(...nums) {
    trace_fire("multi");
    cg_seq(nums);
}

// ── For-loop accumulator + list concat + Sequence-typed field
//   Also calls a fun imported from `big_imports.ddcg` to validate
//   cross-file fun resolution.
rule seq : ast.Seq(items: es) {
    trace_fire("seq");
    let _ = import_demo(0);
    let acc: list<int> = [];
    for e in es {
        acc := acc + [gen(e, rho, ac, fail)];
    }
    cg_seq(acc);
}

// ── Label statement + label-payload γ variant
//   Also drives the action-language fun (match + build) from this
//   rule's body, side-effecting the trace before the main pair logic.
rule pair : ast.Pair(first: e1, second: e2) {
    trace_fire("pair");
    let _ = log_value(dest_to_value(ac));
    let _ = log_value(dest_to_value(spill(7)));
    label L;
    gen(e1, rho, effect, jump(L));
    place(L);
    cg_pick(gen(e2, rho, effect, fail), 0);
}

// ── StringPat: literal string match in a field
rule tag_x : ast.Tag(name: "x") {
    trace_fire("tag_x");
    cg_str("x-special");
}

// ── String predicate guard
rule tag_short : ast.Tag(name: n) where is_short_name(n) {
    trace_fire("tag_short");
    cg_str(n);
}

rule tag : ast.Tag(name: n) {
    trace_fire("tag");
    cg_str(n);
}

// ── NilPat: optional field with nullptr
rule maybe_none : ast.Maybe(sub: nil) {
    trace_fire("maybe_none");
    cg_lit(-1);
}

rule maybe_some : ast.Maybe(sub: s) {
    trace_fire("maybe_some");
    gen(s, rho, ac, fail);
}

// ── Per-op rules dispatch on the `op` enum constructor as a field-pat
//   constant — bare `OpAdd` (etc.) is the enum value, not a value-bind.
rule binop_add : ast.BinOp(op: OpAdd, left: l, right: r) {
    trace_fire("binop_add");
    cg_pick(gen(l, rho, ac, fail), gen(r, rho, ac, fail));
}

rule binop_sub : ast.BinOp(op: OpSub, left: l, right: r) {
    trace_fire("binop_sub");
    cg_pick(gen(l, rho, ac, fail), gen(r, rho, ac, fail));
}

rule binop_mul : ast.BinOp(op: OpMul, left: l, right: r) {
    trace_fire("binop_mul");
    cg_pick(gen(l, rho, ac, fail), gen(r, rho, ac, fail));
}

// ── Enum-typed field bound by name, then matched on by the op_to_int fun.
rule sel : ast.Sel(which: w) {
    trace_fire("sel");
    cg_lit(op_to_int(w));
}
