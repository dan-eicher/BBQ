// BBQ CEK continuation-graph IR.
//
// Three flat top-level sums under a shared KontNode root that the
// template (bbq_ir.inja) injects:
//
//   static_kont   — variants the compiler emits at compile time.
//                   Live in the grammar arena, immutable across parses.
//                   Spine variants carry `next`; expression variants
//                   hold operand sub-trees by pointer.
//
//   dynamic_kont  — variants the interpreter allocates at runtime.
//                   Live in the per-parse arena, freed at parse end.
//                   Apply / eval-left / check / dispatch / consumer
//                   sequencing frames.
//
//   value         — typed values flowing through ac, env bindings,
//                   and FieldCapture::computed_value. Plain data
//                   records, no virtual methods, no kont relationship.
//
// asdl declares all three as flat top-level sums. The template injects
// the KontNode shared root with private virtual `invoke()` and
// `friend class CEKMachine` so the trampoline is the only legal call
// site for invoke. Value variants get plain tag+payload structs.

module bbq_ir {

    type interned       = "const char*"
    type primitive_info = "PrimitiveInfo"
    type field_capture  = "zcow::node*"
    type value_slot     = "Value**"
    type value_buf      = "Value**"
    // f64 — 64-bit IEEE float. asdl's built-in `float` resolves to C++
    // `float` (32-bit); we want full f64 precision in FloatValue so
    // f32 and f64 BBQ fields both round-trip cleanly.
    type f64            = "double"

    // KontNode is the template-injected shared root over both kont
    // sums. Asdl doesn't know about it (no `kont_node` sum is
    // declared), so we declare it as a type alias resolving to
    // `KontNode*`. Spine `next` fields and operator sub-tree fields
    // use this alias to point at either a static_kont or dynamic_kont
    // variant uniformly.
    type kont_node      = "KontNode*"

    // kont_expr — same C++ type as kont_node (KontNode*), but marks an
    // operand sub-tree (a value the producer tiles: BURG_NODE_CHILD) as
    // distinct from a spine/control successor (BURG_NODE_SUCC). The
    // template reads this to generate the burg accessors; the CEK machine
    // sees only KontNode* and is unaffected.
    type kont_expr      = "KontNode*"

    // kont_ref — also KontNode*, but a CROSS-rule reference (a callee's
    // entry, a caller's failure target) that is neither an operand sub-tree
    // nor a spine successor of THIS rule. The template generates no child()
    // or succ() accessor for it, so burg's tiling and RPO spine-walk never
    // traverse into another rule's graph; the CEK reaches it via invoke.
    type kont_ref       = "KontNode*"

    // ── Enums ────────────────────────────────────────────────

    // EOF_ not EOF — EOF is a <cstdio> macro.
    array_mode = FixedCount | EOF_ | Count | Until


    // ── Sub-products (inline structs nested inside KontNodes) ──

    // Switch case: typed match value (Int or String) + branch target + the
    // original case ordinal (shared across range-expanded entries) so the runtime
    // records which arm matched in the capture (read side reads it, not re-derives).
    switch_case   = (value match_value, kont_node target, int ordinal)

    // ── Value sum (typed accumulator + binding + capture values) ──

    value = IntValue(int64 v)
          | FloatValue(f64 v)
          | StringValue(interned v)
          | BoolValue(bool v)
          | FieldCaptureValue(field_capture capture)

    // ── Static konts (compiler-emitted; live in grammar arena) ──

    static_kont
        // Spine / structural — `next` field threads the spine.
        // MatchPrimitive reads `prim` bytes and yields the value to ac (WHAT to
        // read); the concrete store kont that follows does WHERE it goes.
        = MatchPrimitiveNode(primitive_info prim, kont_node next)
        // Concrete destinations (CPS/ANF — each node IS its operation, no tag to
        // branch on). The producer's value in ac is consumed by the store kont
        // that follows it: Capture(name) records it in the output tree (the IPG
        // tree node / Data); StoreEnv(name) binds it in E (the IPG attribute,
        // referenceable by where/compute). The field's NAME picks the combination
        // — a real name gets both; `_` gets StoreEnv only (parse + verify, but
        // never in the output). Placement is the IPG tree/attribute axis, kept
        // orthogonal to δ. Each node's inverse is the writer (read tree / read E).
        | CaptureKont(interned name, kont_node next)
        | StoreEnvKont(interned name, kont_node next)
        | BeginStructNode(interned struct_name, kont_node next)
        // A union/alternatives arm scope: like BeginStruct (a named capture
        // scope, paired with EndStruct), but additionally carries the variant
        // ordinal so the tagged-union backends emit `tag = variant_tag` and
        // place the arm's captures under `u.<variant_name>`. The capture-tree
        // backends (CEK/Python) treat it as begin_struct(variant_name) and
        // ignore variant_tag (the tag is a C-layout concern).
        | BeginVariantNode(interned variant_name, int variant_tag, kont_node next)
        | EndStructNode(kont_node next)
        // Interval region konts. Each carries the offset expression it evaluates;
        // invoke pushes [apply-consumer, expr] (the MatchBytes discipline), the expr
        // delivers to ac, then the consumer reads it. SeekKont sets pos (an
        // @[start,end] seek); PushInterval sets the end bound (absolute, or pos+len
        // when relative for @[length]); PopInterval unwinds it. Reads inside the
        // region bounds-check against effective_end().
        | SeekKont(kont_expr expr, kont_node next)
        | PushIntervalNode(bool relative, kont_expr expr, kont_node next)
        | PopIntervalNode(bool checked, kont_node next)
        | EvalConstraintNode(kont_expr constraint_expr, kont_node on_false, kont_node next)
        | BindComputeNode(kont_expr compute_expr, kont_node next)
        // caller_fail_target — the caller's static failure
        // destination, captured at emit time via
        // find_backtrack_target(rho) and copied into ReturnFrame at
        // runtime so AbortRuleKont can reach it. Null when the call
        // sits at the rule's top level with no enclosing backtrack
        // scope.
        | InvokeRuleNode(interned rule_name, kont_ref entry, kont_ref caller_fail_target, kont_node next)
        | ReturnRuleNode(kont_node next)
        // Failure-handler link. compile_alternatives / compile_optional
        // build a chain at compile time; BeginChoice / BeginOptional
        // sets Savepoint.on_fail_target to the chain head, and each
        // arm's compile-time ρ carries the same link as in_alt's
        // next_arm so where-checks can dispatch via on_false directly.
        // On invoke: restore from the topmost Savepoint, mutate its
        // on_fail_target to next_on_fail (or pop the Savepoint if
        // pop_frame is set), and jump to target. A null target means
        // "scope exhausted — pop the Savepoint and re-fail outward."
        | OnFailKont(kont_node target, kont_node next_on_fail, bool pop_frame)
        // Cross-rule failure handler. Used as the on_false target
        // (and as a stand-in for find_backtrack_target's null result)
        // when a where-check at a rule's top level has no in-rule
        // backtrack frame. Walks ReturnFrames to the nearest
        // rule_fail_target and dispatches there; the caller's chain
        // takes over.
        | AbortRuleKont
        // BeginChoice / BeginOptional push a Savepoint with
        // on_fail_target set to the chain head; arm sequencing is
        // entirely encoded in the static OnFailKont chain.
        | BeginChoiceNode(kont_node on_fail_target, kont_node next)
        | CommitChoiceNode(kont_node next)
        | BeginOptionalNode(kont_node on_fail_target, kont_node inner, kont_node next)
        | EndOptionalNode(kont_node next)
        // resync_target: non-null when the array is in resync mode
        // (BBQ `array<T> ... resync`). BeginArray pushes a Savepoint
        // with on_fail_target = resync_target, ArrayNext refreshes its
        // saved state per iteration, EndArray pops it. Per-element
        // failure routes through ResyncKont (advance pos, retry body).
        | BeginArrayNode(interned array_name, array_mode mode, kont_expr count_expr, kont_ref until_expr, kont_node end_node, kont_node resync_target, kont_node next)
        // count_expr/until_expr are kont_ref: the loop's bound is reconstructed
        // from BeginArray by the codegen, so burg neither tiles nor traverses
        // ArrayNext's operands (until_expr is null in Count mode). The CEK reads
        // the fields directly for its per-iteration check.
        | ArrayNextNode(array_mode mode, kont_ref count_expr, kont_ref until_expr, kont_node end_node, kont_node body_entry, bool resync)
        | EndArrayNode(bool resync, kont_node next)
        | ResyncKont(kont_node body_entry, kont_node end_node)
        | SwitchDispatchNode(kont_expr discriminator_expr, switch_case* cases, kont_node default_target, bool default_reject)
        // A bitfield defunctionalizes into one ExtractBits producer per member
        // (all sharing the container's interval, each with its width + bit offset)
        // followed by one AdvancePos past the container. ExtractBits reads the
        // container bytes in place (does NOT advance pos), shift+masks out its
        // value, and yields it; its inverse is a member-wise insert into the
        // shared container bytes (write-back in place).
        // `is_signed` is the entry's own signedness (BBQ.asdl bitfield_entry): a
        // signed run is read back sign-extended from its width, and the recorded
        // index carries the flag so nothing downstream has to ask the grammar.
        | ExtractBitsNode(primitive_info container, int width_bits, int offset_before, bool is_signed, kont_node next)
        | AdvancePosNode(int by, kont_node next)
        | SetEndianNode(kont_expr endian_expr, kont_node next)
        | ExternalCallNode(interned func_name, interned write_func, kont_node next)
        | MatchBytesNode(kont_expr length_expr, bool is_string, kont_node next)
        | HaltNode

        // Expression leaves — write a Value to ac, push nothing.
        | IntLitKont(int64 v)
        | BoolLitKont(bool v)
        | FloatLitKont(float v)
        | StrLitKont(interned v)
        // Sema's cross-rule resolution rides along for the static emitter (scope
        // cast): resolved_parent/path/depth name the enclosing rule + field path
        // a cross-rule reference resolves to. Null/0 for a same-scope ref. The
        // CEK resolves by name through E and ignores these.
        | RefKont(interned name, interned resolved_path, interned resolved_parent, int resolved_depth)
        | PosKont
        | RemainingKont
        | EOIKont
        | LoopVarKont
        | BufferKont
        | StartKont
        | EndKont

        // Unary operators — operand sub-tree.
        | NegKont(kont_expr operand)
        | BitNotKont(kont_expr operand)
        | NotKont(kont_expr operand)

        // Binary arithmetic operators — left and right sub-trees.
        | AddKont(kont_expr left, kont_expr right)
        | SubKont(kont_expr left, kont_expr right)
        | MulKont(kont_expr left, kont_expr right)
        | DivKont(kont_expr left, kont_expr right)
        | ModKont(kont_expr left, kont_expr right)

        // Binary bitwise operators.
        | BitAndKont(kont_expr left, kont_expr right)
        | BitOrKont(kont_expr left, kont_expr right)
        | BitXorKont(kont_expr left, kont_expr right)
        | ShlKont(kont_expr left, kont_expr right)
        | ShrKont(kont_expr left, kont_expr right)

        // Binary comparison operators.
        | EqKont(kont_expr left, kont_expr right)
        | NeKont(kont_expr left, kont_expr right)
        | LtKont(kont_expr left, kont_expr right)
        | LeKont(kont_expr left, kont_expr right)
        | GtKont(kont_expr left, kont_expr right)
        | GeKont(kont_expr left, kont_expr right)

        // Logical short-circuit operators.
        | LogicalAndKont(kont_expr left, kont_expr right)
        | LogicalOrKont(kont_expr left, kont_expr right)

        // Ternary.
        | TernaryKont(kont_expr cond, kont_expr then_, kont_expr else_)

        // Function call.
        | CallKont(interned func_name, kont_expr* args)

        // Path navigation.
        | PathStartKont(interned name)
        | FieldAccessKont(interned field, kont_expr base)
        | IndexAccessKont(kont_expr index_expr, kont_expr base)
        | CaptureValueKont(kont_expr path)

    // ── Dynamic konts (runtime-allocated; live in per-parse arena) ──

    dynamic_kont
        // Apply variants for binary operators — saved_right slot
        // populated by EvalLeftKont before the apply runs.
        = ApplyAddKont(value saved_right)
        | ApplySubKont(value saved_right)
        | ApplyMulKont(value saved_right)
        | ApplyDivKont(value saved_right)
        | ApplyModKont(value saved_right)
        | ApplyBitAndKont(value saved_right)
        | ApplyBitOrKont(value saved_right)
        | ApplyBitXorKont(value saved_right)
        | ApplyShlKont(value saved_right)
        | ApplyShrKont(value saved_right)
        | ApplyEqKont(value saved_right)
        | ApplyNeKont(value saved_right)
        | ApplyLtKont(value saved_right)
        | ApplyLeKont(value saved_right)
        | ApplyGtKont(value saved_right)
        | ApplyGeKont(value saved_right)

        // Apply variants for unary operators — read ac, write ac.
        | ApplyNegKont
        | ApplyBitNotKont
        | ApplyNotKont

        // Shared eval-left: writes ac into a `Value**` slot on an
        // apply kont, then pushes the left-operand kont onto K.
        | EvalLeftKont(value_slot saved_right_slot, kont_node left_kont)

        // Logical short-circuit: read ac (boolean), decide whether
        // to push the right operand or short-circuit.
        | LogicalAndCheckKont(kont_node right)
        | LogicalOrCheckKont(kont_node right)
        | NormalizeKont

        // Ternary dispatch: read ac (boolean), push the chosen branch.
        | TernaryDispatchKont(kont_node then_, kont_node else_)

        // Function call sequencing: store an arg into a buffer slot,
        // and apply the function once all args have evaluated.
        | ArgStoreKont(value_buf args_buf, int slot)
        | CallApplyKont(interned func_name, value_buf args_buf, int arg_count)

        // Path navigation apply variants.
        | FieldAccessApplyKont(interned field)
        | IndexAccessApplyKont(value saved_index)
        | CaptureValueApplyKont

        // Site consumers — read ac after the site's expression
        // evaluates and act accordingly.
        | EvalConstraintCheckKont(kont_node on_false, kont_node next)
        | SwitchSelectKont(switch_case* cases, kont_node default_target, bool default_reject)
        | BindComputeStoreKont(kont_node next)
        | BeginArrayWithLimitKont(interned array_name, array_mode mode, kont_node end_node, kont_node resync_target, kont_node next)
        | ArrayCountCheckKont(kont_node end_node, kont_node body_entry)
        | ArrayUntilCheckKont(kont_node end_node, kont_node body_entry)
        | MatchBytesApplyKont(bool is_string, kont_node next)
        | SetEndianApplyKont(kont_node next)
        // Interval consumers — read ac (the evaluated offset) after Seek/PushInterval's
        // expression runs. SeekApply sets pos; PushIntervalApply sets the end bound.
        | SeekApplyKont(kont_node next)
        | PushIntervalApplyKont(bool relative, kont_node next)
}
