// opgen.asdl — AST for the opcode specification DSL
//
// Covers the opcodes.def grammar vocabulary consumed by the VM/table emitters.
//
// Generate with:
//   asdl -i opgen.asdl -t templates/c.inja -o opgen_ast.h -l c

module opgen {

    type ident   = "const char*"
    type int32   = "int32_t"
    type int64   = "int64_t"
    type float64 = "double"
    type rawcode = "const char*"    // arena-dup'd raw source span of a
                                    // "(. ... .)" block in opcodes.def

    // Unified type tag for both stack slots and bytecode operands.
    // Context (stack_param vs operand_param) determines which subset
    // is valid; derive.c validates at table-generation time.
    value_type = TyI8  | TyI16 | TyI32
               | TyU8  | TyU16
               | TyRef
               | TyWord | TyDword
               | TyI64 | TyF32 | TyF64    // JVM: long, float, double
               | TyV128                   // WASM: 128-bit SIMD vector (sets the slot width)
               | TyI8x16 | TyI16x8 | TyI32x4 | TyI64x2 | TyF32x4 | TyF64x2  // WASM SIMD lane views of a v128 (storage = v128; the body lowers per-lane)
               | TyFuncRef | TyExternRef  // WASM: reference types
               | TyI31Ref                 // WASM GC: an unboxed 31-bit int reference
               | TyUleb32 | TyUleb64      // WASM operand widths: unsigned LEB128 varint (carrier u32/u64)
               | TySleb32 | TySleb64      // WASM operand widths: signed LEB128 varint (carrier s32/s64)
               | TyMemarg                 // WASM memarg: align-flags u32 (bit6 ⇒ memidx u32 follows) then offset u64; binds the offset (carrier u64)
               | TyBlockType              // WASM blocktype (s33): 0x40/valtype/typeidx; the (ref null? ht) forms 0x63/0x64 carry a TRAILING heaptype (carrier s32)
               | TyBrTable | TyTryTable | TySelectVec  // WASM operand vectors: br_table label list, try_table catch list, select result-type vector
               | TyAny                    // runtime-typed value; slot width (1/2) from the stack tag
               | TyAddr                   // WASM memory64/table64: an addrtype-width integer (i32 or i64). The width is the addrtype DECLARED by the module entry the operand addresses, named by the signature's `addr(<is64-expr>)` source (see stack_param.at_src) — never the operand's runtime tag. i32 zero-extends; pop-only

    // sem_expr captures the rare "= expr" form on stack outputs that
    // the harness emitter uses for dup/dup2/etc. — e.g.
    //   dup (word a -- word a = "a", word a_copy = "a")
    // Empty for ordinary stack params.
    // `count` (optional): the param is VARIADIC — opgen pops `count` operands of type `ty` (count = an
    // immediate name or a runtime expr). The operands are NOT popped up front: they stay on the value
    // stack (GC roots) for the body to read in-place as `name[i]`; opgen drops them (sp -= count) AFTER
    // the body, then pushes the results. This is the §3(b) "variadic by immediate" form (struct.new/
    // array.new_fixed/call): the signature stops lying and opgen owns the marshaling.
    // `at_src` (optional): the param's type is an ADDRESS TYPE resolved from a module entry, written
    // `addr(x) name` where x is the index immediate. WASM §2.3.11 makes addrtype ::= i32 | i64, and
    // §2.3.15/§2.3.16 make it part of each memory's / table's DECLARED type (memtype ::= addrtype
    // limits page; tabletype ::= addrtype limits reftype). So every typing rule reads the width from
    // the module — `C.mems[x] = at lim page  =>  C |- nt.load x memarg : at -> nt` (§3.4.5),
    // `C.tables[x] = at lim rt  =>  C |- table.get x : at -> rt` (§3.4.4) — and §4.6.8 executes it as
    // "ASSERT: Due to validation ... Pop the value (at.const i)": asserted from the declared type,
    // never tested at runtime. Naming the source here is what lets the generated pop read the SAME
    // fact the validator read, instead of re-deriving the width from the operand's value tag.
    stack_param   = StackParam(value_type ty, ident name, ident ?sem_expr, sem_expr ?count,
                               sem_expr ?at_src)
    operand_param = OperandParam(value_type ty, ident name, bool cp_ref)

    // Error annotation: optional condition + an error-name tag.
    // An unconditional error has condition == NULL. The condition is a parsed
    // expression in the same closed action language as an opcode body — it IS
    // what gets emitted as the guard, not a description of it.
    error_case = ErrorCase(sem_expr ?condition, ident error_name)

    // Type of a local-variable-referencing opcode's referenced slot:
    // sload/sstore touch a short, iload/istore an int (2 slots), aload
    // /astore a reference. ret reads the slot as a return address but
    // probes treat it as short (single-slot). Drives bad-local probes
    // and store-side stack prep.
    local_value_kind = LvShort | LvInt | LvRef
                     | LvLong | LvFloat | LvDouble    // JVM
    local_value_decl = LocalValueDecl(local_value_kind kind)

    // ── Semantic action language ──────────────────────────────
    // The opcode body is the interior of one method, written in the Java
    // block-statement grammar (Alves-Foss/Frincke §2.11/§2.12, with the
    // attribute/ERROR apparatus dropped). Object/field/array/invoke
    // effects are expressed as built-in calls (SCall) over a runtime
    // boundary — the action language deliberately has no
    // `new`/`this`/`super`/`instanceof`/dotted-field syntax (those name
    // class/type machinery an opcode action does not possess), no
    // loops/switch/labels/break/continue/try/synchronized (control-flow
    // with no role in a single opcode's straight-line action), and no
    // ++/--/compound-assignment (side-effecting expression sugar). See
    // the grammar header in opgen.peg for the full rationale. Precedence
    // is captured by tree structure, so there is no paren node.
    sem_expr = SBinOp(ident op, sem_expr left, sem_expr right)
             | SUnary(ident op, sem_expr operand)
             | STernary(sem_expr cond, sem_expr then_, sem_expr else_)
             | SCast(ident ty, sem_expr operand)        // ty: java prim type
             | SIndex(sem_expr base, sem_expr index)    // base[index]
             | SCall(ident name, sem_expr *args)        // built-in invocation
             | SIdent(ident name)
             | SInt(int64 value)
             | SFloat(float64 value)

    sem_stmt = SAssign(sem_expr target, sem_expr value)    // target = value;
             | SExprStmt(sem_expr value)                   // expr;
             | SLocalDecl(ident ty, ident name, sem_expr ?init)
             | SIf(sem_expr cond, sem_stmt then_, sem_stmt ?else_)
             | SWhile(sem_expr cond, sem_stmt body)               // while (cond) body
             | SFor(sem_stmt ?init, sem_expr ?cond,                // for (init; cond; update) body
                    sem_stmt ?update, sem_stmt body)
             | SBlock(sem_stmt *stmts)
             | STrap

    // ── Method declarations (the built-in vocabulary) ─────────
    // A built-in (ddcgc's Aux) is a `native` method: signature here, C body in
    // the runtime, called by name (method name == runtime C function). A helper
    // (ddcgc's Fun) is a method with an action-language body. Both parse via the
    // same JLS method-declaration rule. `ret_ty`/param `ty` are a Java primitive
    // type, `ref`, or `void`. A native method carries no body (empty sem_body).
    method_param = MethodParam(ident ty, ident name)
    // `inl`: an INLINE native — opgen emits a DIRECT call (not a `_HOLE_` patch point) even in stencil
    // mode, so a `static inline` definition in a backend header folds into the handler/stencil with no
    // extern. For VM-internal state access that does the spec reduction (e.g. linear-memory load/store:
    // the heap owns the storage layer, the bytecode does the bounds-checked byte access).
    method_decl  = MethodDecl(bool native, bool inl, ident ret_ty, ident name,
                              method_param *params, sem_stmt *body)

    // The control-flow status vocabulary, declared in the spec so the
    // generator stays target-agnostic (no baked-in YOCTOJC_* identifiers):
    // `type` is the C status type, `ok`/`err`/`halt` its constants.
    status_decl = StatusDecl(ident type, ident ok, ident err, ident halt, ident *extra)

    // A slot/type-table row, declared in the spec so the slot model swaps per
    // target (JCVM 16-bit vs JVM 32-bit word) without changing the generator:
    // `ty` is the value type, `scalar`/`uscalar` its signed/unsigned C type,
    // `slots` how many operand-stack/local slots it occupies, `field` the
    // slot-union member ('i'/'f'/'r'/'s'). Unspecified types fall back to the
    // built-in 16-bit JCVM defaults.
    type_decl = TypeDecl(value_type ty, ident scalar, ident uscalar,
                         int32 slots, ident field)

    // One opcode definition.
    opcode = Opcode(ident mnemonic,
                    int32 opcode_val,
                    int32 subop,        // -1 = top-level (1-byte); >=0 = prefixed (opcode_val is the prefix, subop the ULEB subopcode)
                    operand_param *operands,
                    stack_param   *stack_in,
                    stack_param   *stack_out,
                    error_case    *errors,
                    ident         *flags,
                    local_value_decl  ?local_value,
                    sem_stmt      *sem_body)

    // `headers`: raw `(. ... .)` blocks at the top of opcodes.def —
    // emitted verbatim near the top of the generated opcodes.h so
    // users can inject forward declarations, typedefs, etc.
    // `body_c`: everything after the optional `%%` marker at the
    // end of opcodes.def — emitted verbatim at the end of the
    // generated opcode_tables.c so users can attach helper function
    // definitions that reference the tables without needing a
    // separate .c file.
    // `backend`: the `backend "<header>"` directive — the substrate
    // header (frame_t/vm_t/heap_t) a consumer supplies. opgen #includes
    // it at the value-model's substrate point in runtime_api.h; absent,
    // the self-test default frame is emitted instead.
    // `sidetable`: the bare `sidetable` directive — this op set has
    // STRUCTURED control, so opgen owns the Titzer side-table entry
    // format and the §4.4.8 walk over it, and emits both. Declared
    // rather than inferred: an op set can name its transfer built-in
    // anything, and a spec with no side table must not be handed a
    // walk that reads frame fields its substrate does not have.
    module = Module(opcode *opcodes,
                    method_decl *methods,
                    status_decl ?status,
                    type_decl *types,
                    rawcode *headers,
                    rawcode ?body_c,
                    rawcode ?backend,
                    bool sidetable)
}
