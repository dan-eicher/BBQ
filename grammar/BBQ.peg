// =============================================================
// BBQ (Binary Block Query) — PEG Grammar
//
// Port of BBQ.atg (Coco/R) to pegc format.
// Builds the same BBQ AST as the original grammar.
//
// Generate with:
//   ./build/pegc/pegc grammar/BBQ.peg -frames grammar/frames/ -o frontend/ -prefix ""
// =============================================================

COMPILER BBQ

(. #include <string>
   #include <vector>
   #include <optional>
   #include <cstdlib>
   #include "PegRuntime.h"
.)

CHARACTERS
  letter         = 'a'..'z' + 'A'..'Z' + '_' .
  digit          = '0'..'9' .
  hex_digit      = digit + 'a'..'f' + 'A'..'F' .
  ident_continue = letter + digit .

TOKENS
  ident      = letter { ident_continue } .
  integer    = '0' 'x' hex_digit { hex_digit }
             | '0' 'X' hex_digit { hex_digit }
             | digit { digit } .
  floating   = digit { digit } '.' digit { digit } .
  string_lit = '"' { '\\' ANY | !'"' ANY } '"' .

COMMENTS FROM "#" TO "\n"
COMMENTS FROM "//" TO "\n"

IGNORE '\r' + '\n' + '\t' + ' '

PRODUCTIONS

// ═══════════════════════════════════════════════════════════════
// Top-Level
// ═══════════════════════════════════════════════════════════════

BBQ
    (. std::vector<EndianDirective*> dirs;
       std::vector<Rule*> rules; .)
    = { Directive<&dirs> }
      Rule_<&rules>
      { Rule_<&rules> }
    (. skip(); if (!at_end()) return false; .)
    (. ast = new Grammar(std::move(dirs), std::move(rules));
       ast->loc = SourceLoc{nullptr, 1, 1}; .)
.

Directive <. std::vector<EndianDirective*> *dirs .>
    (. Endianness e; .)
    = "@endian"
      ( "big"    (. e = Endianness::Big; .)
      | "little" (. e = Endianness::Little; .)
      )
    (. auto* d = new EndianDirective(e);
       d->loc = Loc();
       dirs->push_back(d); .)
.

Rule_ <. std::vector<Rule*> *rules .>
    (. peg::Span name_span; std::string name; TypeExpr* body; .)
    = ident<name_span>  (. name = name_span.to_string(); SourceLoc loc = Loc(); .)
      "="
      TypeBody<&body>
    (. auto* r = new Rule(std::move(name), body);
       r->loc = loc;
       rules->push_back(r); .)
.

// ═══════════════════════════════════════════════════════════════
// Type Expressions
// ═══════════════════════════════════════════════════════════════

TypeBody <. TypeExpr* *result .>
    (. TypeExpr* first;
       std::vector<TypeExpr*> alts; .)
    = TypeTerm<&first>       (. alts.push_back(first); .)
      { "|"
        TypeTerm<&first>     (. alts.push_back(first); .)
      }
    (. if (alts.size() == 1)
           *result = alts[0];
       else {
           auto loc = alts[0]->loc;
           *result = new Alternatives(std::move(alts));
           (*result)->loc = loc;
       } .)
.

TypeTerm <. TypeExpr* *result .>
    (. Expr* constr = nullptr;
       Interval* iv = nullptr; .)
    = TypePrimary<result>
      [ ConstraintBlock<&constr> ]
      [ IntervalSpec<&iv> ]
.

TypePrimary <. TypeExpr* *result .>
    = "struct"    StructBody<result>
    | "union"     UnionBody<result>
    | "array"     ArrayBody<result>
    | "optional"  OptionalBody<result>
    | "switch"    SwitchBody<result>
    | "compute"   ComputeBody<result>
    | "extern"    ExternBody<result>
    | "bitfield"  BitfieldBody<result>
    | PrimitiveType<result>
    | "(" TypeBody<result> ")"
    | RuleRefType<result>
.

// ── Struct ──────────────────────────────────────────────────

StructBody <. TypeExpr* *result .>
    (. std::vector<Field*> fields;
       SourceLoc loc = Loc(); .)
    = "{"
      [ StructElement<&fields>
        { "," StructElement<&fields> }
        [ "," ]
      ]
      "}"
    (. *result = new Struct(std::move(fields));
       (*result)->loc = loc; .)
.

StructElement <. std::vector<Field*> *fields .>
    = EndianDirectiveField<fields>
    | FieldDecl<fields>
.

EndianDirectiveField <. std::vector<Field*> *fields .>
    (. Expr* expr; .)
    = "@endian" ":"
      Expr_<&expr>
    (. auto* es = new EndianSwitch(expr);
       es->loc = Loc();
       auto* f = new Field("", es, std::nullopt, std::nullopt, false);
       f->loc = es->loc;
       fields->push_back(f); .)
.

FieldDecl <. std::vector<Field*> *fields .>
    (. peg::Span name_span;
       std::string name;
       TypeExpr* body;
       Expr* constr = nullptr;
       Interval* iv = nullptr;
       bool scopes_rest = false; .)
    = ident<name_span>       (. name = name_span.to_string(); SourceLoc loc = Loc(); .)
      ":"
      TypeBody<&body>
      [ ConstraintBlock<&constr> ]
      [ IntervalSpec<&iv> ]
      [ "@" "rest"           (. scopes_rest = true; .) ]
    (. auto* f = new Field(std::move(name), body,
           constr ? std::optional<Expr*>(constr) : std::nullopt,
           iv     ? std::optional<Interval*>(iv) : std::nullopt,
           scopes_rest);
       f->loc = loc;
       fields->push_back(f); .)
.

// ── Union ───────────────────────────────────────────────────

UnionBody <. TypeExpr* *result .>
    (. std::vector<Variant*> variants;
       SourceLoc loc = Loc(); .)
    = "{"
      [ VariantDecl<&variants>
        { "," VariantDecl<&variants> }
        [ "," ]
      ]
      "}"
    (. *result = new Union(std::move(variants));
       (*result)->loc = loc; .)
.

VariantDecl <. std::vector<Variant*> *variants .>
    (. peg::Span name_span;
       std::string name;
       TypeExpr* body;
       Expr* constr = nullptr;
       Interval* iv = nullptr; .)
    = ident<name_span>       (. name = name_span.to_string(); SourceLoc loc = Loc(); .)
      ":"
      TypeBody<&body>
      [ ConstraintBlock<&constr> ]
      [ IntervalSpec<&iv> ]
    (. auto* v = new Variant(std::move(name), body,
           constr ? std::optional<Expr*>(constr) : std::nullopt,
           iv     ? std::optional<Interval*>(iv) : std::nullopt);
       v->loc = loc;
       variants->push_back(v); .)
.

// ── Array ───────────────────────────────────────────────────

ArrayBody <. TypeExpr* *result .>
    (. TypeExpr* elem;
       ArraySpec* spec;
       Expr* constr = nullptr;
       Interval* iv = nullptr;
       Interval* elem_iv = nullptr;
       bool resync = false;
       SourceLoc loc = Loc(); .)
    = "<" TypeBody<&elem> ">"
      ArraySpecRule<&spec>
      [ "resync" !ident_continue (. resync = true; .) ]
      [ ConstraintBlock<&constr> ]
      [ IntervalSpec<&iv> ]
      [ "@" ElementIntervalSpec<&elem_iv> ]
    (. *result = new Array(elem, spec,
           constr ? std::optional<Expr*>(constr) : std::nullopt,
           iv     ? std::optional<Interval*>(iv) : std::nullopt,
           elem_iv ? std::optional<Interval*>(elem_iv) : std::nullopt,
           resync);
       (*result)->loc = loc; .)
.

ArraySpecRule <. ArraySpec* *result .>
    (. Expr* count;
       Separator* sep;
       Terminator* term; .)
    = "["
      Expr_<&count>
      "]"
      (. *result = new FixedCount(count); (*result)->loc = count->loc; .)
    | "("
      SepSpec<&sep> ","
      TermSpec<&term>
      ")"
      (. *result = new SepTerm(sep, term); (*result)->loc = sep->loc; .)
.

SepSpec <. Separator* *result .>
    (. TypeExpr* ty; .)
    = "none"
      (. *result = new NoneSep(); (*result)->loc = Loc(); .)
    | TypeBody<&ty>
      (. auto* s = new TypeSep(ty); s->loc = ty->loc; *result = s; .)
.

TermSpec <. Terminator* *result .>
    (. Expr* e; TypeExpr* ty; .)
    = "eof"
      (. *result = new EofTerm(); (*result)->loc = Loc(); .)
    | "count" "(" Expr_<&e> ")"
      (. *result = new CountTerm(e); (*result)->loc = Loc(); .)
    | "until" "(" Expr_<&e> ")"
      (. *result = new UntilTerm(e); (*result)->loc = Loc(); .)
    | TypeBody<&ty>
      (. auto* tt = new BBQ::TypeTerm(ty); tt->loc = ty->loc; *result = tt; .)
.

// ── Optional ────────────────────────────────────────────────

OptionalBody <. TypeExpr* *result .>
    (. TypeExpr* elem;
       Expr* constr = nullptr;
       Interval* iv = nullptr;
       SourceLoc loc = Loc(); .)
    = "<" TypeBody<&elem> ">"
      [ ConstraintBlock<&constr> ]
      [ IntervalSpec<&iv> ]
    (. *result = new Optional(elem,
           constr ? std::optional<Expr*>(constr) : std::nullopt,
           iv     ? std::optional<Interval*>(iv) : std::nullopt);
       (*result)->loc = loc; .)
.

// ── Switch ──────────────────────────────────────────────────

SwitchBody <. TypeExpr* *result .>
    (. Expr* disc;
       std::vector<SwitchCase*> cases;
       SwitchDefault* def = nullptr;
       SourceLoc loc = Loc(); .)
    = "(" Expr_<&disc> ")"
      "{"
      { SwitchCaseRule<&cases> }
      [ DefaultCaseRule<&def> ]
      "}"
    (. *result = new Switch(disc, std::move(cases),
           def ? std::optional<SwitchDefault*>(def) : std::nullopt);
       (*result)->loc = loc; .)
.

SwitchCaseRule <. std::vector<SwitchCase*> *cases .>
    (. CaseValue* cv;
       TypeExpr* target;
       Interval* iv = nullptr; .)
    = CaseValueRule<&cv>
      ":"
      TypeBody<&target>
      [ IntervalSpec<&iv> ]
      ";"
    (. auto* sc = new SwitchCase(cv, target,
           iv ? std::optional<Interval*>(iv) : std::nullopt);
       sc->loc = cv->loc;
       cases->push_back(sc); .)
.

DefaultCaseRule <. SwitchDefault* *result .>
    (. TypeExpr* target = nullptr;
       Interval* iv = nullptr;
       bool is_reject = false; .)
    = "default"    (. SourceLoc loc = Loc(); .)
      ":"
      // `reject` is a contextual keyword — only meaningful here.
      // !ident_continue enforces the word boundary so a struct field
      // or rule name like `reject_id` doesn't get misparsed as the
      // keyword followed by garbage. Outside this context, `reject`
      // is a normal identifier.
      ( "reject" !ident_continue   (. is_reject = true; .)
      | TypeBody<&target>
      )
      [ IntervalSpec<&iv> ]
      ";"
    (. *result = new SwitchDefault(
           target ? std::optional<TypeExpr*>(target) : std::nullopt,
           iv ? std::optional<Interval*>(iv) : std::nullopt,
           is_reject);
       (*result)->loc = loc; .)
.

CaseValueRule <. CaseValue* *result .>
    (. peg::Span span;
       std::vector<std::string> path;
       std::string s;
       int64_t ival; .)
    = DottedRef<result>
    | integer<span>           (. ival = std::stoll(span.to_string(), nullptr, 0);
                                *result = new IntValue(ival); (*result)->loc = Loc(); .)
    | string_lit<span>        (. s = peg::unescape_string_lit(span);
                                *result = new StrValue(std::move(s)); (*result)->loc = Loc(); .)
    | !"default" ident<span>  (. s = span.to_string();
                                *result = new IdentValue(std::move(s)); (*result)->loc = Loc(); .)
.

DottedRef <. CaseValue* *result .>
    (. peg::Span span;
       std::vector<std::string> path; .)
    = ident<span>            (. path.push_back(span.to_string()); .)
      "."
      ident<span>            (. path.push_back(span.to_string()); .)
      { "."
        ident<span>          (. path.push_back(span.to_string()); .)
      }
    (. *result = new RefValue(std::move(path)); (*result)->loc = Loc(); .)
.

// ── Compute ─────────────────────────────────────────────────

ComputeBody <. TypeExpr* *result .>
    (. Expr* e;
       PrimitiveKind* pk;
       SourceLoc loc = Loc(); .)
    = "("
      Expr_<&e>
      ":"
      PrimKeyword<&pk>
      ")"
    (. *result = new Compute(e, pk);
       (*result)->loc = loc; .)
.

// ── Extern ──────────────────────────────────────────────

ExternBody <. TypeExpr* *result .>
    (. peg::Span func_span; peg::Span ctype_span;
       std::string func; std::string ctype;
       Expr* constr = nullptr; Interval* iv = nullptr;
       SourceLoc loc = Loc(); .)
    = "("
      string_lit<func_span>   (. func = peg::unescape_string_lit(func_span); .)
      ","
      string_lit<ctype_span>  (. ctype = peg::unescape_string_lit(ctype_span); .)
      ")"
      [ ConstraintBlock<&constr> ]
      [ IntervalSpec<&iv> ]
    (. *result = new Extern(std::move(func), std::move(ctype),
           constr ? std::optional<Expr*>(constr) : std::nullopt,
           iv     ? std::optional<Interval*>(iv) : std::nullopt);
       (*result)->loc = loc; .)
.

// ── Bitfield ───────────────────────────────────────────────

BitfieldBody <. TypeExpr* *result .>
    (. PrimitiveKind* container;
       std::vector<BitfieldEntry*> entries;
       SourceLoc loc = Loc(); .)
    = "<" PrimKeyword<&container> ">"
      "{"
      [ BitfieldEntryRule<&entries>
        { "," BitfieldEntryRule<&entries> }
        [ "," ]
      ]
      "}"
    (. *result = new Bitfield(container, std::move(entries));
       (*result)->loc = loc; .)
.

BitfieldEntryRule <. std::vector<BitfieldEntry*> *entries .>
    (. peg::Span name_span; peg::Span width_span;
       std::string name; int64_t width;
       Expr* constr = nullptr; .)
    = ident<name_span>  (. name = name_span.to_string(); SourceLoc loc = Loc(); .)
      ":"
      integer<width_span> (. width = std::stoll(width_span.to_string(), nullptr, 0); .)
      [ ConstraintBlock<&constr> ]
    (. auto* e = new BitfieldEntry(std::move(name), width,
               constr ? std::optional<Expr*>(constr) : std::nullopt);
       e->loc = loc;
       entries->push_back(e); .)
.

// ── Primitive Type ──────────────────────────────────────────

PrimitiveType <. TypeExpr* *result .>
    (. PrimitiveKind* pk;
       Expr* constr = nullptr;
       Interval* iv = nullptr; .)
    = PrimKeyword<&pk>
      (. SourceLoc loc = pk->loc; .)
      [ ConstraintBlock<&constr> ]
      [ IntervalSpec<&iv> ]
    (. *result = new Primitive(pk,
           constr ? std::optional<Expr*>(constr) : std::nullopt,
           iv     ? std::optional<Interval*>(iv) : std::nullopt);
       (*result)->loc = loc; .)
.

PrimKeyword <. PrimitiveKind* *result .>
    (. peg::Span span; std::string s; .)
    = ident<span>
      (. s = span.to_string();
         *result = DecodePrimitive(s, Loc());
         if (!*result) return false; .)
.

// ── Rule Reference ──────────────────────────────────────────

RuleRefType <. TypeExpr* *result .>
    (. peg::Span name_span;
       std::string name;
       Expr* constr = nullptr;
       Interval* iv = nullptr; .)
    = ident<name_span>   (. name = name_span.to_string(); SourceLoc loc = Loc(); .)
      [ ConstraintBlock<&constr> ]
      [ IntervalSpec<&iv> ]
    (. *result = new RuleRef(std::move(name),
           constr ? std::optional<Expr*>(constr) : std::nullopt,
           iv     ? std::optional<Interval*>(iv) : std::nullopt);
       (*result)->loc = loc; .)
.

// ── Constraint (where clause) ───────────────────────────────

ConstraintBlock <. Expr* *result .>
    = "where" Expr_<result>
.

// ── Interval ────────────────────────────────────────────────

IntervalSpec <. Interval* *result .>
    (. Expr* a; Expr* b; .)
    = "["
      Expr_<&a>
      ( ","
        Expr_<&b>
        (. *result = new StartEnd(a, b); (*result)->loc = a->loc; .)
      |   (. *result = new Length(a); (*result)->loc = a->loc; .)
      )
      "]"
.

ElementIntervalSpec <. Interval* *result .>
    (. Expr* a; Expr* b; .)
    = "["
      Expr_<&a> "," Expr_<&b>
      "]"
    (. *result = new StartEnd(a, b); (*result)->loc = a->loc; .)
.

// ═══════════════════════════════════════════════════════════════
// Expression Language
// ═══════════════════════════════════════════════════════════════

Expr_ <. Expr* *result .>
    = TernaryExpr<result>
.

TernaryExpr <. Expr* *result .>
    (. Expr* then_; Expr* else_; .)
    = LogicalOr<result>
      [ "?"
        Expr_<&then_>
        ":"
        TernaryExpr<&else_>
        (. *result = new Ternary(*result, then_, else_);
           (*result)->loc = then_->loc; .)
      ]
.

LogicalOr <. Expr* *result .>
    (. Expr* rhs; .)
    = LogicalAnd<result>
      { "||"
        LogicalAnd<&rhs>
        (. *result = new BinOp(*result, Binop::Or, rhs);
           (*result)->loc = rhs->loc; .)
      }
.

LogicalAnd <. Expr* *result .>
    (. Expr* rhs; .)
    = BitwiseOr<result>
      { "&&"
        BitwiseOr<&rhs>
        (. *result = new BinOp(*result, Binop::And, rhs);
           (*result)->loc = rhs->loc; .)
      }
.

BitwiseOr <. Expr* *result .>
    (. Expr* rhs; .)
    = BitwiseXor<result>
      { "|"
        BitwiseXor<&rhs>
        (. *result = new BinOp(*result, Binop::BitOr, rhs);
           (*result)->loc = rhs->loc; .)
      }
.

BitwiseXor <. Expr* *result .>
    (. Expr* rhs; .)
    = BitwiseAnd<result>
      { "^"
        BitwiseAnd<&rhs>
        (. *result = new BinOp(*result, Binop::BitXor, rhs);
           (*result)->loc = rhs->loc; .)
      }
.

BitwiseAnd <. Expr* *result .>
    (. Expr* rhs; .)
    = Equality<result>
      { "&"
        Equality<&rhs>
        (. *result = new BinOp(*result, Binop::BitAnd, rhs);
           (*result)->loc = rhs->loc; .)
      }
.

Equality <. Expr* *result .>
    (. Expr* rhs; .)
    = Relational<result>
      { "=="
        Relational<&rhs>
        (. *result = new BinOp(*result, Binop::Eq, rhs);
           (*result)->loc = rhs->loc; .)
      | "!="
        Relational<&rhs>
        (. *result = new BinOp(*result, Binop::Ne, rhs);
           (*result)->loc = rhs->loc; .)
      }
.

Relational <. Expr* *result .>
    (. Expr* rhs; .)
    = Shift<result>
      { "<="
        Shift<&rhs>
        (. *result = new BinOp(*result, Binop::Le, rhs);
           (*result)->loc = rhs->loc; .)
      | ">="
        Shift<&rhs>
        (. *result = new BinOp(*result, Binop::Ge, rhs);
           (*result)->loc = rhs->loc; .)
      | "<" !"<"
        Shift<&rhs>
        (. *result = new BinOp(*result, Binop::Lt, rhs);
           (*result)->loc = rhs->loc; .)
      | ">" !">"
        Shift<&rhs>
        (. *result = new BinOp(*result, Binop::Gt, rhs);
           (*result)->loc = rhs->loc; .)
      }
.

Shift <. Expr* *result .>
    (. Expr* rhs; .)
    = Additive<result>
      { "<<"
        Additive<&rhs>
        (. *result = new BinOp(*result, Binop::Shl, rhs);
           (*result)->loc = rhs->loc; .)
      | ">>"
        Additive<&rhs>
        (. *result = new BinOp(*result, Binop::Shr, rhs);
           (*result)->loc = rhs->loc; .)
      }
.

Additive <. Expr* *result .>
    (. Expr* rhs; .)
    = Multiplicative<result>
      { "+"
        Multiplicative<&rhs>
        (. *result = new BinOp(*result, Binop::Add, rhs);
           (*result)->loc = rhs->loc; .)
      | "-"
        Multiplicative<&rhs>
        (. *result = new BinOp(*result, Binop::Sub, rhs);
           (*result)->loc = rhs->loc; .)
      }
.

Multiplicative <. Expr* *result .>
    (. Expr* rhs; .)
    = Unary<result>
      { "*"
        Unary<&rhs>
        (. *result = new BinOp(*result, Binop::Mul, rhs);
           (*result)->loc = rhs->loc; .)
      | "/"
        Unary<&rhs>
        (. *result = new BinOp(*result, Binop::Div, rhs);
           (*result)->loc = rhs->loc; .)
      | "%"
        Unary<&rhs>
        (. *result = new BinOp(*result, Binop::Mod, rhs);
           (*result)->loc = rhs->loc; .)
      }
.

Unary <. Expr* *result .>
    (. Expr* operand; Unaryop op; .)
    = ( "-"   (. op = Unaryop::Neg; .)
      | "~"   (. op = Unaryop::BitNot; .)
      | "!"   (. op = Unaryop::Not; .)
      | "abs" (. op = Unaryop::Abs; .)
      )
      Postfix<&operand>
      (. *result = new UnaryOp(op, operand);
         (*result)->loc = operand->loc; .)
    | Postfix<result>
.

Postfix <. Expr* *result .>
    (. peg::Span fname_span; Expr* idx; std::string fname; .)
    = PrimaryExpr<result>
      { "["
        Expr_<&idx>
        "]"
        (. auto* ref = dynamic_cast<Ref*>(*result);
           if (ref) {
               auto* ia = new IndexAcc(ref->path, idx);
               ia->loc = ref->loc;
               ref->path = ia;
           } .)
      | "."
        ident<fname_span>
        (. fname = fname_span.to_string();
           auto* ref = dynamic_cast<Ref*>(*result);
           if (ref) {
               auto* fa = new FieldAcc(ref->path, std::move(fname));
               fa->loc = ref->loc;
               ref->path = fa;
           } .)
      }
.

PrimaryExpr <. Expr* *result .>
    (. peg::Span span;
       std::string name;
       std::vector<Expr*> args;
       Expr* arg;
       int64_t ival;
       double fval;
       std::string sval; .)
    = FloatLitExpr<result>
    | integer<span>
      (. ival = std::stoll(span.to_string(), nullptr, 0);
         *result = new IntLit(ival);
         (*result)->loc = Loc(); .)
    | string_lit<span>
      (. sval = peg::unescape_string_lit(span);
         *result = new StrLit(std::move(sval));
         (*result)->loc = Loc(); .)
    | "true"
      (. *result = new BoolLit(true);
         (*result)->loc = Loc(); .)
    | "false"
      (. *result = new BoolLit(false);
         (*result)->loc = Loc(); .)
    | "little"
      (. *result = new EndianLit(Endianness::Little);
         (*result)->loc = Loc(); .)
    | "big"
      (. *result = new EndianLit(Endianness::Big);
         (*result)->loc = Loc(); .)
    | "EOI"
      (. *result = new EOI();
         (*result)->loc = Loc(); .)
    | CallExpr<result>
    | ident<span>
      (. name = span.to_string();
         auto* s = new Simple(std::move(name), std::nullopt, std::nullopt, 0);
         s->loc = Loc();
         *result = new Ref(s);
         (*result)->loc = Loc(); .)
    | "(" Expr_<result> ")"
.

FloatLitExpr <. Expr* *result .>
    (. peg::Span span; double fval; .)
    = floating<span>
      (. fval = std::stod(span.to_string());
         *result = new FloatLit(static_cast<float>(fval));
         (*result)->loc = Loc(); .)
.

CallExpr <. Expr* *result .>
    (. peg::Span name_span;
       std::string name;
       std::vector<Expr*> args;
       Expr* arg; .)
    = ident<name_span>   (. name = name_span.to_string(); SourceLoc loc = Loc(); .)
      "("
      [ Expr_<&arg>      (. args.push_back(arg); .)
        { ","
          Expr_<&arg>    (. args.push_back(arg); .)
        }
      ]
      ")"
      (. *result = new Call(std::move(name), std::move(args));
         (*result)->loc = loc; .)
.

END BBQ.
