// =============================================================
// ASDL Parser — PEG grammar (port of asdl.atg)
//
// Parses ASDL specifications and builds a typed AST.
// Generated by pegc.
//
// Generate with:
//   ./build/pegc asdl/grammar/asdl.peg -frames asdl/grammar/frames/ -o asdl/frontend/ -prefix ""
// =============================================================

COMPILER Asdl

(. #include <string>
   #include <vector>
.)

COMMENTS FROM "//" TO "\n"
COMMENTS FROM "/*" TO "*/"

IGNORE '\r' + '\n' + '\t' + ' '

PRODUCTIONS

Asdl
    (. std::string name;
       std::vector<asdl_ast::TypeAlias*> aliases;
       std::vector<asdl_ast::Definition*> definitions; .)
    = "module"
      ident<name>
      "{"
      { TypeAliasDecl<aliases>
      | DefinitionDecl<definitions>
      }
      "}"
    (. ast = new asdl_ast::Module(std::move(name),
           std::move(aliases), std::move(definitions)); .)
.

TypeAliasDecl <. std::vector<asdl_ast::TypeAlias*> &aliases .>
    (. std::string name; std::string ctype; .)
    = "type"
      TypId<name>
      "="
      string_lit<ctype>
    (. aliases.push_back(new asdl_ast::TypeAlias(std::move(name), std::move(ctype))); .)
.

DefinitionDecl <. std::vector<asdl_ast::Definition*> &defs .>
    (. std::string name; asdl_ast::TypeBody* body; .)
    = TypId<name>
      "="
      TypeBodyDecl<body>
    (. defs.push_back(new asdl_ast::Definition(std::move(name), body)); .)
.

TypeBodyDecl <. asdl_ast::TypeBody* &result .>
    = ProductBody<result>
    | SumBody<result>
.

ProductBody <. asdl_ast::TypeBody* &result .>
    (. std::vector<asdl_ast::Field*> fields; .)
    = FieldList<fields>
    (. result = new asdl_ast::Product(std::move(fields)); .)
.

SumBody <. asdl_ast::TypeBody* &result .>
    (. std::vector<asdl_ast::Constructor*> types;
       std::vector<asdl_ast::Field*> attributes;
       asdl_ast::Constructor* ctor; .)
    = ConstructorDecl<ctor>  (. types.push_back(ctor); .)
      { "|" ConstructorDecl<ctor>  (. types.push_back(ctor); .) }
      [ "attributes" FieldList<attributes> ]
    (. result = new asdl_ast::Sum(std::move(types), std::move(attributes)); .)
.

ConstructorDecl <. asdl_ast::Constructor* &result .>
    (. std::string name;
       std::vector<asdl_ast::Field*> fields; .)
    = ConId<name>
      [ FieldList<fields> ]
    (. result = new asdl_ast::Constructor(std::move(name), std::move(fields)); .)
.

FieldList <. std::vector<asdl_ast::Field*> &fields .>
    (. asdl_ast::Field* f; .)
    = "(" FieldDecl<f>  (. fields.push_back(f); .)
          { "," FieldDecl<f>  (. fields.push_back(f); .) }
      ")"
.

FieldDecl <. asdl_ast::Field* &result .>
    (. std::string type_name; std::string name;
       asdl_ast::Flag flag = asdl_ast::Flag::None; .)
    = TypId<type_name>
      [ "?"  (. flag = asdl_ast::Flag::Optional; .) ]
      [ "*"  (. flag = asdl_ast::Flag::Sequence; .) ]
      AnyId<name>
    (. result = new asdl_ast::Field(std::move(type_name), flag, std::move(name)); .)
.

// --- Identifier helpers ---

TypId <. std::string &name .>
    = (. if (!std::islower(peek())) return false; .)
      ident<name>
.

ConId <. std::string &name .>
    = (. if (!std::isupper(peek())) return false; .)
      ident<name>
.

AnyId <. std::string &name .>
    = ident<name>
.

END Asdl.
