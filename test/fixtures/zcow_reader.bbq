# ZCow view-parser fixture — the cpp-zcow (view) reader builds the FieldCapture
# index, parity-checked against the CEK in render_view_parser_test. Grows feature
# by feature as the view profile handles more (flat scalars first; nested/arrays/
# etc. land as the burg emits their view stencils). NOT cut to any consumer.
@endian little

Flat = struct {
    u8:   uint8,
    u16:  uint16le,
    u32:  uint32le,
    be16: uint16be,
    i32:  int32le
}

# nested inline struct — begin_struct/end_struct stencils nest the index at runtime.
Nest = struct {
    hdr: struct { a: uint8, b: uint16le },
    c:   uint8
}

# counted array of primitives — runtime loop + begin_array/end_array; the count
# `[n]` decodes the prior field on access (bbq_view_i64).
Arr = struct {
    n:  uint8,
    xs: array<uint16le>[n]
}

# cross-rule invoke — a sub-rule builds into the shared reader (begin_struct scope
# + <Rule>_v_entry), as a ruleref field and as an array element.
Pair  = struct { p: uint8, q: uint8 }
Outer = struct { x: uint8, inner: Pair }
RArr  = struct { n: uint8, items: array<Pair>[n] }

# bytes/string (record-span) + a where-constraint (decode-on-access).
Bytes = struct { n: uint8, data: bytes[n] }
Str   = struct { s: string[3] }
Wh    = struct { ver: uint8 where ver == 1, x: uint8 }
# A predicate naming ONE field several times (a range test). Every other `where` here
# names its field once, so this is the only rule that exercises a backend whose
# field_ref costs a search: the reference must be spelled once and reused.
WhTwice = struct { lo: uint8, v: uint8 where v >= lo && v <= lo + 8, hi: uint8 }

# computed field — evaluated on parse (decode-on-access operands), stored as a
# Computed capture, read via node_computed_int.
Comp  = struct { raw: uint8, hi: compute((raw >> 4) & 0x0F : uint8), lo: compute(raw & 0x0F : uint8) }

# field interval @[s,e] — seek + bidirectional-confined window, bounds decode-on-access.
Iv    = struct { off: uint8, val: uint8 [off, off + 1] }

# @-builtin in an expression — spelled against the reader (@pos → r.pos), not ctx.
Pos   = struct { a: uint8, b: uint8 where @pos == 2 }

# optional — predicated (where) prim + rule, and bare (try/restore via checkpoint).
Op    = struct { f: uint8, v: optional<uint16le> where f == 1, r: optional<Pair> where f == 1 }
Bare  = struct { x: uint8, v: optional<uint8> }

# switch field — the arm captures under the field name + records the case ordinal
# (variant_tag); which() reads it, body_case_N()/default_val() decode the arm.
Sw    = struct { tag: uint8, body: switch(tag) { 1: uint16le; 2: Pair; default: uint8; } }

# union / alternatives — backtracking; the matched variant is captured under its
# name + variant_tag (where-distinguished so the second arm is actually reached).
VA    = struct { t: uint8 where t == 1, a: uint8 }
VB    = struct { t: uint8 where t == 2, b: uint8 }
U     = union { asA: VA, asB: VB }
Alts  = VA | VB

# bitfield — entries are Computed captures (container read + shift/mask at parse).
Bf       = bitfield<uint8> { hi: 4, lo: 4 }
InlineBf = struct { lead: uint8, flags: bitfield<uint8> { hi: 4, lo: 4 }, tail: uint8 }

# uncounted arrays — eof (until window end) + until(predicate), unbounded loop.
Eof = struct { items: array<Pair>(none, eof) }
Unt = struct { xs: array<uint8>(none, until(@remaining < 2)) }

# mid-struct @endian switch — native prims runtime-resolve the endian register
# (default little here; switch to big mid-struct).
Es  = struct { a: uint16, @endian: big, b: uint16 }

# resync array — each element under a checkpoint; on element failure skip a byte
# and retry (collect exactly n valid elements).
RsItem = struct { v: uint8 where v != 0 }
Resync = struct { n: uint8, items: array<RsItem>[n] resync }

# extern — the user parser consumes bytes; the index records the consumed span.
Ext = struct { tag: uint8, blob: extern("readit", "writeit", "uint32_t"), tail: uint8 }

# switch with a RANGE case (`1..3:` — RangeValue) + ternary `?:` in a compute +
# the @start builtin — three grammar constructs the view fixture never exercised.
SwRange = struct { tag: uint8, body: switch(tag) { 1..3: uint16le; default: uint8; } }
Tern    = struct { f: uint8, g: compute((f > 0 ? f * 2 : 99) : uint8) }
Bstart  = struct { pad: uint8, val: uint8 where @start == 0 }

# @rest — a size field that bounds the remaining content as a window. (There is no
# user-facing @eof builtin; EOI is internal to eof-terminated arrays, see Eof above.)
Rest = struct { size: uint8 @rest, a: uint16le }

# @rest over VARIABLE content — the window holds an eof array, so editing the array
# changes the rest's byte length and the writer must RECOMPUTE the (uleb) size field, not
# trust the stored one. (Rest above has fixed content, so it never exercises the recompute.)
RestEof = struct { sz: uleb128 @rest, xs: array<uint8>(none, eof) }

# count(N) array — the (sep, term) form with a re-evaluated bound (CEK Count mode,
# distinct from FixedCount `[n]`). The view re-checks the count each iteration.
Cnt = struct { n: uint8, xs: array<uint8>(none, count(n)) }

# top-level switch RULE (like wasm.bbq's Table) — discriminant is peek() (a builtin,
# the unconsumed next byte); the arm is the root's anonymous children[0] + variant_tag.
TopSw = switch(peek()) { 1: Pair; default: uint8; }

# nested field-path reference in an expression (like elf64's `ehdr.e_shoff`) — the
# count `h.n` navigates into the completed `h` sub-struct (PathStart/FieldAccess/
# CaptureValue), decoding the leaf on access rather than the c-owning struct member.
Np = struct { h: struct { n: uint8 }, xs: array<uint8>[h.n] }

# the FULL primitive matrix (PrimWidth × Sign × Kind × Encoding × endian) in one
# rule — the basic types the view parser must read identically to the CEK. Every
# width, both signs, both endians, both floats, bool.
AllPrim = struct {
    u8: uint8, i8: int8,
    u16: uint16le, u16b: uint16be, i16: int16le,
    u32: uint32le, u32b: uint32be, i32: int32le,
    u64: uint64le, i64: int64le,
    f32: float32le, f64: float64le,
    fl: bool
}

# LEB128 varints (uleb128 / sleb64) — variable-length: the view decodes at the
# cursor, advances by the bytes actually consumed, and records a Computed capture
# (a fixed span can't be re-decoded as a varint), byte-parity with the CEK and the
# c-owning reader. As a struct field, an array element, and a bare optional.
Leb    = struct { a: uleb128, b: sleb64, c: uint8 }
LebArr = struct { n: uint8, xs: array<uleb128>[n] }
LebOpt = struct { f: uint8, v: optional<uleb128> where f == 1, tail: uint8 }

# nested array<array> — the element container is itself an array; the view nests a
# begin_array within an array element (seq<prim_seq<uint8>>), as in the cpp Matrix.
Mat = struct { rows: uint8, cols: uint8, data: array<array<uint8>[cols]>[rows] }

# optional SPAN types (optional<bytes[n]> / optional<string[n]>) — the present arm
# records a borrowed span, the absent arm nothing.
OptSpan = struct { n: uint8, ob: optional<bytes[2]> where n == 1, os: optional<string[3]> where n == 1 }

# top-level NON-struct rules — the root is a single value (children[0]): a primitive
# typedef, a rule alias, a bare optional. value()/has_value() read the root child.
TyByte  = uint8
TyRule  = Pair
OptTop  = optional<uint8>

# outer-scope reference from INSIDE an array (the elf64 shdrs shape): each element's
# field-interval `@[base + @index, ...]` reads `base`, a header field parsed before
# the array opened — so the per-element expr must resolve a field in the enclosing
# scope, not just the innermost. Random-access placement via the interval.
OScope = struct {
    base: uint8,
    cnt:  uint8,
    items: array<uint8>[cnt] @ [base + @index, base + @index + 1]
}

# nested counted array — an array whose ELEMENT is a struct carrying its OWN counted
# array, so editing an inner array changes THAT element's inner count. The writer must
# descend into element bodies to enforce per-element derived counts, not just the outer.
NestGrp = struct { n: uint8, xs: array<uint8>[n] }
NestArr = struct { m: uint8, gs: array<NestGrp>[m] }

# float/bool compute — non-int computed values: the CEK and the C/C++ readers must agree
# on the promoted result AND its declared kind (int/float promotion across backends).
FComp = struct { x: uint8, half: compute(x / 2.0 : float64), big: compute(x > 100 : bool) }
